---
source: mandible-extract/tests/corpus_snapshot_format.rs
expression: "mandible_core::to_snapshot(&node)"
---
name: git
usage:
  - "usage: git [-v | --version] [-h | --help] [-C <path>] [-c <name>=<value>]"
  - "[--exec-path[=<path>]] [--html-path] [--man-path] [--info-path]"
  - "[-p | --paginate | -P | --no-pager] [--no-replace-objects] [--bare]"
  - "[--git-dir=<path>] [--work-tree=<path>] [--namespace=<name>]"
  - "[--config-env=<name>=<envvar>] <command> [<args>]"
positionals:
  - name: path
    required: true
    provenance:
      sources:
        - help-text
  - name: name>=<value
    required: true
    provenance:
      sources:
        - help-text
  - name: command
    required: true
    provenance:
      sources:
        - help-text
  - name: args
    provenance:
      sources:
        - help-text
provenance:
  sources:
    - help-text
  confidence: 0.5
children_filled: true
subcommands:
  - name: clone
    summary: Clone a repository into a new directory
    group: "start a working area (see also: git help tutorial)"
    provenance:
      sources:
        - help-text
    heading_attested: true
  - name: init
    summary: Create an empty Git repository or reinitialize an existing one
    group: "start a working area (see also: git help tutorial)"
    provenance:
      sources:
        - help-text
    heading_attested: true
  - name: add
    summary: Add file contents to the index
    group: "work on the current change (see also: git help everyday)"
    provenance:
      sources:
        - help-text
    heading_attested: true
  - name: mv
    summary: "Move or rename a file, a directory, or a symlink"
