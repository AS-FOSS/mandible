name: xdg-open
description: |-
  xdg-open - opens a file or URL in the user's preferred application

  Use 'man xdg-open' or 'xdg-open --manual' for additional info.
usage:
- xdg-open { file | URL }
- xdg-open { --help | --manual | --version }
positionals:
- name: file
  provenance:
    sources:
    - help-text
- name: URL
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - --help
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --manual
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --version
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
