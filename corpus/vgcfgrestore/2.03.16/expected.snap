name: vgcfgrestore
usage:
- vgcfgrestore -f|--file String VG
- vgcfgrestore -l|--list VG
flags:
- short: 'f'
  long: file
  value_name: String
  value_kind: Required
  group: Restore VG metadata from specified file.
  provenance:
