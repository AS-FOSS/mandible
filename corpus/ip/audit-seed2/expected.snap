name: ip
usage:
- 'Usage: ip [ OPTIONS ] OBJECT { COMMAND | help }'
- ip [ -force ] -batch filename
positionals:
- name: OBJECT
  required: true
  provenance:
    sources:
    - help-text
- name: COMMAND
  required: true
  provenance:
    sources:
    - help-text
flags:
- short: 'V'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 's'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'd'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'r'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'h'
  group: 'OPTIONS :'
  description: '| -iec | -j[son] | -p[retty] |'
  provenance:
    sources:
    - help-text
- short: 'f'
  group: 'OPTIONS :'
  description: '{ inet | inet6 | mpls | bridge | link } |'
  provenance:
    sources:
    - help-text
- short: '4'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: '6'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'M'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'B'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: '0'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'l'
  group: 'OPTIONS :'
  description: '{ maximum-addr-flush-attempts } | -br[ief] |'
  provenance:
    sources:
    - help-text
- short: 'o'
  group: 'OPTIONS :'
  description: '| -t[imestamp] | -ts[hort] | -b[atch] [filename] |'
  provenance:
    sources:
    - help-text
- short: 'r'
  value_name: c[vbuf]
  value_kind: Required
  group: 'OPTIONS :'
  description: '[size] | -n[etns] name | -N[umeric] | -a[ll] |'
  provenance:
    sources:
    - help-text
- short: 'c'
  group: 'OPTIONS :'
  provenance:
    sources:
    - help-text
- short: 'b'
  value_name: atch
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
