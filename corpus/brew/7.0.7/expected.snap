    description: Search for text in the given database.
    provenance:
      sources:
      - help-text
  - spellings:
    - --archlinux
    description: Search for text in the given database.
    provenance:
      sources:
      - help-text
  - spellings:
    - --debian
    description: Search for text in the given database.
    provenance:
      sources:
      - help-text
  - spellings:
    - --ubuntu
    description: Search for text in the given database.
    provenance:
      sources:
      - help-text
  - spellings:
    - -d
    - --debug
    description: Display any debugging information.
    provenance:
      sources:
      - help-text
  - spellings:
    - -q
    - --quiet
    description: Make some output more quiet.
    provenance:
      sources:
      - help-text
  - spellings:
    - -v
    - --verbose
    description: Make some output more verbose.
