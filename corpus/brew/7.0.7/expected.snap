  - spellings:
    - -n
    - --dry-run
    description: Show what would be upgraded, but do not actually upgrade anything.
    provenance:
      sources:
      - help-text
  - spellings:
    - --minimum-version
    - --min-version
    description: Only upgrade a named formula or cask with an installed version below the given minimum version.
