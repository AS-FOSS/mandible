name: brew
usage:
- '  brew search TEXT|/REGEX/'
- '  brew info [FORMULA|CASK...]'
- '  brew install FORMULA|CASK...'
- '  brew update'
- '  brew upgrade [FORMULA|CASK...]'
- '  brew uninstall FORMULA|CASK...'
- '  brew list [FORMULA|CASK...]'
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
subcommands:
- name: search
  usage:
  - 'Usage: brew search, -S [options] text|/regex/ [...]'
  flags:
  - spellings:
    - --formula
    - --formulae
    description: Search for formulae.
    provenance:
      sources:
      - help-text
  - spellings:
    - --cask
    - --casks
    description: Search for casks.
    provenance:
      sources:
      - help-text
  - spellings:
    - --desc
    description: Search for formulae with a description matching text and casks with a name or description matching text.
    provenance:
      sources:
      - help-text
  - spellings:
    - --pull-request
    description: Search for GitHub pull requests containing text.
    provenance:
      sources:
      - help-text
  - spellings:
    - --open
    description: Search for only open GitHub pull requests.
    provenance:
      sources:
      - help-text
  - spellings:
    - --closed
    description: Search for only closed GitHub pull requests.
    provenance:
      sources:
      - help-text
  - spellings:
    - --alpine
    description: Search for text in the given database.
    provenance:
      sources:
      - help-text
