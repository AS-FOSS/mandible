                                  forward   2 E..V.......
                                  centered  3 E..V.......
    -tune int                 Tune the encoding to a specific scenario (from
                              -1 to INT_MAX) (default -1)
                                values:
                                  psnr  0 E..V.......
                                  ssim  1 E..V.......
    -deadline int             Time to spend encoding, in microseconds. (from
                              INT_MIN to INT_MAX) (default good)
                                values:
                                  best      0 E..V.......
                                  good      1000000 E..V.......
                                  realtime  1 E..V.......
    -error-resilient flags    Error resilience configuration (default 0)
                                values:
                                  default     E..V....... Improve resiliency
                                              against losses of whole frames
                                  partitions  E..V....... The frame
                                              partitions are independently
                                              decodable by the bool decoder,
                                              meaning that partitions can be
                                              decoded even though earlier
                                              partitions have been lost.
                                              Note that intra prediction is
                                              still done over the partition
                                              boundary.
    -max-intra-rate int       Maximum I-frame bitrate (pct) 0=unlimited
                              (from -1 to INT_MAX) (default -1)
    -crf int                  Select the quality for constant quality mode
                              (from -1 to 63) (default -1)
    -static-thresh int        A change threshold on blocks below which they
                              will be skipped by the encoder (from 0 to
                              INT_MAX) (default 0)
    -drop-threshold int       Frame drop threshold (from INT_MIN to INT_MAX)
                              (default 0)
    -noise-sensitivity int    Noise sensitivity (from 0 to 4) (default 0)
    -undershoot-pct int       Datarate undershoot (min) target (%) (from -1
                              to 100) (default -1)
    -overshoot-pct int        Datarate overshoot (max) target (%) (from -1
                              to 1000) (default -1)
    -ts-parameters dictionary Temporal scaling configuration using a
                              :-separated list of key=value parameters
    -auto-alt-ref int         Enable use of alternate reference frames
                              (2-pass only) (from -1 to 6) (default -1)
    -cpu-used int             Quality/Speed ratio modifier (from -8 to 8)
                              (default 1)
    -lossless int             Lossless mode (from -1 to 1) (default -1)
    -tile-columns int         Number of tile columns to use, log2 (from -1
                              to 6) (default -1)
    -tile-rows int            Number of tile rows to use, log2 (from -1 to
                              2) (default -1)
    -frame-parallel boolean   Enable frame parallel decodability features
                              (default auto)
    -aq-mode int              adaptive quantization mode (from -1 to 4)
                              (default -1)
                                values:
                                  none        0 E..V....... Aq not used
                                  variance    1 E..V....... Variance based
                                              Aq
                                  complexity  2 E..V....... Complexity based
                                              Aq
                                  cyclic      3 E..V....... Cyclic Refresh
                                              Aq
                                  equator360  4 E..V....... 360 video Aq
    -level float              Specify level (from -1 to 6.2) (default -1)
    -row-mt boolean           Row based multi-threading (default auto)
    -tune-content int         Tune content type (from -1 to 2) (default -1)
                                values:
                                  default  0 E..V....... Regular video
                                           content
                                  screen   1 E..V....... Screen capture
                                           content
                                  film     2 E..V....... Film content;
                                           improves grain retention
    -corpus-complexity int    corpus vbr complexity midpoint (from -1 to
                              10000) (default -1)
    -enable-tpl boolean       Enable temporal dependency model (default
                              auto)
    -min-gf-interval int      Minimum golden/alternate reference frame
                              interval (from -1 to INT_MAX) (default -1)
    -speed int                (from -16 to 16) (default 1)
    -quality int              (from INT_MIN to INT_MAX) (default good)
                                values:
                                  best      0 E..V.......
                                  good      1000000 E..V.......
                                  realtime  1 E..V.......
    -vp8flags flags           (default 0)
                                values:
                                  error_resilient  E..V....... enable error
                                                   resilience
                                  altref           E..V....... enable use of
                                                   alternate reference
                                                   frames (VP8/2-pass only)
    -arnr_max_frames int      altref noise reduction max frame count (from 0
                              to 15) (default 0)
    -arnr_strength int        altref noise reduction filter strength (from 0
                              to 6) (default 3)
    -arnr_type int            altref noise reduction filter type (from 1 to
                              3) (default 3)
    -rc_lookahead int         Number of frames to look ahead for alternate
                              reference frame selection (from 0 to 25)
                              (default 25)
    -sharpness int            Increase sharpness at the expense of lower
                              PSNR (from -1 to 7) (default -1)

Libwebp encoder AVOptions ──────────────────────────────────────────────────
    -lossless int             Use lossless mode (from 0 to 1) (default 0)
    -preset int               Configuration preset (from -1 to 5) (default
                              none)
                                values:
                                  none     -1 E..V....... do not use a
                                           preset
                                  default  0 E..V....... default preset
                                  picture  1 E..V....... digital picture,
                                           like portrait, inner shot
                                  photo    2 E..V....... outdoor photograph,
                                           with natural lighting
                                  drawing  3 E..V....... hand or line
                                           drawing, with high-contrast
                                           details
                                  icon     4 E..V....... small-sized
                                           colorful images
                                  text     5 E..V....... text-like
    -cr_threshold int         Conditional replenishment threshold (from 0 to
                              INT_MAX) (default 0)
    -cr_size int              Conditional replenishment block size (from 0
                              to 256) (default 16)
    -quality float            Quality (from 0 to 100) (default 75)

Libx264 AVOptions ──────────────────────────────────────────────────────────
    -preset string            Set the encoding preset (cf. x264 --fullhelp)
                              (default "medium")
    -tune string              Tune the encoding params (cf. x264 --fullhelp)
    -profile string           Set profile restrictions (cf. x264 --fullhelp)
    -fastfirstpass boolean    Use fast settings when encoding first pass
                              (default true)
    -level string             Specify level (as defined by Annex A)
    -passlogfile string       Filename for 2 pass stats
    -wpredp string            Weighted prediction for P-frames
    -a53cc boolean            Use A53 Closed Captions (if available)
                              (default true)
    -x264opts string          x264 options
    -crf float                Select the quality for constant quality mode
                              (from -1 to FLT_MAX) (default -1)
    -crf_max float            In CRF mode, prevents VBV from lowering
                              quality beyond this point. (from -1 to
                              FLT_MAX) (default -1)
    -qp int                   Constant quantization parameter rate control
                              method (from -1 to INT_MAX) (default -1)
    -aq-mode int              AQ method (from -1 to INT_MAX) (default -1)
                              autovariance-biased 3 E..V.......
                              Auto-variance AQ with bias to dark scenes
                                values:
                                  none          0 E..V.......
                                  variance      1 E..V....... Variance AQ
                                                (complexity mask)
                                  autovariance  2 E..V....... Auto-variance
                                                AQ
    -aq-strength float        AQ strength. Reduces blocking and blurring in
                              flat and textured areas. (from -1 to FLT_MAX)
                              (default -1)
    -psy boolean              Use psychovisual optimizations. (default auto)
    -psy-rd string            Strength of psychovisual optimization, in
                              <psy-rd>:<psy-trellis> format.
    -rc-lookahead int         Number of frames to look ahead for frametype
                              and ratecontrol (from -1 to INT_MAX) (default
                              -1)
    -weightb boolean          Weighted prediction for B-frames. (default
                              auto)
    -weightp int              Weighted prediction analysis method. (from -1
                              to INT_MAX) (default -1)
                                values:
                                  none    0 E..V.......
                                  simple  1 E..V.......
                                  smart   2 E..V.......
    -ssim boolean             Calculate and print SSIM stats. (default auto)
    -intra-refresh boolean    Use Periodic Intra Refresh instead of IDR
                              frames. (default auto)
    -bluray-compat boolean    Bluray compatibility workarounds. (default
                              auto)
-b int                        Influences how often B-frames are used (from
                              INT_MIN to INT_MAX) (default INT_MIN)
-b int                        Keep some B-frames as references. (from -1 to
                              INT_MAX) (default -1)
                                values:
                                  none    0 E..V.......
                                  strict  1 E..V....... Strictly
                                          hierarchical pyramid
                                  normal  2 E..V....... Non-strict (not
                                          Blu-ray compatible)
    -mixed-refs boolean       One reference per partition, as opposed to one
                              reference per macroblock (default auto)
    -8x8dct boolean           High profile 8x8 transform. (default auto)
    -fast-pskip boolean       (default auto)
    -aud boolean              Use access unit delimiters. (default auto)
    -mbtree boolean           Use macroblock tree ratecontrol. (default
                              auto)
    -deblock string           Loop filter parameters, in <alpha:beta> form.
    -cplxblur float           Reduce fluctuations in QP (before curve
                              compression) (from -1 to FLT_MAX) (default -1)
    -partitions string        A comma-separated list of partitions to
                              consider.
                                values: p8x8, p4x4, b8x8, i8x8, i4x4, none,
                                all
    -direct-pred int          Direct MV prediction mode (from -1 to INT_MAX)
                              (default -1)
                                values:
                                  none      0 E..V.......
                                  spatial   1 E..V.......
                                  temporal  2 E..V.......
                                  auto      3 E..V.......
    -slice-max-size int       Limit the size of each slice in bytes (from -1
                              to INT_MAX) (default -1)
    -stats string             Filename for 2 pass stats
    -nal-hrd int              Signal HRD information (requires vbv-bufsize;
                              cbr not allowed in .mp4) (from -1 to INT_MAX)
                              (default -1)
                                values:
                                  none  0 E..V.......
                                  vbr   1 E..V.......
                                  cbr   2 E..V.......
    -avcintra-class int       AVC-Intra class 50/100/200/300/480 (from -1 to
                              480) (default -1)
    -me_method int            Set motion estimation method (from -1 to 4)
                              (default -1)
                                values:
                                  dia   0 E..V.......
                                  hex   1 E..V.......
                                  umh   2 E..V.......
                                  esa   3 E..V.......
                                  tesa  4 E..V.......
    -motion-est int           Set motion estimation method (from -1 to 4)
                              (default -1)
                                values:
                                  dia   0 E..V.......
                                  hex   1 E..V.......
                                  umh   2 E..V.......
                                  esa   3 E..V.......
                                  tesa  4 E..V.......
    -forced-idr boolean       If forcing keyframes, force them as IDR
                              frames. (default false)
    -coder int                Coder type (from -1 to 1) (default default)
                                values:
                                  default  -1 E..V.......
                                  cavlc    0 E..V.......
                                  cabac    1 E..V.......
                                  vlc      0 E..V.......
                                  ac       1 E..V.......
    -b_strategy int           Strategy to choose between I/P/B-frames (from
                              -1 to 2) (default -1)
    -chromaoffset int         QP difference between chroma and luma (from
                              INT_MIN to INT_MAX) (default 0)
    -sc_threshold int         Scene change threshold (from INT_MIN to
                              INT_MAX) (default -1)
    -noise_reduction int      Noise reduction (from INT_MIN to INT_MAX)
                              (default -1)
    -udu_sei boolean          Use user data unregistered SEI if available
                              (default false)
    -x264-params dictionary   Override the x264 configuration using a
                              :-separated list of key=value parameters
    -mb_info boolean          Set mb_info data through AVSideData, only
                              useful when used from the API (default false)

