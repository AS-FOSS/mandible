Libaom-av1 encoder AVOptions ───────────────────────────────────────────────
    -cpu-used int             Quality/Speed ratio modifier (from 0 to 8)
                              (default 1)
    -auto-alt-ref int         Enable use of alternate reference frames
                              (2-pass only) (from -1 to 2) (default -1)
    -lag-in-frames int        Number of frames to look ahead at for
                              alternate reference frame selection (from -1
                              to INT_MAX) (default -1)
    -arnr-max-frames int      altref noise reduction max frame count (from
                              -1 to INT_MAX) (default -1)
    -arnr-strength int        altref noise reduction filter strength (from
                              -1 to 6) (default -1)
    -aq-mode int              adaptive quantization mode (from -1 to 4)
                              (default -1)
                                values:
                                  none        0 E..V....... Aq not used
                                  variance    1 E..V....... Variance based
                                              Aq
                                  complexity  2 E..V....... Complexity based
                                              Aq
                                  cyclic      3 E..V....... Cyclic Refresh
                                              Aq
    -error-resilience flags   Error resilience configuration (default 0)
                                values:
                                  default  E..V....... Improve resiliency
                                           against losses of whole frames
    -crf int                  Select the quality for constant quality mode
                              (from -1 to 63) (default -1)
    -static-thresh int        A change threshold on blocks below which they
                              will be skipped by the encoder (from 0 to
                              INT_MAX) (default 0)
    -drop-threshold int       Frame drop threshold (from INT_MIN to INT_MAX)
                              (default 0)
    -denoise-noise-level int  Amount of noise to be removed (from -1 to
                              INT_MAX) (default -1)
    -denoise-block-size int   Denoise block size (from -1 to INT_MAX)
                              (default -1)
    -undershoot-pct int       Datarate undershoot (min) target (%) (from -1
                              to 100) (default -1)
    -overshoot-pct int        Datarate overshoot (max) target (%) (from -1
                              to 1000) (default -1)
    -minsection-pct int       GOP min bitrate (% of target) (from -1 to 100)
                              (default -1)
    -maxsection-pct int       GOP max bitrate (% of target) (from -1 to
                              5000) (default -1)
    -frame-parallel boolean   Enable frame parallel decodability features
                              (default auto)
    -tiles image_size         Tile columns x rows
    -tile-columns int         Log2 of number of tile columns to use (from -1
                              to 6) (default -1)
    -tile-rows int            Log2 of number of tile rows to use (from -1 to
                              6) (default -1)
    -row-mt boolean           Enable row based multi-threading (default
                              auto)
    -enable-cdef boolean      Enable CDEF filtering (default auto)
    -enable-global-motion boolean Enable global motion (default auto)
    -enable-intrabc boolean   Enable intra block copy prediction mode
                              (default auto)
    -enable-restoration boolean Enable Loop Restoration filtering (default
                              auto)
    -usage int                Quality and compression efficiency vs speed
                              trade-off (from 0 to INT_MAX) (default good)
                                values:
                                  good      0 E..V....... Good quality
                                  realtime  1 E..V....... Realtime encoding
                                  allintra  2 E..V....... All Intra encoding
    -tune int                 The metric that the encoder tunes for.
                              Automatically chosen by the encoder by default
                              (from -1 to 1) (default -1)
                                values:
                                  psnr  0 E..V.......
                                  ssim  1 E..V.......
    -still-picture boolean    Encode in single frame mode (typically used
                              for still AVIF images). (default false)
    -enable-rect-partitions boolean Enable rectangular partitions (default
                              auto)
    -enable-1to4-partitions boolean Enable 1:4/4:1 partitions (default auto)
    -enable-ab-partitions boolean Enable ab shape partitions (default auto)
    -enable-angle-delta boolean Enable angle delta intra prediction (default
                              auto)
    -enable-cfl-intra boolean Enable chroma predicted from luma intra
                              prediction (default auto)
    -enable-filter-intra boolean Enable filter intra predictor (default
                              auto)
    -enable-intra-edge-filter boolean Enable intra edge filter (default
                              auto)
    -enable-smooth-intra boolean Enable smooth intra prediction mode
                              (default auto)
    -enable-paeth-intra boolean Enable paeth predictor in intra prediction
                              (default auto)
    -enable-palette boolean   Enable palette prediction mode (default auto)
    -enable-flip-idtx boolean Enable extended transform type (default auto)
    -enable-tx64 boolean      Enable 64-pt transform (default auto)
    -reduced-tx-type-set boolean Use reduced set of transform types (default
                              auto)
    -use-intra-dct-only boolean Use DCT only for INTRA modes (default auto)
    -use-inter-dct-only boolean Use DCT only for INTER modes (default auto)
    -use-intra-default-tx-only boolean Use default-transform only for INTRA
                              modes (default auto)
    -enable-ref-frame-mvs boolean Enable temporal mv prediction (default
                              auto)
    -enable-reduced-reference-set boolean Use reduced set of single and
                              compound references (default auto)
    -enable-obmc boolean      Enable obmc (default auto)
    -enable-dual-filter boolean Enable dual filter (default auto)
    -enable-diff-wtd-comp boolean Enable difference-weighted compound
                              (default auto)
    -enable-dist-wtd-comp boolean Enable distance-weighted compound (default
                              auto)
    -enable-onesided-comp boolean Enable one sided compound (default auto)
    -enable-interinter-wedge boolean Enable interinter wedge compound
                              (default auto)
    -enable-interintra-wedge boolean Enable interintra wedge compound
                              (default auto)
    -enable-masked-comp boolean Enable masked compound (default auto)
    -enable-interintra-comp boolean Enable interintra compound (default
                              auto)
    -enable-smooth-interintra boolean Enable smooth interintra mode (default
                              auto)
    -aom-params dictionary    Set libaom options using a :-separated list of
                              key=value pairs

