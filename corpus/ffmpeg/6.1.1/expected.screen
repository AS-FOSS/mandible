                                                Headphone Encoded
                                  off           1 E...A...... Not Dolby
                                                Headphone Encoded
    -ad_conv_type int         A/D Converter Type (from -1 to 1) (default -1)
                                values:
                                  standard  0 E...A...... Standard (default)
                                  hdcd      1 E...A...... HDCD
    -stereo_rematrixing boolean Stereo Rematrixing (default true)
    -channel_coupling int     Channel Coupling (from -1 to 1) (default auto)
                                values:
