                              slice+frame)
                                values:
                                  slice  ED.V.......
                                  frame  ED.V.......
    -audio_service_type int   audio service type (from 0 to 8) (default ma)
                                values:
                                  ma  0 E...A...... Main Audio Service
                                  ef  1 E...A...... Effects
