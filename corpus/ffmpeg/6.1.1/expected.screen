SMPTE VC-2 encoder AVOptions ───────────────────────────────────────────────
    -tolerance double         Max undershoot in percent (from 0 to 45)
                              (default 5)
    -slice_width int          Slice width (from 32 to 1024) (default 32)
    -slice_height int         Slice height (from 8 to 1024) (default 16)
    -wavelet_depth int        Transform depth (from 1 to 5) (default 4)
    -wavelet_type int         Transform type (from 0 to 7) (default 9_7) 9_7
                              0 E..V....... Deslauriers-Dubuc (9,7) 5_3 1
                              E..V....... LeGall (5,3)
                                values:
                                  haar          4 E..V....... Haar (with
                                                shift)
                                  haar_noshift  3 E..V....... Haar (without
                                                shift)
    -qm int                   Custom quantization matrix (from 0 to 3)
                              (default default)
                                values:
                                  default  0 E..V....... Default from the
                                           specifications
                                  color    1 E..V....... Prevents low
                                           bitrate discoloration
                                  flat     2 E..V....... Optimize for PSNR

AAC encoder AVOptions ──────────────────────────────────────────────────────
    -aac_coder int            Coding algorithm (from 0 to 2) (default
                              twoloop)
                                values:
                                  anmr     0 E...A...... ANMR method
                                  twoloop  1 E...A...... Two loop searching
                                           method
                                  fast     2 E...A...... Default fast search
    -aac_ms boolean           Force M/S stereo coding (default auto)
    -aac_is boolean           Intensity stereo coding (default true)
    -aac_pns boolean          Perceptual noise substitution (default true)
    -aac_tns boolean          Temporal noise shaping (default true)
    -aac_ltp boolean          Long term prediction (default false)
    -aac_pred boolean         AAC-Main prediction (default false)
    -aac_pce boolean          Forces the use of PCEs (default false)

AC-3 Encoder AVOptions ─────────────────────────────────────────────────────
    -center_mixlev float      Center Mix Level (from 0 to 1) (default
                              0.594604)
    -surround_mixlev float    Surround Mix Level (from 0 to 1) (default 0.5)
    -mixing_level int         Mixing Level (from -1 to 111) (default -1)
    -room_type int            Room Type (from -1 to 2) (default -1)
                                values:
                                  notindicated  0 E...A...... Not Indicated
                                                (default)
                                  large         1 E...A...... Large Room
                                  small         2 E...A...... Small Room
    -per_frame_metadata boolean Allow Changing Metadata Per-Frame (default
                              false)
    -copyright int            Copyright Bit (from -1 to 1) (default -1)
    -dialnorm int             Dialogue Level (dB) (from -31 to -1) (default
                              -31)
    -dsur_mode int            Dolby Surround Mode (from -1 to 2) (default
                              -1)
                                values:
                                  notindicated  0 E...A...... Not Indicated
                                                (default)
                                  on            2 E...A...... Dolby Surround
                                                Encoded
                                  off           1 E...A...... Not Dolby
                                                Surround Encoded
    -original int             Original Bit Stream (from -1 to 1) (default
                              -1)
    -dmix_mode int            Preferred Stereo Downmix Mode (from -1 to 3)
                              (default -1)
                                values:
                                  notindicated  0 E...A...... Not Indicated
                                                (default)
                                  ltrt          1 E...A...... Lt/Rt Downmix
                                                Preferred
                                  loro          2 E...A...... Lo/Ro Downmix
                                                Preferred
                                  dplii         3 E...A...... Dolby Pro
                                                Logic II Downmix Preferred
    -ltrt_cmixlev float       Lt/Rt Center Mix Level (from -1 to 2) (default
                              -1)
    -ltrt_surmixlev float     Lt/Rt Surround Mix Level (from -1 to 2)
                              (default -1)
    -loro_cmixlev float       Lo/Ro Center Mix Level (from -1 to 2) (default
                              -1)
    -loro_surmixlev float     Lo/Ro Surround Mix Level (from -1 to 2)
