    -ssim int                 Show SSIM information to stdout (from 0 to 2)
                              (default off)
                                values:
                                  off    0 E..V.......
                                  avg    1 E..V.......
                                  frame  2 E..V.......
    -ssim_acc int             SSIM accuracy (from 0 to 4) (default 2)
    -gmc int                  use GMC (from 0 to 1) (default 0)
    -me_quality int           Motion estimation quality (from 0 to 6)
                              (default 4)
    -mpeg_quant int           Use MPEG quantizers instead of H.263 (from 0
                              to 1) (default 0)

H263_v4l2m2m_encoder AVOptions ─────────────────────────────────────────────
    -num_output_buffers int   Number of buffers in the output context (from
                              2 to INT_MAX) (default 16)
    -num_capture_buffers int  Number of buffers in the capture context (from
                              4 to INT_MAX) (default 4)

Av1_nvenc AVOptions ────────────────────────────────────────────────────────
    -preset int               Set the encoding preset (from 0 to 18)
                              (default p4)
                                values:
                                  default  0 E..V.......
                                  slow     1 E..V....... hq 2 passes
                                  medium   2 E..V....... hq 1 pass
                                  fast     3 E..V....... hp 1 pass
                                  p1       12 E..V....... fastest (lowest
                                           quality)
                                  p2       13 E..V....... faster (lower
                                           quality)
                                  p3       14 E..V....... fast (low quality)
                                  p4       15 E..V....... medium (default)
                                  p5       16 E..V....... slow (good
                                           quality)
                                  p6       17 E..V....... slower (better
                                           quality)
                                  p7       18 E..V....... slowest (best
                                           quality)
    -tune int                 Set the encoding tuning info (from 1 to 4)
                              (default hq)
                                values:
                                  hq        1 E..V....... High quality
                                  ll        2 E..V....... Low latency
                                  ull       3 E..V....... Ultra low latency
                                  lossless  4 E..V....... Lossless
    -level int                Set the encoding level restriction (from 0 to
                              24) (default auto) 2 0 E..V....... 2.0 0
                              E..V....... 2.1 1 E..V....... 2.2 2
                              E..V....... 2.3 3 E..V....... 3 4 E..V.......
                              3.0 4 E..V....... 3.1 5 E..V....... 3.2 6
                              E..V....... 3.3 7 E..V....... 4 8 E..V.......
                              4.0 8 E..V....... 4.1 9 E..V....... 4.2 10
                              E..V....... 4.3 11 E..V....... 5 12
                              E..V....... 5.0 12 E..V....... 5.1 13
                              E..V....... 5.2 14 E..V....... 5.3 15
                              E..V....... 6 16 E..V....... 6.0 16
                              E..V....... 6.1 17 E..V....... 6.2 18
                              E..V....... 6.3 19 E..V....... 7 20
                              E..V....... 7.0 20 E..V....... 7.1 21
                              E..V....... 7.2 22 E..V....... 7.3 23
                              E..V.......
                                values:
                                  auto  24 E..V.......
    -tier int                 Set the encoding tier (from 0 to 1) (default
                              0) 0 0 E..V....... 1 1 E..V.......
    -rc int                   Override the preset rate-control (from -1 to
                              INT_MAX) (default -1)
                                values:
                                  constqp  0 E..V....... Constant QP mode
                                  vbr      1 E..V....... Variable bitrate
                                           mode
                                  cbr      2 E..V....... Constant bitrate
                                           mode
    -multipass int            Set the multipass encoding (from 0 to 2)
                              (default disabled)
                                values:
                                  disabled  0 E..V....... Single Pass
                                  qres      1 E..V....... Two Pass encoding
                                            is enabled where first Pass is
                                            quarter resolution
                                  fullres   2 E..V....... Two Pass encoding
                                            is enabled where first Pass is
                                            full resolution
    -highbitdepth boolean     Enable 10 bit encode for 8 bit input (default
                              false)
    -tile-rows int            Number of tile rows to encode with (from -1 to
                              64) (default -1)
    -tile-columns int         Number of tile columns to encode with (from -1
                              to 64) (default -1)
    -surfaces int             Number of concurrent surfaces (from 0 to 64)
                              (default 0)
    -gpu int                  Selects which NVENC capable GPU to use. First
                              GPU is 0, second is 1, and so on. (from -2 to
                              INT_MAX) (default any)
                                values:
                                  any   -1 E..V....... Pick the first device
                                        available
                                  list  -2 E..V....... List the available
                                        devices
    -rgb_mode int             Configure how nvenc handles packed RGB input.
                              (from 0 to INT_MAX) (default yuv420)
                                values:
                                  yuv420    1 E..V....... Convert to yuv420
                                  yuv444    2 E..V....... Convert to yuv444
                                  disabled  0 E..V....... Disables support,
                                            throws an error.
    -delay int                Delay frame output by the given amount of
                              frames (from 0 to INT_MAX) (default INT_MAX)
    -rc-lookahead int         Number of frames to look ahead for
                              rate-control (from 0 to INT_MAX) (default 0)
    -cq float                 Set target quality level (0 to 51, 0 means
                              automatic) for constant quality mode in VBR
                              rate control (from 0 to 51) (default 0)
    -init_qpP int             Initial QP value for P frame (from -1 to 255)
                              (default -1)
    -init_qpB int             Initial QP value for B frame (from -1 to 255)
                              (default -1)
    -init_qpI int             Initial QP value for I frame (from -1 to 255)
                              (default -1)
    -qp int                   Constant quantization parameter rate control
                              method (from -1 to 255) (default -1)
    -qp_cb_offset int         Quantization parameter offset for cb channel
                              (from -12 to 12) (default 0)
    -qp_cr_offset int         Quantization parameter offset for cr channel
                              (from -12 to 12) (default 0)
    -no-scenecut boolean      When lookahead is enabled, set this to 1 to
                              disable adaptive I-frame insertion at scene
                              cuts (default false)
    -forced-idr boolean       If forcing keyframes, force them as IDR
                              frames. (default false)
    -b_adapt boolean          When lookahead is enabled, set this to 0 to
                              disable adaptive B-frame decision (default
                              true)
    -spatial-aq boolean       set to 1 to enable Spatial AQ (default false)
    -temporal-aq boolean      set to 1 to enable Temporal AQ (default false)
    -zerolatency boolean      Set 1 to indicate zero latency operation (no
                              reordering delay) (default false)
    -nonref_p boolean         Set this to 1 to enable automatic insertion of
                              non-reference P-frames (default false)
    -strict_gop boolean       Set 1 to minimize GOP-to-GOP rate fluctuations
                              (default false)
    -aq-strength int          When Spatial AQ is enabled, this field is used
                              to specify AQ strength. AQ strength scale is
                              from 1 (low) - 15 (aggressive) (from 1 to 15)
                              (default 8)
    -weighted_pred boolean    Enable weighted prediction (default false)
    -b_ref_mode int           Use B frames as references (from -1 to 2)
                              (default -1)
                                values:
                                  disabled  0 E..V....... B frames will not
                                            be used for reference
                                  each      1 E..V....... Each B frame will
                                            be used for reference
                                  middle    2 E..V....... Only (number of B
                                            frames)/2 will be used for
                                            reference
    -dpb_size int             Specifies the DPB size used for encoding (0
                              means automatic) (from 0 to INT_MAX) (default
                              0)
    -ldkfs int                Low delay key frame scale; Specifies the Scene
                              Change frame size increase allowed in case of
                              single frame VBV and CBR (from 0 to 255)
                              (default 0)
    -intra-refresh boolean    Use Periodic Intra Refresh instead of IDR
                              frames (default false)
    -timing-info boolean      Include timing info in sequence/frame headers
                              (default false)
    -extra_sei boolean        Pass on extra SEI data (e.g. a53 cc) to be
                              included in the bitstream (default true)
    -a53cc boolean            Use A53 Closed Captions (if available)
                              (default true)
    -s12m_tc boolean          Use timecode (if available) (default true)

Av1_vaapi AVOptions ────────────────────────────────────────────────────────
    -low_power boolean        Use low-power encoding mode (only available on
                              some platforms; may not support all encoding
                              features) (default false)
    -idr_interval int         Distance (in I-frames) between IDR frames
                              (from 0 to INT_MAX) (default 0)
    -b_depth int              Maximum B-frame reference depth (from 1 to
                              INT_MAX) (default 1)
