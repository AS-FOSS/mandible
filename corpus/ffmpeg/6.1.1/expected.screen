Libsrt AVOptions ───────────────────────────────────────────────────────────
    -timeout int64            Timeout of socket I/O operations (in
                              microseconds) (from -1 to I64_MAX) (default
                              -1)
    -listen_timeout int64     Connection awaiting timeout (in microseconds)
                              (from -1 to I64_MAX) (default -1)
    -send_buffer_size int     Socket send buffer size (in bytes) (from -1 to
                              INT_MAX) (default -1)
    -recv_buffer_size int     Socket receive buffer size (in bytes) (from -1
                              to INT_MAX) (default -1)
    -pkt_size int             Maximum SRT packet size (from -1 to 1456)
                              (default -1)
                                values:
                                  ts_size   1316 ED.........
                                  max_size  1456 ED.........
    -payload_size int         Maximum SRT packet size (from -1 to 1456)
                              (default -1)
                                values:
                                  ts_size   1316 ED.........
                                  max_size  1456 ED.........
    -maxbw int64              Maximum bandwidth (bytes per second) that the
                              connection can use (from -1 to I64_MAX)
                              (default -1)
    -pbkeylen int             Crypto key len in bytes {16,24,32} Default: 16
                              (128-bit) (from -1 to 32) (default -1)
    -passphrase string        Crypto PBKDF2 Passphrase size[0,10..64]
                              0:disable crypto
    -enforced_encryption boolean Enforces that both connection parties have
                              the same passphrase set (default auto)
    -kmrefreshrate int        The number of packets to be transmitted after
                              which the encryption key is switched to a new
                              key (from -1 to INT_MAX) (default -1)
    -kmpreannounce int        The interval between when a new encryption key
                              is sent and when switchover occurs (from -1 to
                              INT_MAX) (default -1)
    -snddropdelay int64       The sender's extra delay(in microseconds)
                              before dropping packets (from -2 to I64_MAX)
                              (default -2)
    -mss int                  The Maximum Segment Size (from -1 to 1500)
                              (default -1)
    -ffs int                  Flight flag size (window size) (in bytes)
                              (from -1 to INT_MAX) (default -1)
    -ipttl int                IP Time To Live (from -1 to 255) (default -1)
    -iptos int                IP Type of Service (from -1 to 255) (default
                              -1)
    -inputbw int64            Estimated input stream rate (from -1 to
                              I64_MAX) (default -1)
    -oheadbw int              MaxBW ceiling based on % over input stream
                              rate (from -1 to 100) (default -1)
    -latency int64            receiver delay (in microseconds) to absorb
                              bursts of missed packet retransmissions (from
                              -1 to I64_MAX) (default -1)
    -tsbpddelay int64         deprecated, same effect as latency option
                              (from -1 to I64_MAX) (default -1)
    -rcvlatency int64         receive latency (in microseconds) (from -1 to
                              I64_MAX) (default -1)
    -peerlatency int64        peer latency (in microseconds) (from -1 to
                              I64_MAX) (default -1)
    -tlpktdrop boolean        Enable too-late pkt drop (default auto)
    -nakreport boolean        Enable receiver to send periodic NAK reports
                              (default auto)
    -connect_timeout int64    Connect timeout(in milliseconds). Caller
                              default: 3000, rendezvous (x 10) (from -1 to
                              I64_MAX) (default -1)
    -mode int                 Connection mode (caller, listener, rendezvous)
                              (from 0 to 2) (default caller)
                                values:
                                  caller      0 ED.........
                                  listener    1 ED.........
                                  rendezvous  2 ED.........
    -sndbuf int               Send buffer size (in bytes) (from -1 to
                              INT_MAX) (default -1)
    -rcvbuf int               Receive buffer size (in bytes) (from -1 to
                              INT_MAX) (default -1)
    -lossmaxttl int           Maximum possible packet reorder tolerance
                              (from -1 to INT_MAX) (default -1)
    -minversion int           The minimum SRT version that is required from
                              the peer (from -1 to INT_MAX) (default -1)
    -streamid string          A string of up to 512 characters that an
                              Initiator can pass to a Responder
    -srt_streamid string      A string of up to 512 characters that an
                              Initiator can pass to a Responder
    -smoother string          The type of Smoother used for the transmission
                              for that socket
    -messageapi boolean       Enable message API (default auto)
    -transtype int            The transmission type for the socket (from 0
                              to 2) (default 2)
                                values:
                                  live  0 ED.........
                                  file  1 ED.........
    -linger int               Number of seconds that the socket waits for
                              unsent data when closing (from -1 to INT_MAX)
                              (default -1)
    -tsbpd boolean            Timestamp-based packet delivery (default auto)

