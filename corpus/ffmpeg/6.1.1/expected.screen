    -decryption_key binary    AES decryption key
    -decryption_iv binary     AES decryption initialization vector
    -encryption_key binary    AES encryption key
    -encryption_iv binary     AES encryption initialization vector

Fd AVOptions ───────────────────────────────────────────────────────────────
    -blocksize int            set I/O operation maximum block size (from 1
                              to INT_MAX) (default INT_MAX)
    -fd int                   set file descriptor (from -1 to INT_MAX)
                              (default -1)

Ffrtmphttp AVOptions ───────────────────────────────────────────────────────
    -ffrtmphttp_tls boolean   Use a HTTPS tunneling connection (RTMPTS).
                              (default false)

File AVOptions ─────────────────────────────────────────────────────────────
    -truncate boolean         truncate existing files on write (default
                              true)
    -blocksize int            set I/O operation maximum block size (from 1
                              to INT_MAX) (default INT_MAX)
    -follow int               Follow a file as it is being written (from 0
                              to 1) (default 0)
    -seekable int             Sets if the file is seekable (from -1 to 0)
                              (default -1)

Ftp AVOptions ──────────────────────────────────────────────────────────────
    -timeout int              set timeout of socket I/O operations (from -1
                              to INT_MAX) (default -1)
    -ftp-write-seekable boolean control seekability of connection during
                              encoding (default false)
    -ftp-anonymous-password string password for anonymous login. E-mail
                              address should be used.
    -ftp-user string          user for FTP login. Overridden by whatever is
                              in the URL.
    -ftp-password string      password for FTP login. Overridden by whatever
                              is in the URL.

Http AVOptions ─────────────────────────────────────────────────────────────
    -seekable boolean         control seekability of connection (default
                              auto)
    -chunked_post boolean     use chunked transfer-encoding for posts
                              (default true)
    -http_proxy string        set HTTP proxy to tunnel through
    -headers string           set custom HTTP headers, can override built in
                              default headers
    -content_type string      set a specific content type for the POST
                              messages
    -user_agent string        override User-Agent header (default
                              "Lavf/60.16.100")
    -referer string           override referer header
    -multiple_requests boolean use persistent connections (default false)
    -post_data binary         set custom HTTP post data
    -cookies string           set cookies to be sent in applicable future
                              requests, use newline delimited Set-Cookie
                              HTTP field value syntax
    -icy boolean              request ICY metadata (default true)
    -auth_type int            HTTP authentication type (from 0 to 1)
                              (default none)
                                values:
                                  none   0 ED......... No auth method set,
                                         autodetect
                                  basic  1 ED......... HTTP basic
                                         authentication
    -send_expect_100 boolean  Force sending an Expect: 100-continue header
                              for POST (default auto)
    -location string          The actual location of the data received
    -offset int64             initial byte offset (from 0 to I64_MAX)
                              (default 0)
    -end_offset int64         try to limit the request to bytes preceding
                              this offset (from 0 to I64_MAX) (default 0)
    -method string            Override the HTTP method or set the expected
                              HTTP method from a client
    -reconnect boolean        auto reconnect after disconnect before EOF
                              (default false)
    -reconnect_at_eof boolean auto reconnect at EOF (default false)
    -reconnect_on_network_error boolean auto reconnect in case of tcp/tls
                              error during connect (default false)
    -reconnect_on_http_error string list of http status codes to reconnect
                              on
    -reconnect_streamed boolean auto reconnect streamed / non seekable
                              streams (default false)
    -reconnect_delay_max int  max reconnect delay in seconds after which to
                              give up (from 0 to 4294) (default 120)
    -listen int               listen on HTTP (from 0 to 2) (default 0)
    -resource string          The resource requested by a client
    -reply_code int           The http status code to return to a client
                              (from INT_MIN to 599) (default 200)
    -short_seek_size int      Threshold to favor readahead over seek. (from
                              0 to INT_MAX) (default 0)

