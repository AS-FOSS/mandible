  choices:
  - name: none
    description: 0 E.......... one fragment per segment
  - name: every_frame
    description: 1 E.......... fragment at every frame
  - name: duration
    description: 2 E.......... fragment at specific time intervals
  - name: pframes
    description: 3 E.......... fragment at keyframes and following P-Frame reordering (Video only, experimental)
  group: 'dash muxer AVOptions:'
  description: set type of interval for fragments (from 0 to 3) (default none)
  provenance:
    sources:
    - help-text
