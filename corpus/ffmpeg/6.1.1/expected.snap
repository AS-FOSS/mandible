    sources:
    - help-text
- long: timestamp
  single_dash: true
  description: set the recording timestamp ('now' to set the current time)
  provenance:
    sources:
    - help-text
- long: metadata
  single_dash: true
  description: add metadata
  provenance:
    sources:
    - help-text
- long: program
  single_dash: true
  description: add program with specified streams
  provenance:
    sources:
    - help-text
- long: target
  single_dash: true
  description: specify target file type ("vcd", "svcd", "dvd", "dv" or "dv50" with optional prefixes "pal-", "ntsc-" or "film-")
  provenance:
    sources:
    - help-text
