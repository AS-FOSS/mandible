  provenance:
    sources:
    - help-text
- spellings:
  - -auto_conversion_filters
  group: 'Advanced global options:'
  description: enable automatic conversion filters globally
  provenance:
    sources:
    - help-text
- spellings:
  - -stats_period
  value_name: time
  value_kind: Required
  group: 'Advanced global options:'
  description: set the period at which ffmpeg updates stats and -progress output
  provenance:
    sources:
    - help-text
- spellings:
  - -debug_ts
  group: 'Advanced global options:'
  description: print timestamp debugging info
  provenance:
    sources:
    - help-text
- spellings:
  - -psnr
  group: 'Advanced global options:'
  description: calculate PSNR of compressed frames (deprecated, use -flags +psnr)
  provenance:
    sources:
    - help-text
- spellings:
  - -vstats
  group: 'Advanced global options:'
  description: dump video coding statistics to file
  provenance:
    sources:
    - help-text
- spellings:
  - -vstats_file
  value_name: file
  value_kind: Required
  group: 'Advanced global options:'
  description: dump video coding statistics to file
  provenance:
    sources:
    - help-text
- spellings:
  - -vstats_version
  group: 'Advanced global options:'
  description: Version of the vstats format to use.
  provenance:
    sources:
    - help-text
- spellings:
  - -qphist
  group: 'Advanced global options:'
