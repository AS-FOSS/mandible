  - -sample_fmts
  group: 'Print help / information / capabilities:'
  description: show available audio sample formats
  provenance:
    sources:
    - help-text
- spellings:
  - -dispositions
  group: 'Print help / information / capabilities:'
  description: show available stream dispositions
  provenance:
    sources:
    - help-text
- spellings:
  - -colors
  group: 'Print help / information / capabilities:'
  description: show available color names
  provenance:
    sources:
    - help-text
- spellings:
  - -sources
  value_name: device
  value_kind: Required
  group: 'Print help / information / capabilities:'
  description: list sources of the input device
  provenance:
    sources:
    - help-text
- spellings:
  - -sinks
  value_name: device
  value_kind: Required
  group: 'Print help / information / capabilities:'
  description: list sinks of the output device
  provenance:
    sources:
    - help-text
- spellings:
  - -hwaccels
  group: 'Print help / information / capabilities:'
  description: show available HW acceleration methods
  provenance:
    sources:
    - help-text
- spellings:
  - -loglevel
  value_name: loglevel
  value_kind: Required
  group: 'Global options (affect whole program instead of just one file):'
  description: set logging level
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  value_name: loglevel
  value_kind: Required
  group: 'Global options (affect whole program instead of just one file):'
  description: set logging level
  provenance:
    sources:
    - help-text
- spellings:
  - -report
  group: 'Global options (affect whole program instead of just one file):'
  description: generate a report
  provenance:
    sources:
    - help-text
- spellings:
  - -max_alloc
  value_name: bytes
  value_kind: Required
  group: 'Global options (affect whole program instead of just one file):'
  description: set maximum size of a single allocated block
  provenance:
    sources:
    - help-text
- spellings:
  - -y
  group: 'Global options (affect whole program instead of just one file):'
  description: overwrite output files
  provenance:
    sources:
    - help-text
- spellings:
  - -n
  group: 'Global options (affect whole program instead of just one file):'
  description: never overwrite output files
  provenance:
    sources:
    - help-text
- spellings:
  - -ignore_unknown
  group: 'Global options (affect whole program instead of just one file):'
  description: Ignore unknown stream types
  provenance:
    sources:
    - help-text
- spellings:
  - -filter_threads
  group: 'Global options (affect whole program instead of just one file):'
  description: number of non-complex filter threads
  provenance:
    sources:
    - help-text
- spellings:
  - -filter_complex_threads
  group: 'Global options (affect whole program instead of just one file):'
  description: number of threads for -filter_complex
  provenance:
    sources:
    - help-text
- spellings:
  - -stats
  group: 'Global options (affect whole program instead of just one file):'
  description: print progress report during encoding
  provenance:
    sources:
    - help-text
- spellings:
  - -max_error_rate
  group: 'Global options (affect whole program instead of just one file):'
  description: 'ratio of decoding errors (0.0: no errors, 1.0: 100% errors) above which ffmpeg returns an error instead of success.'
  provenance:
    sources:
    - help-text
- spellings:
  - -cpuflags
  value_name: flags
  value_kind: Required
  group: 'Advanced global options:'
  description: force specific cpu flags
  provenance:
    sources:
    - help-text
- spellings:
  - -cpucount
  value_name: count
  value_kind: Required
  group: 'Advanced global options:'
  description: force specific cpu count
  provenance:
    sources:
    - help-text
- spellings:
  - -hide_banner
  value_name: hide_banner
  value_kind: Required
  group: 'Advanced global options:'
  description: do not show program banner
  provenance:
    sources:
    - help-text
- spellings:
  - -copy_unknown
  group: 'Advanced global options:'
  description: Copy unknown stream types
  provenance:
    sources:
    - help-text
- spellings:
  - -recast_media
  group: 'Advanced global options:'
  description: allow recasting stream type in order to force a decoder of different media type
  provenance:
    sources:
    - help-text
- spellings:
  - -benchmark
  group: 'Advanced global options:'
  description: add timings for benchmarking
  provenance:
    sources:
    - help-text
- spellings:
  - -benchmark_all
  group: 'Advanced global options:'
  description: add timings for each task
  provenance:
    sources:
    - help-text
- spellings:
  - -progress
  value_name: url
  value_kind: Required
  group: 'Advanced global options:'
  description: write program-readable progress information
  provenance:
    sources:
    - help-text
- spellings:
  - -stdin
  group: 'Advanced global options:'
  description: enable or disable interaction on standard input
  provenance:
    sources:
    - help-text
- spellings:
  - -timelimit
  value_name: limit
  value_kind: Required
  group: 'Advanced global options:'
  description: set max runtime in seconds in CPU user time
  provenance:
    sources:
    - help-text
- spellings:
  - -dump
  group: 'Advanced global options:'
  description: dump each input packet
  provenance:
    sources:
    - help-text
- spellings:
  - -hex
  group: 'Advanced global options:'
  description: when dumping packets, also dump the payload
  provenance:
    sources:
    - help-text
- spellings:
  - -vsync
  group: 'Advanced global options:'
  description: set video sync method globally; deprecated, use -fps_mode
  provenance:
    sources:
    - help-text
- spellings:
  - -frame_drop_threshold
  group: 'Advanced global options:'
  description: frame drop threshold
  provenance:
    sources:
    - help-text
- spellings:
  - -adrift_threshold
  value_name: threshold
  value_kind: Required
  group: 'Advanced global options:'
  description: deprecated, does nothing
  provenance:
    sources:
    - help-text
- spellings:
  - -copyts
  group: 'Advanced global options:'
  description: copy timestamps
  provenance:
    sources:
    - help-text
- spellings:
  - -start_at_zero
  group: 'Advanced global options:'
