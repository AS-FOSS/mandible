  single_dash: true
  description: audio pad
  provenance:
    sources:
    - help-text
- long: frames
  single_dash: true
  description: set the number of frames to output
  provenance:
    sources:
    - help-text
- long: filter
  single_dash: true
  description: set stream filtergraph
  provenance:
    sources:
    - help-text
- short: 'f'
  value_name: ilter_script
  value_kind: Required
  description: read stream filtergraph description from a file
  provenance:
    sources:
    - help-text
- short: 'r'
  value_name: einit_filter
  value_kind: Required
  description: reinit filtergraph on input parameter changes
  provenance:
    sources:
    - help-text
- long: discard
  single_dash: true
  description: discard
  provenance:
    sources:
    - help-text
- long: disposition
  single_dash: true
  description: disposition
  provenance:
    sources:
    - help-text
- long: vframes
  single_dash: true
  description: set the number of video frames to output
  provenance:
    sources:
    - help-text
- short: 'r'
  value_name: rate
  value_kind: Required
  description: set frame rate (Hz value, fraction or abbreviation)
  provenance:
    sources:
    - help-text
- long: fpsmax
  single_dash: true
  description: set max frame rate (Hz value, fraction or abbreviation)
  provenance:
    sources:
    - help-text
- short: 's'
  value_name: size
  value_kind: Required
  description: set frame size (WxH or abbreviation)
  provenance:
    sources:
    - help-text
- long: aspect
  single_dash: true
  description: set aspect ratio (4:3, 16:9 or 1.3333, 1.7777)
  provenance:
    sources:
    - help-text
- short: 'd'
  value_name: isplay_rotation
  value_kind: Required
  description: set pure counter-clockwise rotation in degrees for stream(s)
  provenance:
    sources:
    - help-text
- short: 'd'
  value_name: isplay_hflip
  value_kind: Required
  description: set display horizontal flip for stream(s) (overrides any display rotation if it is not set)
  provenance:
    sources:
    - help-text
- short: 'd'
  value_name: isplay_vflip
  value_kind: Required
  description: set display vertical flip for stream(s) (overrides any display rotation if it is not set)
  provenance:
    sources:
    - help-text
- short: 'v'
  value_name: n
  value_kind: Required
  description: disable video
  provenance:
    sources:
    - help-text
- long: vcodec
  single_dash: true
  description: force video codec ('copy' to copy stream)
  provenance:
    sources:
    - help-text
- long: timecode
  single_dash: true
  description: set initial TimeCode value.
  provenance:
    sources:
    - help-text
- long: pass
  single_dash: true
  description: select the pass number (1 to 3)
  provenance:
    sources:
    - help-text
- short: 'v'
  value_name: f
  value_kind: Required
  description: set video filters
  provenance:
    sources:
    - help-text
- short: 'b'
  value_name: bitrate
  value_kind: Required
  description: video bitrate (please use -b:v)
  provenance:
    sources:
    - help-text
- short: 'd'
  value_name: n
  value_kind: Required
  description: disable data
  provenance:
    sources:
    - help-text
- long: aframes
  single_dash: true
  description: set the number of audio frames to output
  provenance:
    sources:
    - help-text
- short: 'a'
  value_name: q
  value_kind: Required
  description: set audio quality (codec-specific)
  provenance:
    sources:
    - help-text
- short: 'a'
  value_name: r
