- long: acodec
  single_dash: true
  description: force audio codec ('copy' to copy stream)
  provenance:
    sources:
    - help-text
- short: 'a'
  value_name: b
  value_kind: Required
  description: audio bitrate (please use -b:a)
  provenance:
    sources:
    - help-text
- short: 'a'
  value_name: f
  value_kind: Required
  description: set audio filters
  provenance:
    sources:
    - help-text
- short: 's'
  value_name: size
  value_kind: Required
  description: set frame size (WxH or abbreviation)
  provenance:
    sources:
    - help-text
- short: 's'
  value_name: n
  value_kind: Required
  description: disable subtitle
  provenance:
    sources:
    - help-text
