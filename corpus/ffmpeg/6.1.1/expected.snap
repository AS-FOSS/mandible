name: ffmpeg
description: Hyper fast Audio and Video encoder
usage:
- 'usage: ffmpeg [options] [[infile options] -i infile]... {[outfile options] outfile}...'
flags:
- spellings:
  - -h
  group: 'Getting help:'
  description: -- print basic options
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  value_name: long
  value_kind: Required
  group: 'Getting help:'
  description: print more options
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  value_name: full
  value_kind: Required
  group: 'Getting help:'
  description: print all options (including all format and codec specific options, very long)
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  value_name: type=name
  value_kind: Required
  group: 'Getting help:'
  description: print all options for the named decoder/encoder/demuxer/muxer/filter/bsf/protocol
  provenance:
    sources:
    - help-text
- spellings:
  - -L
  group: 'Print help / information / capabilities:'
  description: show license
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  value_name: topic
  value_kind: Required
  group: 'Print help / information / capabilities:'
  description: show help
  provenance:
    sources:
    - help-text
- spellings:
  - -?
  value_name: topic
  value_kind: Required
  group: 'Print help / information / capabilities:'
  description: show help
  provenance:
    sources:
    - help-text
- spellings:
  - -help
  value_name: topic
  value_kind: Required
  group: 'Print help / information / capabilities:'
  description: show help
  provenance:
    sources:
    - help-text
- spellings:
  - -version
  group: 'Print help / information / capabilities:'
  description: show version
  provenance:
    sources:
    - help-text
- spellings:
  - -buildconf
  group: 'Print help / information / capabilities:'
  description: show build configuration
  provenance:
    sources:
    - help-text
- spellings:
  - -formats
  group: 'Print help / information / capabilities:'
  description: show available formats
  provenance:
    sources:
    - help-text
- spellings:
  - -muxers
  group: 'Print help / information / capabilities:'
  description: show available muxers
  provenance:
    sources:
    - help-text
- spellings:
  - -demuxers
  group: 'Print help / information / capabilities:'
  description: show available demuxers
  provenance:
    sources:
    - help-text
- spellings:
  - -devices
  group: 'Print help / information / capabilities:'
  description: show available devices
  provenance:
    sources:
    - help-text
- spellings:
  - -codecs
  group: 'Print help / information / capabilities:'
  description: show available codecs
  provenance:
    sources:
    - help-text
- spellings:
  - -decoders
  group: 'Print help / information / capabilities:'
  description: show available decoders
  provenance:
    sources:
    - help-text
- spellings:
  - -encoders
  group: 'Print help / information / capabilities:'
  description: show available encoders
  provenance:
    sources:
    - help-text
- spellings:
  - -bsfs
  group: 'Print help / information / capabilities:'
  description: show available bit stream filters
  provenance:
    sources:
    - help-text
- spellings:
  - -protocols
  group: 'Print help / information / capabilities:'
  description: show available protocols
