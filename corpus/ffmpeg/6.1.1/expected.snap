- spellings:
  - -bug
  value_name: flags
  value_kind: Required
  choices:
  - name: autodetect
    description: .D.V.......
  - name: xvid_ilace
    description: .D.V....... Xvid interlacing bug (autodetected if FOURCC == XVIX)
  - name: ump4
    description: .D.V....... (autodetected if FOURCC == UMP4)
  - name: no_padding
