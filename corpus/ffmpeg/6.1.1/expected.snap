    sources:
    - help-text
- short: 'a'
  value_name: c
  value_kind: Required
  description: set number of audio channels
  provenance:
    sources:
    - help-text
- short: 'a'
  value_name: n
  value_kind: Required
  description: disable audio
  provenance:
    sources:
