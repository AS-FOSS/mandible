  - name: live
    description: -1 .D......... live stream
  - name: recorded
    description: 0 .D......... recorded stream
  group: 'rtmp AVOptions:'
  description: Specify that the media is a live stream. (from INT_MIN to INT_MAX) (default any)
  provenance:
    sources:
    - help-text
