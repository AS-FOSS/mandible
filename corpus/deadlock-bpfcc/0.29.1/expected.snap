name: deadlock-bpfcc
usage:
- 'usage: deadlock-bpfcc [-h] [--binary BINARY] [--dump-graph DUMP_GRAPH] [--verbose] [--lock-symbols LOCK_SYMBOLS] [--unlock-symbols UNLOCK_SYMBOLS] [-t THREADS] [-e EDGES] [-s STACKTRACES] pid'
positionals:
- name: pid
  required: true
  description: Pid to trace
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - --binary
  value_name: BINARY
  value_kind: Required
  description: 'If set, trace the mutexes from the binary at this path. For statically-linked binaries, this argument is not required. For dynamically-linked binaries, this argument is required and should be the path of the pthread library the binary is using. Example: /lib/x86_64-linux-gnu/libpthread.so.0'
  provenance:
    sources:
    - help-text
- spellings:
  - --dump-graph
  value_name: DUMP_GRAPH
  value_kind: Required
  description: If set, this will dump the mutex graph to the specified file.
  provenance:
    sources:
    - help-text
- spellings:
  - --verbose
  description: Print statistics about the mutex wait graph.
  provenance:
    sources:
    - help-text
- spellings:
  - --lock-symbols
  value_name: LOCK_SYMBOLS
  value_kind: Required
  description: Comma-separated list of lock symbols to trace. Default is pthread_mutex_lock. These symbols cannot be inlined in the binary.
  provenance:
    sources:
    - help-text
- spellings:
  - --unlock-symbols
  value_name: UNLOCK_SYMBOLS
  value_kind: Required
  description: Comma-separated list of unlock symbols to trace. Default is pthread_mutex_unlock. These symbols cannot be inlined in the binary.
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  - --threads
  value_name: THREADS
  value_kind: Required
  description: Specifies the maximum number of threads to trace. default 65536. Note. 40 bytes per thread.
  provenance:
    sources:
    - help-text
- spellings:
  - -e
  - --edges
  value_name: EDGES
  value_kind: Required
  description: Specifies the maximum number of edge cases that can be recorded. default 65536. Note. 88 bytes per edge case.
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --stacktraces
  value_name: STACKTRACES
  value_kind: Required
  description: Specifies the maximum number of stack traces that can be recorded. This number is rounded up to the next power of two.default 65536. Note. 1 kbytes vmalloced per stack trace.
  provenance:
    sources:
    - help-text
detected_framework: argparse
provenance:
  sources:
  - help-text
  confidence: 0.83
children_filled: true
