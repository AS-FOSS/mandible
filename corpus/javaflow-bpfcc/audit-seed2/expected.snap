name: javaflow-bpfcc
description: Trace method execution flow in high-level languages.
usage:
- 'usage: uflow [-h] [-l {java,perl,php,python,ruby,tcl}] [-M METHOD] [-C CLAZZ] [-v] pid'
positionals:
- name: pid
  required: true
  description: process id to attach to
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -l
  - --language
  value_kind: Required
  choices:
  - java
  - perl
  - php
  - python
  - ruby
  - tcl
  description: language to trace
  provenance:
    sources:
    - help-text
- spellings:
  - -M
  - --method
  value_name: METHOD
  value_kind: Required
  description: trace only calls to methods starting with this prefix
  provenance:
    sources:
    - help-text
- spellings:
  - -C
  - --class
  value_name: CLAZZ
  value_kind: Required
  description: trace only calls to classes starting with this prefix
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  description: 'verbose mode: print the BPF program (for debugging purposes)'
  provenance:
    sources:
    - help-text
examples:
- command: |-
    ./uflow -l java 185                # trace Java method calls in process 185
    ./uflow -l ruby 134                # trace Ruby method calls in process 134
    ./uflow -M indexOf -l java 185     # trace only 'indexOf'-prefixed methods
    ./uflow -C '<stdin>' -l python 180 # trace only REPL-defined methods
detected_framework: argparse
provenance:
  sources:
  - help-text
  confidence: 1.0
children_filled: true
