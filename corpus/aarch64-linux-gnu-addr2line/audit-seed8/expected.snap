name: aarch64-linux-gnu-addr2line
description: |-
  Convert addresses into line number/file name pairs. If no addresses are specified on the command line, they will be read from stdin

  /usr/bin/aarch64-linux-gnu-addr2line: supported targets: elf64-littleaarch64 elf64-bigaarch64 elf32-littleaarch64 elf32-bigaarch64 elf32-littlearm elf32-bigarm pei-aarch64-little pe-aarch64-little elf64-little elf64-big elf32-little elf32-big srec symbolsrec verilog tekhex binary ihex plugin Report bugs to <https://sourceware.org/bugzilla/>
usage:
- 'Usage: /usr/bin/aarch64-linux-gnu-addr2line [option(s)] [addr(s)]'
positionals:
- name: addr(s)
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - '@'
  value_name: <file>
  value_kind: Required
  group: 'The options are:'
  description: Read options from <file>
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --addresses
  group: 'The options are:'
  description: Show addresses
  provenance:
    sources:
    - help-text
- spellings:
  - -b
  - --target
  value_name: <bfdname>
  value_kind: Required
  group: 'The options are:'
  description: Set the binary file format
