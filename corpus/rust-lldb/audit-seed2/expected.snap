    sources:
    - help-text
- spellings:
  - --one-line-before-file
  value_name: <command>
  value_kind: Required
  group: 'COMMANDS:'
  description: Tells the debugger to execute this one-line lldb command before any file provided on the command line has been loaded.
  provenance:
    sources:
    - help-text
- spellings:
  - --one-line-on-crash
  value_name: <command>
  value_kind: Required
  group: 'COMMANDS:'
  description: When in batch mode, tells the debugger to run this one-line lldb command if the target crashes.
  provenance:
    sources:
    - help-text
- spellings:
  - --one-line
  value_name: <command>
  value_kind: Required
  group: 'COMMANDS:'
  description: Tells the debugger to execute this one-line lldb command after any file provided on the command line has been loaded.
