    sources:
    - help-text
- spellings:
  - --local-lldbinit
  group: 'COMMANDS:'
  description: Allow the debugger to parse the .lldbinit files in the current working directory, unless --no-lldbinit is passed.
  provenance:
    sources:
    - help-text
- spellings:
  - --no-lldbinit
  group: 'COMMANDS:'
  description: Do not automatically parse any '.lldbinit' files.
