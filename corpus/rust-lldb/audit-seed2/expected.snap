name: rust-lldb
description: 'OVERVIEW: LLDB'
usage:
- 'USAGE: lldb [options]'
flags:
- spellings:
  - --attach-name
  value_name: <name>
  value_kind: Required
  group: 'ATTACHING:'
  description: Tells the debugger to attach to a process with the given name.
