name: iptables-apply
description: |-
  iptables-apply 1.1 -- a safer way to update iptables remotely

  The script will try to apply a new rulesfile (as output by iptables-save, read by iptables-restore) or run a command to configure iptables and then prompt the user whether the changes are okay. If the new iptables rules cut the existing connection, the user will not be able to answer affirmatively. In this case, the script rolls back to the previous working iptables rules after the timeout expires.
usage:
- '  iptables-apply [-hV] [-t timeout] [-w savefile] {[rulesfile]|-c [runcmd]}'
flags:
- spellings:
  - -t
  - --timeout
  value_name: seconds
  value_kind: Required
  description: 'Specify the timeout in seconds (default: 10).'
  provenance:
    sources:
    - help-text
- spellings:
  - -w
  - --write
  value_name: savefile
  value_kind: Required
  description: 'Specify the savefile where successfully applied rules will be written to (default if empty string is given: /etc/network/iptables.up.rules).'
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  - --command
  value_name: runcmd
  value_kind: Required
  description: 'Run command runcmd to configure iptables instead of applying a rulesfile (default: /etc/network/iptables.up.run).'
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  description: Display this help text.
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  description: Display version information.
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
