name: wpa_supplicant
description: |-
  This software may be distributed under the terms of the BSD license. See README for more details.

  This product includes software developed by the OpenSSL Project for use in the OpenSSL Toolkit (http://www.openssl.org/)
usage:
- 'usage:'
- '  wpa_supplicant [-BddhKLqqstuvW] [-P<pid file>] [-g<global ctrl>] [-G<group>] -i<ifname> -c<config file> [-C<ctrl>] [-D<driver>] [-p<driver_param>] [-b<br_ifname>] [-e<entropy file>] [-f<debug file>] [-o<override driver>] [-O<override ctrl>] [-N -i<ifname> -c<conf> [-C<ctrl>] [-D<driver>] [-m<P2P Device config file>] [-p<driver_param>] [-b<br_ifname>] [-I<config file>] ...]'
flags:
- spellings:
  - -b
  description: optional bridge interface name
  provenance:
    sources:
    - help-text
- spellings:
  - -B
  description: run daemon in the background
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  description: Configuration file
  provenance:
    sources:
    - help-text
- spellings:
  - -C
  description: ctrl_interface parameter (only used if -c is not)
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  description: increase debugging verbosity (-dd even more)
  provenance:
    sources:
    - help-text
- spellings:
  - -D
  description: 'driver name (can be multiple drivers: nl80211,wext)'
  provenance:
    sources:
    - help-text
- spellings:
  - -e
  description: entropy file
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  description: log output to debug file instead of stdout
  provenance:
    sources:
    - help-text
- spellings:
  - -g
  description: global ctrl_interface
  provenance:
    sources:
    - help-text
- spellings:
  - -G
  description: global ctrl_interface group
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  description: show this help text
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  description: interface name
  provenance:
    sources:
    - help-text
- spellings:
  - -I
  description: additional configuration file
  provenance:
    sources:
    - help-text
- spellings:
  - -K
  description: include keys (passwords, etc.) in debug output
  provenance:
    sources:
    - help-text
- spellings:
  - -L
  description: show license (BSD)
  provenance:
    sources:
    - help-text
- spellings:
  - -m
  description: Configuration file for the P2P Device interface
  provenance:
    sources:
    - help-text
- spellings:
  - -N
  description: start describing new interface
  provenance:
    sources:
    - help-text
- spellings:
  - -o
  description: override driver parameter for new interfaces
  provenance:
    sources:
    - help-text
- spellings:
  - -O
  description: override ctrl_interface parameter for new interfaces
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  description: driver parameters
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  description: PID file
  provenance:
    sources:
    - help-text
- spellings:
  - -q
  description: decrease debugging verbosity (-qq even less)
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  description: log output to syslog instead of stdout
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  description: include timestamp in debug messages
  provenance:
    sources:
    - help-text
- spellings:
  - -T
  description: record to Linux tracing in addition to logging (records all messages regardless of debug verbosity)
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  description: enable DBus control interface
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  description: show version
  provenance:
    sources:
    - help-text
- spellings:
  - -W
  description: wait for a control interface monitor before starting
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
