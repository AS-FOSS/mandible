name: dbiprof
usage:
- dbiprof [options] [files]
flags:
- spellings:
  - -number
  value_name: N
  value_kind: Required
  description: show top N, defaults to 10
  provenance:
    sources:
    - help-text
- spellings:
  - -sort
  value_name: S
  value_kind: Required
  description: sort by S, defaults to total
  provenance:
    sources:
    - help-text
- spellings:
  - -reverse
  description: reverse the sort
  provenance:
    sources:
    - help-text
- spellings:
  - -match
  value_name: K=V
  value_kind: Required
  description: for filtering, see docs
  provenance:
    sources:
    - help-text
- spellings:
  - -exclude
  value_name: K=V
  value_kind: Required
  description: for filtering, see docs
  provenance:
    sources:
    - help-text
- spellings:
  - -case_sensitive
  description: for -match and -exclude
  provenance:
    sources:
    - help-text
- spellings:
  - -delete
  description: rename files before reading then delete afterwards
  provenance:
    sources:
    - help-text
- spellings:
  - -version
  description: print version number and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -help
  description: print this help
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
