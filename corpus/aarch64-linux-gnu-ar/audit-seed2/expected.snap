name: aarch64-linux-gnu-ar
description: '/usr/bin/aarch64-linux-gnu-ar: supported targets: elf64-littleaarch64 elf64-bigaarch64 elf32-littleaarch64 elf32-bigaarch64 elf32-littlearm elf32-bigarm pei-aarch64-little pe-aarch64-little elf64-little elf64-big elf32-little elf32-big srec symbolsrec verilog tekhex binary ihex plugin Report bugs to <https://sourceware.org/bugzilla/>'
usage:
- 'Usage: /usr/bin/aarch64-linux-gnu-ar [emulation options] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [--plugin <name>] [member-name] [count] archive-file file... /usr/bin/aarch64-linux-gnu-ar -M [<mri-script]'
flags:
- value_name: <file>
  value_kind: Required
  group: 'generic modifiers:'
  description: '- read options from <file>'
  provenance:
    sources:
    - help-text
- long: target
  value_name: BFDNAME
  value_kind: Required
  group: 'generic modifiers:'
  description: specify the target object format as BFDNAME
  provenance:
    sources:
    - help-text
- long: output
  value_name: DIRNAME
  value_kind: Required
  group: 'generic modifiers:'
  description: specify the output directory for extraction operations
  provenance:
    sources:
    - help-text
- long: record-libdeps
  value_name: <text>
  value_kind: Required
  group: 'generic modifiers:'
  description: '- specify the dependencies of this library'
  provenance:
    sources:
    - help-text
- long: thin
  group: 'generic modifiers:'
  description: '- make a thin archive'
  provenance:
    sources:
    - help-text
- long: plugin
  value_name: <p>
  value_kind: Required
  group: 'optional:'
  description: '- load the specified plugin'
  provenance:
    sources:
    - help-text
- short: 'M'
  provenance:
    sources:
    - help-text-synopsis
modifiers:
- name: a
  group: 'command specific modifiers:'
  description: put file(s) after [member-name]
  provenance:
    sources:
    - help-text
- name: b
  group: 'command specific modifiers:'
  description: put file(s) before [member-name] (same as [i])
  provenance:
    sources:
    - help-text
- name: D
  group: 'command specific modifiers:'
  description: use zero for timestamps and uids/gids (default)
  provenance:
    sources:
    - help-text
- name: U
  group: 'command specific modifiers:'
  description: use actual timestamps and uids/gids
  provenance:
    sources:
    - help-text
- name: N
  group: 'command specific modifiers:'
  description: use instance [count] of name
  provenance:
    sources:
    - help-text
- name: f
  group: 'command specific modifiers:'
  description: truncate inserted file names
  provenance:
    sources:
    - help-text
- name: P
  group: 'command specific modifiers:'
  description: use full path names when matching
  provenance:
    sources:
    - help-text
- name: o
  group: 'command specific modifiers:'
  description: preserve original dates
  provenance:
    sources:
    - help-text
- name: O
  group: 'command specific modifiers:'
  description: display offsets of files in the archive
  provenance:
    sources:
    - help-text
- name: u
  group: 'command specific modifiers:'
  description: only replace files that are newer than current archive contents
  provenance:
    sources:
    - help-text
- name: c
  group: 'generic modifiers:'
  description: do not warn if the library had to be created
  provenance:
    sources:
    - help-text
- name: s
  group: 'generic modifiers:'
  description: create an archive index (cf. ranlib)
  provenance:
    sources:
    - help-text
- name: l
  value_name: <text>
  value_kind: Required
  group: 'generic modifiers:'
  description: specify the dependencies of this library
  provenance:
    sources:
    - help-text
- name: S
  group: 'generic modifiers:'
  description: do not build a symbol table
  provenance:
    sources:
    - help-text
- name: T
  group: 'generic modifiers:'
  description: deprecated, use --thin instead
  provenance:
    sources:
    - help-text
- name: v
  group: 'generic modifiers:'
  description: be verbose
  provenance:
    sources:
    - help-text
- name: V
  group: 'generic modifiers:'
  description: display the version number
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
subcommands:
- name: d
  summary: '- delete file(s) from the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: m
  summary: '- move file(s) in the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: p
  summary: '- print file(s) found in the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: q
  summary: '- quick append file(s) to the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: r
  summary: '- replace existing or insert new file(s) into the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: s
  summary: '- act as ranlib'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: t
  summary: '- display contents of the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: x
  summary: '- extract file(s) from the archive'
  group: 'commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
