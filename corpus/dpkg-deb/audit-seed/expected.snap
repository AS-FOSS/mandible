  provenance:
    sources:
    - help-text
- spellings:
  - --version
  group: 'Commands:'
  description: Show the version.
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  description: Enable verbose output.
  provenance:
    sources:
