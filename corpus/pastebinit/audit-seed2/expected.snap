name: pastebinit
description: |-
  Invalid arguments: option --help not recognized!

  pastebinit v1.6.2

  Reads on stdin for input or takes a list of files as parameters
usage:
- 'Usage:  pastebinit [OPTION...] [FILE...]'
positionals:
- name: FILE
  variadic: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -b
  value_name: <pastebin>
  value_kind: Required
  group: 'General arguments:'
  description: (default is 'dpaste.com')
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  value_name: <input file>
  value_kind: Required
  group: 'General arguments:'
  provenance:
    sources:
    - help-text
- spellings:
  - -l
  group: 'General arguments:'
  description: List all supported pastebins
  provenance:
    sources:
    - help-text
- spellings:
  - -E
  group: 'General arguments:'
  description: Print the content to stdout too
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  group: 'General arguments:'
  description: Print this help screen
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  group: 'General arguments:'
  description: Print the version number
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  group: 'General arguments:'
  description: Print verbose output to stderr
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  value_name: <author>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is 'None')
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  value_name: <title of paste>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is none)
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  value_name: <format of paste>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is 'text')
  provenance:
    sources:
    - help-text
- spellings:
  - -j
  value_name: <jabberid>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is '')
  provenance:
    sources:
    - help-text
- spellings:
  - -m
  value_name: <permatag>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is none)
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  value_name: <private level>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: (default is '1')
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  value_name: <username>
  value_kind: Required
  group: 'Optional arguments (not supported by all pastebins):'
  description: -p <password>
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
