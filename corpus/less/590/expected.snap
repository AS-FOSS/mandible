    sources:
    - help-text
- spellings:
  - -h
  - --max-back-scroll
  value_name: N
  value_kind: Optional
  optional_join: equals
  description: Backward scroll limit.
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  - --ignore-case
  description: Ignore case in searches that do not contain uppercase.
  provenance:
    sources:
    - help-text
- spellings:
  - -I
  - --IGNORE-CASE
  description: Ignore case in all searches.
