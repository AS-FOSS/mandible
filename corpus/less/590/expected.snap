    sources:
    - help-text
- spellings:
  - -#
  - --shift
  value_name: N
  value_kind: Optional
  optional_join: equals
  description: Set horizontal scroll amount (0 = one half screen width).
  provenance:
    sources:
    - help-text
- spellings:
  - --file-size
  description: Automatically determine the size of the input file.
  provenance:
    sources:
    - help-text
- spellings:
  - --follow-name
  description: The F command changes files if the input file is renamed.
  provenance:
    sources:
    - help-text
- spellings:
  - --incsearch
  description: Search file as each pattern character is typed in.
