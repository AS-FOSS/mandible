name: less
flags:
- spellings:
  - -<
  value_name: flag>
  value_kind: Required
  group: MISCELLANEOUS COMMANDS
  description: Toggle a command line option [see OPTIONS below].
  provenance:
    sources:
    - help-text
- spellings:
  - -?
  - --help
  description: Display help (from command line).
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --search-skip-screen
  description: Search skips current screen.
  provenance:
    sources:
    - help-text
- spellings:
  - -A
  - --SEARCH-SKIP-SCREEN
  description: Search starts just after target line.
  provenance:
    sources:
    - help-text
- spellings:
  - -b
  - --buffers
  value_name: N
  value_kind: Optional
  optional_join: equals
  description: Number of buffers.
  provenance:
    sources:
    - help-text
- spellings:
  - -B
  - --auto-buffers
  description: Don't automatically allocate buffers for pipes.
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  - --clear-screen
  description: Repaint by clearing rather than scrolling.
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  - --dumb
  description: Dumb terminal.
  provenance:
    sources:
    - help-text
- spellings:
  - -D
  - --color
  value_name: xcolor
  value_kind: Required
  description: Set screen colors.
