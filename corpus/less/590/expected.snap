    sources:
    - help-text
- spellings:
  - -"
  - --quotes
  value_name: '[c[c]]'
  value_kind: Optional
  optional_join: separate
  description: Set shell quote characters.
  provenance:
    sources:
    - help-text
- spellings:
  - -~
  - --tilde
  description: Don't display tildes after end of file.
