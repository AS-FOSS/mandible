name: grub-set-default
description: Set the default boot menu entry for GRUB. This requires setting GRUB_DEFAULT=saved in /etc/default/grub.
usage:
- 'Usage: grub-set-default [OPTION] MENU_ENTRY'
positionals:
- name: MENU_ENTRY
  required: true
  provenance:
    sources:
    - help-text
flags:
- short: 'h'
  long: help
  description: print this message and exit
  provenance:
    sources:
    - help-text
- short: 'V'
  long: version
  description: print the version information and exit
  provenance:
    sources:
    - help-text
- long: boot-directory
  value_name: DIR
  value_kind: Required
  description: expect GRUB images under the directory DIR/grub instead of the /boot/grub directory
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
