name: dpkg-statoverride
usage:
- 'Usage: dpkg-statoverride [<option> ...] <command>'
positionals:
- name: command
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - --add
  value_name: <owner>
  value_kind: Required
  group: 'Commands:'
  description: <group> <mode> <path> add a new <path> entry into the database.
  provenance:
    sources:
    - help-text
- spellings:
  - --remove
  value_name: <path>
  value_kind: Required
  group: 'Commands:'
  description: remove <path> from the database.
  provenance:
    sources:
    - help-text
- spellings:
  - --list
  value_name: <glob-pattern>
  value_kind: Optional
  group: 'Commands:'
  description: list current overrides in the database.
  provenance:
    sources:
    - help-text
- spellings:
  - --admindir
  value_name: <directory>
  value_kind: Required
  description: set the directory with the statoverride file.
  provenance:
    sources:
    - help-text
- spellings:
  - --instdir
  value_name: <directory>
  value_kind: Required
  description: set the root directory, but not the admin dir.
  provenance:
    sources:
    - help-text
- spellings:
  - --root
  value_name: <directory>
  value_kind: Required
  description: set the directory of the root filesystem.
  provenance:
    sources:
    - help-text
- spellings:
  - --update
  description: immediately update <path> permissions.
  provenance:
    sources:
    - help-text
- spellings:
  - --force
  description: deprecated alias for --force-all.
  provenance:
    sources:
    - help-text
- spellings:
  - --force-
  value_name: <thing>
  value_kind: Required
  description: override problems (see --force-help).
  provenance:
    sources:
    - help-text
- spellings:
  - --no-force-
  value_name: <thing>
  value_kind: Required
  description: stop when problems encountered.
  provenance:
    sources:
    - help-text
- spellings:
  - --refuse-
  value_name: <thing>
  value_kind: Required
  description: ditto.
  provenance:
    sources:
    - help-text
- spellings:
  - --quiet
  description: quiet operation, minimal output.
  provenance:
    sources:
    - help-text
- spellings:
  - --help
  description: show this help message.
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  description: show the version.
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
