name: zoxide
description: A smarter cd command for your terminal
usage:
- 'Usage:'
- zoxide <COMMAND>
positionals:
- name: COMMAND
  required: true
  provenance:
    sources:
    - help-text
flags:
- short: 'h'
  long: help
  description: Print help
  provenance:
    sources:
    - help-text
- short: 'V'
  long: version
  description: Print version
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
