name: compactsnoop-bpfcc
usage:
- 'usage: compactsnoop-bpfcc [-h] [-T] [-p PID] [-d DURATION] [-K] [-e]'
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -T
  - --timestamp
  description: include timestamp on output
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pid
  value_name: PID
  value_kind: Required
  description: trace this PID only
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  - --duration
  value_name: DURATION
  value_kind: Required
  description: total duration of trace in seconds
  provenance:
    sources:
    - help-text
- spellings:
  - -K
  - --kernel-stack
  description: output kernel stack trace
  provenance:
    sources:
    - help-text
- spellings:
  - -e
  - --extended_fields
  description: show system memory state
  provenance:
    sources:
    - help-text
detected_framework: argparse
provenance:
  sources:
  - help-text
  confidence: 1.0
children_filled: true
