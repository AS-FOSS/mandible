name: apport-cli
usage:
- 'usage: apport-cli [options] [symptom|pid|package|program path|.apport/.crash file]'
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  - --file-bug
  description: Start in bug filing mode. Requires --package and an optional --pid, or just a --pid. If neither is given, display a list of known symptoms. (Implied if a single argument is given.)
  provenance:
    sources:
    - help-text
- spellings:
  - -w
  - --window
  description: Click a window as a target for filing a problem report.
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  - --update-bug
  value_name: UPDATE_REPORT
  value_kind: Required
  description: Start in bug updating mode. Can take an optional --package.
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --symptom
  value_name: SYMPTOM
  value_kind: Required
  description: File a bug report about a symptom. (Implied if symptom name is given as only argument.)
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --package
  value_name: PACKAGE
  value_kind: Required
  description: Specify package name in --file-bug mode. This is optional if a --pid is specified. (Implied if package name is given as only argument.)
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  - --pid
  value_name: PID
  value_kind: Required
  description: Specify a running program in --file-bug mode. If this is specified, the bug report will contain more information. (Implied if pid is given as only argument.)
  provenance:
    sources:
    - help-text
- spellings:
  - --hanging
  description: The provided pid is a hanging application.
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  - --crash-file
  value_name: PATH
  value_kind: Required
  description: Report the crash from given .apport or .crash file instead of the pending ones in /var/crash. (Implied if file is given as only argument.)
  provenance:
    sources:
    - help-text
- spellings:
  - --save
  value_name: PATH
  value_kind: Required
  description: In bug filing mode, save the collected information into a file instead of reporting it. This file can then be reported later on from a different machine.
  provenance:
    sources:
    - help-text
- spellings:
  - --tag
  value_name: TAGS
  value_kind: Required
  description: Add an extra tag to the report. Can be specified multiple times.
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --version
  description: Print the Apport version number.
  provenance:
    sources:
    - help-text
detected_framework: argparse
provenance:
  sources:
  - help-text
  confidence: 1.0
children_filled: true
