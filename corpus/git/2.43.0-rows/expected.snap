name: git
usage:
- 'usage: git [-v | --version] [-h | --help] [-C <path>] [-c <name>=<value>] [--exec-path[=<path>]] [--html-path] [--man-path] [--info-path] [-p | --paginate | -P | --no-pager] [--no-replace-objects] [--bare] [--git-dir=<path>] [--work-tree=<path>] [--namespace=<name>] [--config-env=<name>=<envvar>] <command> [<args>]'
positionals:
- name: command
  required: true
  provenance:
    sources:
    - help-text
- name: args
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -v
  - --version
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -h
  - --help
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -C
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -c
  value_name: <name>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --exec-path
  value_name: <path>
  value_kind: Optional
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --html-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --man-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --info-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -p
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --paginate
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -P
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --no-pager
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --no-replace-objects
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --bare
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --git-dir
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --work-tree
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --namespace
  value_name: <name>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --config-env
  value_name: <name>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
subcommands:
- name: clone
  summary: Clone a repository into a new directory
  usage:
  - 'usage: git clone [<options>] [--] <repo> [<dir>]'
  positionals:
  - name: repo
    required: true
    provenance:
      sources:
      - help-text
  - name: dir
    provenance:
      sources:
      - help-text
  flags:
  - spellings:
    - -v
    - --[no-]verbose
    description: be more verbose
    provenance:
      sources:
      - help-text
  - spellings:
    - -q
    - --[no-]quiet
    description: be more quiet
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]progress
    description: force progress reporting
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]reject-shallow
    description: don't clone shallow repository
    provenance:
      sources:
      - help-text
  - spellings:
    - -n
    - --no-checkout
    description: don't create a checkout
    provenance:
      sources:
      - help-text
  - spellings:
    - --checkout
    description: opposite of --no-checkout
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]bare
    description: create a bare repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]mirror
    description: create a mirror repository (implies bare)
    provenance:
      sources:
      - help-text
  - spellings:
    - -l
    - --[no-]local
    description: to clone from a local repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --no-hardlinks
    description: don't use local hardlinks, always copy
    provenance:
      sources:
      - help-text
  - spellings:
    - --hardlinks
    description: opposite of --no-hardlinks
    provenance:
      sources:
      - help-text
  - spellings:
    - -s
    - --[no-]shared
    description: setup as shared repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]recurse-submodules
    value_name: <pathspec>
    value_kind: Optional
    description: initialize submodules in the clone
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]recursive
    value_name: <pathspec>
    value_kind: Optional
    description: alias of --recurse-submodules
    provenance:
      sources:
      - help-text
  - spellings:
    - -j
    - --[no-]jobs
    value_name: <n>
    value_kind: Required
    description: number of submodules cloned in parallel
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]template
    value_name: <template-directory>
    value_kind: Required
    description: directory from which templates will be used
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]reference
    value_name: <repo>
    value_kind: Required
    description: reference repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]reference-if-able
    value_name: <repo>
    value_kind: Required
    description: reference repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]dissociate
    description: use --reference only while cloning
    provenance:
      sources:
      - help-text
  - spellings:
    - -o
    - --[no-]origin
    value_name: <name>
    value_kind: Required
    description: use <name> instead of 'origin' to track upstream
    provenance:
      sources:
      - help-text
  - spellings:
    - -b
    - --[no-]branch
    value_name: <branch>
    value_kind: Required
    description: checkout <branch> instead of the remote's HEAD
    provenance:
      sources:
      - help-text
  - spellings:
    - -u
    - --[no-]upload-pack
    value_name: <path>
    value_kind: Required
    description: path to git-upload-pack on the remote
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]depth
    value_name: <depth>
    value_kind: Required
    description: create a shallow clone of that depth
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]shallow-since
    value_name: <time>
    value_kind: Required
    description: create a shallow clone since a specific time
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]shallow-exclude
    value_name: <revision>
    value_kind: Required
    description: deepen history of shallow clone, excluding rev
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]single-branch
    description: clone only one branch, HEAD or --branch
    provenance:
      sources:
      - help-text
  - spellings:
    - --no-tags
    description: don't clone any tags, and make later fetches not to follow them
    provenance:
      sources:
      - help-text
  - spellings:
    - --tags
    description: opposite of --no-tags
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]shallow-submodules
    description: any cloned submodules will be shallow
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]separate-git-dir
    value_name: <gitdir>
    value_kind: Required
    description: separate git dir from working tree
    provenance:
      sources:
      - help-text
  - spellings:
    - -c
    - --[no-]config
    value_name: <key=value>
    value_kind: Required
    description: set config inside the new repository
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]server-option
    value_name: <server-specific>
    value_kind: Required
    description: option to transmit
    provenance:
      sources:
      - help-text
  - spellings:
    - '-4'
    - --ipv4
    description: use IPv4 addresses only
    provenance:
      sources:
      - help-text
  - spellings:
    - '-6'
    - --ipv6
    description: use IPv6 addresses only
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]filter
    value_name: <args>
    value_kind: Required
    description: object filtering
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]also-filter-submodules
    description: apply partial clone filters to submodules
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]remote-submodules
    description: any cloned submodules will use their remote-tracking branch
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]sparse
    description: initialize sparse-checkout file to include only files at root
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]bundle-uri
    value_name: <uri>
    value_kind: Required
    description: a URI for downloading bundles before fetching from origin remote
    provenance:
      sources:
      - help-text
  - spellings:
    - --
    provenance:
      sources:
      - help-text-synopsis
  group: 'start a working area (see also: git help tutorial)'
  provenance:
    sources:
    - help-text
    confidence: 0.5
  children_filled: true
  heading_attested: true
- name: init
  summary: Create an empty Git repository or reinitialize an existing one
  group: 'start a working area (see also: git help tutorial)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: add
  summary: Add file contents to the index
  usage:
  - 'usage: git add [<options>] [--] <pathspec>...'
  positionals:
  - name: pathspec
    required: true
    variadic: true
    provenance:
      sources:
      - help-text
  flags:
  - spellings:
    - -n
    - --[no-]dry-run
    description: dry run
    provenance:
      sources:
      - help-text
  - spellings:
    - -v
    - --[no-]verbose
    description: be verbose
    provenance:
      sources:
      - help-text
  - spellings:
    - -i
    - --[no-]interactive
    description: interactive picking
    provenance:
      sources:
      - help-text
  - spellings:
    - -p
    - --[no-]patch
    description: select hunks interactively
    provenance:
      sources:
      - help-text
  - spellings:
    - -e
    - --[no-]edit
    description: edit current diff and apply
    provenance:
      sources:
      - help-text
  - spellings:
    - -f
    - --[no-]force
    description: allow adding otherwise ignored files
    provenance:
      sources:
      - help-text
  - spellings:
    - -u
    - --[no-]update
    description: update tracked files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]renormalize
    description: renormalize EOL of tracked files (implies -u)
    provenance:
      sources:
      - help-text
  - spellings:
    - -N
    - --[no-]intent-to-add
    description: record only the fact that the path will be added later
    provenance:
      sources:
      - help-text
  - spellings:
    - -A
    - --[no-]all
    description: add changes from all tracked and untracked files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]ignore-removal
    description: ignore paths removed in the working tree (same as --no-all)
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]refresh
    description: don't add, only refresh the index
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]ignore-errors
    description: just skip files which cannot be added because of errors
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]ignore-missing
    description: check if - even missing - files are ignored in dry run
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]sparse
    description: allow updating entries outside of the sparse-checkout cone
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]chmod
    value_name: (+|-)x
    value_kind: Required
    description: override the executable bit of the listed files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]pathspec-from-file
    value_name: <file>
    value_kind: Required
    description: read pathspec from file
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]pathspec-file-nul
    description: with --pathspec-from-file, pathspec elements are separated with NUL character
    provenance:
      sources:
      - help-text
  - spellings:
    - --
    provenance:
      sources:
      - help-text-synopsis
  group: 'work on the current change (see also: git help everyday)'
  provenance:
    sources:
    - help-text
    confidence: 0.5
  children_filled: true
  heading_attested: true
- name: mv
  summary: Move or rename a file, a directory, or a symlink
  group: 'work on the current change (see also: git help everyday)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: restore
  summary: Restore working tree files
  group: 'work on the current change (see also: git help everyday)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: rm
  summary: Remove files from the working tree and from the index
  usage:
  - 'usage: git rm [-f | --force] [-n] [-r] [--cached] [--ignore-unmatch] [--quiet] [--pathspec-from-file=<file> [--pathspec-file-nul]] [--] [<pathspec>...]'
  positionals:
  - name: pathspec
    variadic: true
    provenance:
      sources:
      - help-text
  flags:
  - spellings:
    - -n
    - --[no-]dry-run
    description: dry run
    provenance:
      sources:
      - help-text
  - spellings:
    - -q
    - --[no-]quiet
    description: do not list removed files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]cached
    description: only remove from the index
    provenance:
      sources:
      - help-text
  - spellings:
    - -f
    - --[no-]force
    description: override the up-to-date check
    provenance:
      sources:
      - help-text
  - spellings:
    - -r
    description: allow recursive removal
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]ignore-unmatch
    description: exit with a zero status even if nothing matched
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]sparse
    description: allow updating entries outside of the sparse-checkout cone
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]pathspec-from-file
    value_name: <file>
    value_kind: Required
    description: read pathspec from file
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]pathspec-file-nul
    description: with --pathspec-from-file, pathspec elements are separated with NUL character
    provenance:
      sources:
      - help-text
  - spellings:
    - --
    provenance:
      sources:
      - help-text-synopsis
  group: 'work on the current change (see also: git help everyday)'
  provenance:
    sources:
    - help-text
    confidence: 0.5
  children_filled: true
  heading_attested: true
- name: bisect
  summary: Use binary search to find the commit that introduced a bug
  group: 'examine the history and state (see also: git help revisions)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: diff
  summary: Show changes between commits, commit and working tree, etc
  usage:
  - 'usage: git diff --no-index [<options>] <path> <path>'
  positionals:
  - name: path
    required: true
    provenance:
      sources:
      - help-text
  flags:
  - spellings:
    - -p
    - --patch
    group: Diff output format options
    description: generate patch
    provenance:
      sources:
      - help-text
  - spellings:
    - -s
    - --no-patch
    group: Diff output format options
    description: suppress diff output
    provenance:
      sources:
      - help-text
  - spellings:
    - -u
    group: Diff output format options
    description: generate patch
    provenance:
      sources:
      - help-text
  - spellings:
    - -U
    - --unified
    value_name: <n>
    value_kind: Optional
    group: Diff output format options
    description: generate diffs with <n> lines context
    provenance:
      sources:
      - help-text
  - spellings:
    - -W
    - --[no-]function-context
    group: Diff output format options
    description: generate diffs with <n> lines context
    provenance:
      sources:
      - help-text
  - spellings:
    - --raw
    group: Diff output format options
    description: generate the diff in raw format
    provenance:
      sources:
      - help-text
  - spellings:
    - --patch-with-raw
    group: Diff output format options
    description: synonym for '-p --raw'
    provenance:
      sources:
      - help-text
  - spellings:
    - --patch-with-stat
    group: Diff output format options
    description: synonym for '-p --stat'
    provenance:
      sources:
      - help-text
  - spellings:
    - --numstat
    group: Diff output format options
    description: machine friendly --stat
    provenance:
      sources:
      - help-text
  - spellings:
    - --shortstat
    group: Diff output format options
    description: output only the last line of --stat
    provenance:
      sources:
      - help-text
  - spellings:
    - -X
    - --dirstat
    value_name: <param1,param2>...
    value_kind: Optional
    group: Diff output format options
    description: output the distribution of relative amount of changes for each sub-directory
    provenance:
      sources:
      - help-text
  - spellings:
    - --cumulative
    group: Diff output format options
    description: synonym for --dirstat=cumulative
    provenance:
      sources:
      - help-text
  - spellings:
    - --dirstat-by-file
    value_name: <param1,param2>...
    value_kind: Optional
    group: Diff output format options
    description: synonym for --dirstat=files,param1,param2...
    provenance:
      sources:
      - help-text
  - spellings:
    - --check
    group: Diff output format options
    description: warn if changes introduce conflict markers or whitespace errors
    provenance:
      sources:
      - help-text
  - spellings:
    - --summary
    group: Diff output format options
    description: condensed summary such as creations, renames and mode changes
    provenance:
      sources:
      - help-text
  - spellings:
    - --name-only
    group: Diff output format options
    description: show only names of changed files
    provenance:
      sources:
      - help-text
  - spellings:
    - --name-status
    group: Diff output format options
    description: show only names and status of changed files
    provenance:
      sources:
      - help-text
  - spellings:
    - --stat
    value_name: '[<width>[,<name-width>[,<count>]]]'
    value_kind: Optional
    group: Diff output format options
    description: generate diffstat
    provenance:
      sources:
      - help-text
  - spellings:
    - --stat-width
    value_name: <width>
    value_kind: Required
    group: Diff output format options
    description: generate diffstat with a given width
    provenance:
      sources:
      - help-text
  - spellings:
    - --stat-name-width
    value_name: <width>
    value_kind: Required
    group: Diff output format options
    description: generate diffstat with a given name width
    provenance:
      sources:
      - help-text
  - spellings:
    - --stat-graph-width
    value_name: <width>
    value_kind: Required
    group: Diff output format options
    description: generate diffstat with a given graph width
    provenance:
      sources:
      - help-text
  - spellings:
    - --stat-count
    value_name: <count>
    value_kind: Required
    group: Diff output format options
    description: generate diffstat with limited lines
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]compact-summary
    group: Diff output format options
    description: generate compact summary in diffstat
    provenance:
      sources:
      - help-text
  - spellings:
    - --binary
    group: Diff output format options
    description: output a binary diff that can be applied
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]full-index
    group: Diff output format options
    description: show full pre- and post-image object names on the "index" lines
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]color
    value_name: <when>
    value_kind: Optional
    group: Diff output format options
    description: show colored diff
    provenance:
      sources:
      - help-text
  - spellings:
    - --ws-error-highlight
    value_name: <kind>
    value_kind: Required
    group: Diff output format options
    description: highlight whitespace errors in the 'context', 'old' or 'new' lines in the diff
    provenance:
      sources:
      - help-text
  - spellings:
    - -z
    group: Diff output format options
    description: do not munge pathnames and use NULs as output field terminators in --raw or --numstat
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]abbrev
    value_name: <n>
    value_kind: Optional
    group: Diff output format options
    description: use <n> digits to display object names
    provenance:
      sources:
      - help-text
  - spellings:
    - --src-prefix
    value_name: <prefix>
    value_kind: Required
    group: Diff output format options
    description: show the given source prefix instead of "a/"
    provenance:
      sources:
      - help-text
  - spellings:
    - --dst-prefix
    value_name: <prefix>
    value_kind: Required
    group: Diff output format options
    description: show the given destination prefix instead of "b/"
    provenance:
      sources:
      - help-text
  - spellings:
    - --line-prefix
    value_name: <prefix>
    value_kind: Required
    group: Diff output format options
    description: prepend an additional prefix to every line of output
    provenance:
      sources:
      - help-text
  - spellings:
    - --no-prefix
    group: Diff output format options
    description: do not show any source or destination prefix
    provenance:
      sources:
      - help-text
  - spellings:
    - --default-prefix
    group: Diff output format options
    description: use default prefixes a/ and b/
    provenance:
      sources:
      - help-text
  - spellings:
    - --inter-hunk-context
    value_name: <n>
    value_kind: Required
    group: Diff output format options
    description: show context between diff hunks up to the specified number of lines
    provenance:
      sources:
      - help-text
  - spellings:
    - --output-indicator-new
    value_name: <char>
    value_kind: Required
    group: Diff output format options
    description: specify the character to indicate a new line instead of '+'
    provenance:
