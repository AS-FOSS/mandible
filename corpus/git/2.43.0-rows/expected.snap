- name: grep
  summary: Print lines matching a pattern
  usage:
  - 'usage: git grep [<options>] [-e] <pattern> [<rev>...] [[--] <path>...]'
  positionals:
  - name: pattern
    required: true
    provenance:
      sources:
      - help-text
  - name: rev
    variadic: true
    provenance:
      sources:
      - help-text
  - name: path
    required: true
    variadic: true
    provenance:
      sources:
      - help-text
  flags:
  - spellings:
    - --[no-]cached
    description: search in index instead of in the work tree
    provenance:
      sources:
      - help-text
  - spellings:
    - --no-index
    description: find in contents not managed by git
    provenance:
      sources:
      - help-text
  - spellings:
    - --index
    description: opposite of --no-index
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]untracked
    description: search in both tracked and untracked files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]exclude-standard
    description: ignore files specified via '.gitignore'
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]recurse-submodules
    description: recursively search in each submodule
    provenance:
      sources:
      - help-text
  - spellings:
    - -v
    - --[no-]invert-match
    description: show non-matching lines
    provenance:
      sources:
      - help-text
  - spellings:
    - -i
    - --[no-]ignore-case
    description: case insensitive matching
    provenance:
      sources:
      - help-text
  - spellings:
    - -w
    - --[no-]word-regexp
    description: match patterns only at word boundaries
    provenance:
      sources:
      - help-text
  - spellings:
    - -a
    - --[no-]text
    description: process binary files as text
    provenance:
      sources:
      - help-text
  - spellings:
    - -I
    description: don't match patterns in binary files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]textconv
    description: process binary files with textconv filters
    provenance:
      sources:
      - help-text
  - spellings:
    - -r
    - --[no-]recursive
    description: search in subdirectories (default)
    provenance:
      sources:
      - help-text
  - spellings:
    - --max-depth
    value_name: <n>
    value_kind: Required
    description: descend at most <n> levels
    provenance:
      sources:
      - help-text
  - spellings:
    - -E
    - --[no-]extended-regexp
    description: use extended POSIX regular expressions
    provenance:
      sources:
      - help-text
  - spellings:
    - -G
    - --[no-]basic-regexp
    description: use basic POSIX regular expressions (default)
    provenance:
      sources:
      - help-text
  - spellings:
    - -F
    - --[no-]fixed-strings
    description: interpret patterns as fixed strings
    provenance:
      sources:
      - help-text
  - spellings:
    - -P
    - --[no-]perl-regexp
    description: use Perl-compatible regular expressions
    provenance:
      sources:
      - help-text
  - spellings:
    - -n
    - --[no-]line-number
    description: show line numbers
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]column
    description: show column number of first match
    provenance:
      sources:
      - help-text
  - spellings:
    - -h
    description: don't show filenames
    provenance:
      sources:
      - help-text
  - spellings:
    - -H
    description: show filenames
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]full-name
    description: show filenames relative to top directory
    provenance:
      sources:
      - help-text
  - spellings:
    - -l
    - --[no-]files-with-matches
    description: show only filenames instead of matching lines
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]name-only
    description: synonym for --files-with-matches
    provenance:
      sources:
      - help-text
  - spellings:
    - -L
    - --[no-]files-without-match
    description: show only the names of files without match
    provenance:
      sources:
      - help-text
  - spellings:
    - -z
    - --[no-]null
    description: print NUL after filenames
    provenance:
      sources:
      - help-text
  - spellings:
    - -o
    - --[no-]only-matching
    description: show only matching parts of a line
    provenance:
      sources:
      - help-text
  - spellings:
    - -c
    - --[no-]count
    description: show the number of matches instead of matching lines
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]color
    value_name: <when>
    value_kind: Optional
    description: highlight matches
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]break
    description: print empty line between matches from different files
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]heading
    description: show filename only once above matches from same file
    provenance:
      sources:
      - help-text
  - spellings:
    - -C
    - --[no-]context
    value_name: <n>
    value_kind: Required
    description: show <n> context lines before and after matches
    provenance:
      sources:
      - help-text
  - spellings:
    - -B
    - --[no-]before-context
    value_name: <n>
    value_kind: Required
    description: show <n> context lines before matches
    provenance:
      sources:
      - help-text
  - spellings:
    - -A
    - --[no-]after-context
    value_name: <n>
    value_kind: Required
    description: show <n> context lines after matches
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]threads
    value_name: <n>
    value_kind: Required
    description: use <n> worker threads
    provenance:
      sources:
      - help-text
  - spellings:
    - -NUM
    description: shortcut for -C NUM
    provenance:
      sources:
      - help-text
  - spellings:
    - -p
    - --[no-]show-function
    description: show a line with the function name before matches
    provenance:
      sources:
      - help-text
  - spellings:
    - -W
    - --[no-]function-context
    description: show the surrounding function
    provenance:
      sources:
      - help-text
  - spellings:
    - -f
    value_name: <file>
    value_kind: Required
    description: read patterns from file
    provenance:
      sources:
      - help-text
  - spellings:
    - -e
    value_name: <pattern>
    value_kind: Required
    description: match <pattern>
    provenance:
      sources:
      - help-text
  - spellings:
    - --and
    description: combine patterns specified with -e
    provenance:
      sources:
      - help-text
  - spellings:
    - --or
    provenance:
      sources:
      - help-text
  - spellings:
    - --not
    provenance:
      sources:
      - help-text
  - spellings:
    - (
    provenance:
      sources:
      - help-text
  - spellings:
    - )
    provenance:
      sources:
      - help-text
  - spellings:
    - -q
    - --[no-]quiet
    description: indicate hit with exit status without output
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]all-match
    description: show only matches from files that match all patterns
    provenance:
      sources:
      - help-text
  - spellings:
    - -O
    - --[no-]open-files-in-pager
    value_name: <pager>
    value_kind: Optional
    description: show matching files in the pager
    provenance:
      sources:
      - help-text
  - spellings:
    - --[no-]ext-grep
    description: allow calling of grep(1) (ignored by this build)
    provenance:
      sources:
      - help-text
  - spellings:
    - -m
    - --[no-]max-count
    value_name: <n>
    value_kind: Required
    description: maximum number of results per file
    provenance:
      sources:
      - help-text
  group: 'examine the history and state (see also: git help revisions)'
  provenance:
    sources:
    - help-text
    confidence: 0.5
  children_filled: true
  heading_attested: true
