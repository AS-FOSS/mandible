      - help-text
    children_filled: true
    invocation_attested: true
  - name: bad
    usage:
    - git bisect (good|bad) [<rev>...]
    positionals:
    - name: rev
      variadic: true
      provenance:
        sources:
        - help-text
    provenance:
      sources:
      - help-text
    children_filled: true
    invocation_attested: true
  - name: terms
    usage:
    - git bisect terms [--term-good | --term-bad]
