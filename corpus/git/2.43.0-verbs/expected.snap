    sources:
    - help-text-synopsis
- spellings:
  - -c
  value_name: <name>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --exec-path
  value_name: <path>
  value_kind: Optional
