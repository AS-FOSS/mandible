name: git
usage:
- 'usage: git [-v | --version] [-h | --help] [-C <path>] [-c <name>=<value>] [--exec-path[=<path>]] [--html-path] [--man-path] [--info-path] [-p | --paginate | -P | --no-pager] [--no-replace-objects] [--bare] [--git-dir=<path>] [--work-tree=<path>] [--namespace=<name>] [--config-env=<name>=<envvar>] <command> [<args>]'
positionals:
- name: command
  required: true
  provenance:
    sources:
    - help-text
- name: args
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -v
  - --version
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -h
  - --help
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -C
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -c
  value_name: <name>=<value>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --exec-path
  value_name: <path>
  value_kind: Optional
  optional_join: equals
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --html-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --man-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --info-path
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -p
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --paginate
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -P
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --no-pager
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --no-replace-objects
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --bare
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --git-dir
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --work-tree
  value_name: <path>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --namespace
  value_name: <name>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - --config-env
  value_name: <name>=<envvar>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
subcommands:
- name: clone
  summary: Clone a repository into a new directory
  group: 'start a working area (see also: git help tutorial)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: init
  summary: Create an empty Git repository or reinitialize an existing one
  group: 'start a working area (see also: git help tutorial)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: add
  summary: Add file contents to the index
  group: 'work on the current change (see also: git help everyday)'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: mv
  summary: Move or rename a file, a directory, or a symlink
