name: btrfs
usage:
- 'usage: btrfs [global] <group> [<group>...] <command> [<args>]'
positionals:
- name: group
  provenance:
    sources:
    - help-text
- name: command
  required: true
  provenance:
    sources:
    - help-text
- name: args
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - --format
  value_name: <format>
  value_kind: Required
  group: 'Global options:'
  description: if supported, print subcommand output in that format (text, json)
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  group: 'Global options:'
  description: increase verbosity of the subcommand
  provenance:
    sources:
    - help-text
- spellings:
  - -q
  - --quiet
  group: 'Global options:'
  description: print only errors
  provenance:
    sources:
    - help-text
- spellings:
  - --log
  value_name: <level>
  value_kind: Required
  group: 'Global options:'
  description: set log level (default, info, verbose, debug, quiet)
  provenance:
    sources:
    - help-text
- spellings:
  - --dry-run
  group: 'Global options:'
  description: if supported, do not do any active/changing actions
  provenance:
    sources:
    - help-text
- spellings:
  - --help
  group: 'Options for the main command only:'
  description: print condensed help for all subcommands
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  group: 'Options for the main command only:'
  description: print version string
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
