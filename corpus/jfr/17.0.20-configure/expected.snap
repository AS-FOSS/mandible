name: jfr
description: |-
  Configures a .jfc file

  option=value The option value to modify. For available options, see listed input files below.

  event-setting=value The event setting value to modify. Use the form: <event-name>#<setting-name>=<value> To add a new event setting, prefix the event name with '+'.

  Options for default.jfc:

  gc=<off|normal|detailed|high|all>

  allocation-profiling=<off|low|medium|high|maximum>

  compiler=<off|normal|detailed|all>

  method-profiling=<off|normal|high|max>

  thread-dump=<off|once|60s|10s|1s>

  exceptions=<off|errors|all>

  memory-leaks=<off|types|stack-traces|gc-roots>

  locking-threshold=<timespan>

  file-threshold=<timespan>

  socket-threshold=<timespan>

  class-loading=<true|false>
usage:
- jfr configure [--interactive] [--verbose] [--input <files>] [--output <file>] [option=value]* [event-setting=value]*
flags:
- spellings:
  - --interactive
  description: Interactive mode where the configuration is determined by a set of questions.
  provenance:
    sources:
    - help-text
- spellings:
  - --verbose
  description: Displays the modified settings.
  provenance:
    sources:
    - help-text
- spellings:
  - --input
  value_name: <files>
  value_kind: Required
  description: A comma-separated list of .jfc files from which the new configuration is based. If no file is specified, the default file in the JDK is used (default.jfc). If 'none' is specified, the new configuration starts empty.
  provenance:
    sources:
    - help-text
- spellings:
  - --ouput
  value_name: <file>
  value_kind: Required
  description: The filename of the generated output file. If not specified, the filename custom.jfc will be used.
  provenance:
    sources:
    - help-text
- spellings:
  - --output
  value_name: <file>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.19
children_filled: true
