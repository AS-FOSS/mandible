name: jfr
description: Configures a .jfc file
usage:
- jfr configure [--interactive] [--verbose] [--input <files>] [--output <file>] [option=value]* [event-setting=value]*
positionals:
- name: option=value
  variadic: true
  description: The option value to modify. For available options, see listed input files below.
  provenance:
    sources:
    - help-text
- name: event-setting=value
  variadic: true
  description: 'The event setting value to modify. Use the form: <event-name>#<setting-name>=<value> To add a new event setting, prefix the event name with ''+''.'
  provenance:
    sources:
    - help-text
- name: gc
  provenance:
    sources:
    - help-text
- name: allocation-profiling
  provenance:
    sources:
    - help-text
- name: compiler
  provenance:
    sources:
    - help-text
- name: method-profiling
  provenance:
    sources:
    - help-text
- name: thread-dump
  provenance:
    sources:
    - help-text
- name: exceptions
  provenance:
    sources:
    - help-text
- name: memory-leaks
  provenance:
    sources:
    - help-text
- name: locking-threshold
  provenance:
