name: jfr
description: Configures a .jfc file
usage:
- jfr configure [--interactive] [--verbose] [--input <files>] [--output <file>] [option=value]* [event-setting=value]*
positionals:
- name: option=value
  variadic: true
  description: The option value to modify. For available options, see listed input files below.
  provenance:
    sources:
    - help-text
- name: event-setting=value
  variadic: true
  description: 'The event setting value to modify. Use the form: <event-name>#<setting-name>=<value> To add a new event setting, prefix the event name with ''+''.'
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - --interactive
  description: Interactive mode where the configuration is determined by a set of questions.
  provenance:
    sources:
    - help-text
- spellings:
  - --verbose
  description: Displays the modified settings.
  provenance:
    sources:
    - help-text
- spellings:
  - --input
  value_name: <files>
  value_kind: Required
  description: A comma-separated list of .jfc files from which the new configuration is based. If no file is specified, the default file in the JDK is used (default.jfc). If 'none' is specified, the new configuration starts empty.
  provenance:
    sources:
    - help-text
- spellings:
  - --ouput
  value_name: <file>
  value_kind: Required
  description: The filename of the generated output file. If not specified, the filename custom.jfc will be used.
  provenance:
    sources:
    - help-text
- spellings:
  - gc
  value_kind: Required
  choices:
  - off
  - normal
  - detailed
  - high
  - all
  group: 'Options for default.jfc:'
  provenance:
