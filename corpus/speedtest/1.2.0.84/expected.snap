name: speedtest
description: |-
  Speedtest by Ookla is the official command line client for testing the speed and performance of your internet connection.

  Version: speedtest 1.2.0.84
usage:
- 'Usage: speedtest [<options>]'
flags:
- spellings:
  - -h
  - --help
  description: Print usage information
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  description: Print version number
  provenance:
    sources:
    - help-text
- spellings:
  - -L
  - --servers
  description: List nearest servers
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --server-id
  value_name: '#'
  value_kind: Required
  description: Specify a server from the server list using its id
  provenance:
    sources:
    - help-text
- spellings:
  - -I
  - --interface
  value_name: ARG
  value_kind: Required
  description: Attempt to bind to the specified interface when connecting to servers
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  - --ip
  value_name: ARG
  value_kind: Required
  description: Attempt to bind to the specified IP address when connecting to servers
  provenance:
    sources:
    - help-text
- spellings:
  - -o
  - --host
  value_name: ARG
  value_kind: Required
  description: Specify a server, from the server list, using its host's fully qualified domain name
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --progress
  value_name: yes|no
  value_kind: Required
  description: 'Enable or disable progress bar (Note: only available for ''human-readable'' or ''json'' and defaults to yes when interactive)'
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  - --precision
  value_name: '#'
  value_kind: Required
  description: Number of decimals to use (0-8, default=2)
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  - --format
  value_name: ARG
  value_kind: Required
  choices:
  - name: human-readable
    description: (default)
  - csv
  - tsv
  - json
  - jsonl
  - json-pretty
  description: Output format (see below for valid formats) Machine readable formats (csv, tsv, json, jsonl, json-pretty) use bytes as the unit of measure with max precision
  provenance:
    sources:
    - help-text
- spellings:
  - --progress-update-interval
  value_name: '#'
  value_kind: Required
  description: Progress update interval (100-1000 milliseconds)
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  - --unit
  value_name: ARG
  value_kind: Optional
  optional_join: equals
  choices:
  - name: bps
    description: Decimal prefix, bits per second
  - name: kbps
    description: Decimal prefix, bits per second
  - name: Mbps
    description: Decimal prefix, bits per second
  - name: Gbps
    description: Decimal prefix, bits per second
  - name: B/s
    description: Decimal prefix, bytes per second
  - name: kB/s
    description: Decimal prefix, bytes per second
  - name: MB/s
    description: Decimal prefix, bytes per second
  - name: GB/s
    description: Decimal prefix, bytes per second
  - name: kibps
    description: Binary prefix, bits per second
  - name: Mibps
    description: Binary prefix, bits per second
  - name: Gibps
    description: Binary prefix, bits per second
  - name: kiB/s
    description: Binary prefix, bytes per second
  - name: MiB/s
    description: Binary prefix, bytes per second
  - name: GiB/s
    description: Binary prefix, bytes per second
  - name: auto-binary-bits
    description: Auto-scaled prefix
  - name: auto-binary-bytes
    description: Auto-scaled prefix
  - name: auto-decimal-bits
    description: Auto-scaled prefix
  - name: auto-decimal-bytes
    description: Auto-scaled prefix
  description: 'Output unit for displaying speeds (Note: this is only applicable for ‘human-readable’ output format and the default unit is Mbps)'
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  description: Shortcut for [-u auto-decimal-bits]
  provenance:
    sources:
    - help-text
- spellings:
  - -A
  description: Shortcut for [-u auto-decimal-bytes]
  provenance:
    sources:
    - help-text
- spellings:
  - -b
  description: Shortcut for [-u auto-binary-bits]
  provenance:
    sources:
    - help-text
- spellings:
  - -B
  description: Shortcut for [-u auto-binary-bytes]
  provenance:
    sources:
    - help-text
- spellings:
  - --selection-details
  description: Show server selection details
  provenance:
    sources:
    - help-text
- spellings:
  - --ca-certificate
  value_name: ARG
  value_kind: Required
  description: CA Certificate bundle path
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  description: Logging verbosity. Specify multiple times for higher verbosity
  provenance:
    sources:
    - help-text
- spellings:
  - --output-header
  description: Show output header for CSV and TSV formats
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
