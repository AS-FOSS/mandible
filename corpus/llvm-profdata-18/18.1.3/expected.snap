    sources:
    - help-text
- spellings:
  - --sve-tail-folding
  value_name: <string>
  value_kind: Required
  choices:
  - name: disabled
    description: (Initial) No loop types will vectorize using tail-folding
  - name: default
    description: (Initial) Uses the default tail-folding settings for the target CPU
  - name: all
    description: (Initial) All legal loop types will vectorize using tail-folding
  - name: simple
    description: (Initial) Use tail-folding for simple loops (not reductions or recurrences)
  - name: reductions
    description: Use tail-folding for loops containing reductions
  - name: noreductions
    description: Inverse of above
  - name: recurrences
    description: Use tail-folding for loops containing fixed order recurrences
  - name: reverse
    description: Use tail-folding for loops requiring reversed predicates
  - name: noreverse
    description: Inverse of above
  group: 'General options:'
  description: 'Control the use of vectorisation using tail-folding for SVE where the option is specified in the form (Initial)[+(Flag1|Flag2|...)]: norecurrences Inverse of above'
  provenance:
    sources:
    - help-text
- spellings:
  - --tail-predication
  value_name: <value>
