name: ffplay
description: Simple media player
usage:
- 'usage: ffplay [options] input_file'
flags:
- spellings:
  - -L
  description: show license
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - -?
  - -help
  - --help
  value_name: topic
  value_kind: Required
  description: show help
  provenance:
    sources:
    - help-text
- spellings:
  - -version
  description: show version
  provenance:
    sources:
    - help-text
- spellings:
  - -buildconf
  description: show build configuration
  provenance:
    sources:
    - help-text
- spellings:
  - -formats
  description: show available formats
  provenance:
    sources:
    - help-text
- spellings:
  - -muxers
  description: show available muxers
  provenance:
    sources:
    - help-text
- spellings:
  - -demuxers
  description: show available demuxers
  provenance:
    sources:
    - help-text
- spellings:
  - -devices
  description: show available devices
  provenance:
    sources:
    - help-text
- spellings:
  - -codecs
  description: show available codecs
  provenance:
    sources:
    - help-text
- spellings:
  - -decoders
  description: show available decoders
  provenance:
    sources:
    - help-text
- spellings:
  - -encoders
  description: show available encoders
  provenance:
    sources:
    - help-text
- spellings:
  - -bsfs
  description: show available bit stream filters
  provenance:
    sources:
    - help-text
- spellings:
  - -protocols
  description: show available protocols
  provenance:
    sources:
    - help-text
- spellings:
  - -filters
  description: show available filters
  provenance:
    sources:
    - help-text
- spellings:
  - -pix_fmts
  description: show available pixel formats
  provenance:
    sources:
    - help-text
- spellings:
  - -layouts
  description: show standard channel layouts
  provenance:
    sources:
    - help-text
- spellings:
  - -sample_fmts
  description: show available audio sample formats
  provenance:
    sources:
    - help-text
- spellings:
  - -dispositions
  description: show available stream dispositions
  provenance:
    sources:
    - help-text
- spellings:
  - -colors
  description: show available color names
  provenance:
    sources:
    - help-text
- spellings:
  - -loglevel
  - -v
  value_name: loglevel
  value_kind: Required
  description: set logging level
  provenance:
    sources:
    - help-text
- spellings:
  - -report
  description: generate a report
  provenance:
    sources:
    - help-text
- spellings:
  - -max_alloc
  description: set maximum size of a single allocated block
  provenance:
    sources:
    - help-text
- spellings:
  - -sources
  description: list sources of the input device
  provenance:
    sources:
    - help-text
- spellings:
  - -sinks
  description: list sinks of the output device
  provenance:
    sources:
    - help-text
- spellings:
  - -x
  value_name: width
  value_kind: Required
  description: force displayed width
  provenance:
    sources:
    - help-text
- spellings:
  - -y
  value_name: height
  value_kind: Required
  description: force displayed height
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  value_name: s
  value_kind: Required
  description: force full screen
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  value_name: n
  value_kind: Required
  description: disable audio
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  value_name: n
  value_kind: Required
  description: disable video
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  value_name: n
  value_kind: Required
  description: disable subtitling
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  value_name: s
  value_kind: Required
  description: seek to a given position in seconds
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  value_name: duration
  value_kind: Required
  description: play "duration" seconds of audio/video
  provenance:
    sources:
    - help-text
- spellings:
  - -bytes
  description: seek by bytes 0=off 1=on -1=auto
  provenance:
    sources:
    - help-text
- spellings:
  - -seek_interval
  description: set seek interval for left/right keys, in seconds
  provenance:
    sources:
    - help-text
- spellings:
  - -nodisp
  description: disable graphical display
  provenance:
    sources:
    - help-text
- spellings:
  - -noborder
  description: borderless window
  provenance:
    sources:
    - help-text
- spellings:
  - -alwaysontop
  description: window always on top
  provenance:
    sources:
    - help-text
- spellings:
  - -volume
  description: set startup volume 0=min 100=max
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  value_name: fmt
  value_kind: Required
  description: force format
  provenance:
    sources:
    - help-text
- spellings:
  - -window_title
  description: set window title
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  value_name: f
  value_kind: Required
  description: set audio filters
  provenance:
    sources:
    - help-text
- spellings:
  - -showmode
  description: select show mode (0 = video, 1 = waves, 2 = RDFT)
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  value_name: input_file
  value_kind: Required
  description: read specified file
  provenance:
    sources:
    - help-text
- spellings:
  - -codec
  description: force decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -autorotate
  description: automatically rotate video
  provenance:
    sources:
    - help-text
- spellings:
  - -cpuflags
  description: force specific cpu flags
  provenance:
    sources:
    - help-text
- spellings:
  - -cpucount
  description: force specific cpu count
  provenance:
    sources:
    - help-text
- spellings:
  - -hide_banner
  description: do not show program banner
  provenance:
    sources:
    - help-text
- spellings:
  - -ast
  description: select desired audio stream
  provenance:
    sources:
    - help-text
- spellings:
  - -vst
  description: select desired video stream
  provenance:
    sources:
    - help-text
- spellings:
  - -sst
  description: select desired subtitle stream
  provenance:
    sources:
    - help-text
- spellings:
  - -stats
  description: show status
  provenance:
    sources:
    - help-text
- spellings:
  - -fast
  description: non spec compliant optimizations
  provenance:
    sources:
    - help-text
- spellings:
  - -genpts
  description: generate pts
  provenance:
    sources:
    - help-text
- spellings:
  - -drp
  description: let decoder reorder pts 0=off 1=on -1=auto
  provenance:
    sources:
    - help-text
- spellings:
  - -lowres
  provenance:
    sources:
    - help-text
- spellings:
  - -sync
  description: set audio-video sync. type (type=audio/video/ext)
  provenance:
    sources:
    - help-text
- spellings:
  - -autoexit
  description: exit at the end
  provenance:
    sources:
    - help-text
- spellings:
  - -exitonkeydown
  description: exit on key down
  provenance:
    sources:
    - help-text
- spellings:
  - -exitonmousedown
  description: exit on mouse down
  provenance:
    sources:
    - help-text
- spellings:
  - -loop
  description: set number of times the playback shall be looped
  provenance:
    sources:
    - help-text
- spellings:
  - -framedrop
  description: drop frames when cpu is too slow
  provenance:
    sources:
    - help-text
- spellings:
  - -infbuf
  description: don't limit the input buffer size (useful with realtime streams)
  provenance:
    sources:
    - help-text
- spellings:
  - -left
  description: set the x position for the left of the window
  provenance:
    sources:
    - help-text
- spellings:
  - -top
  description: set the y position for the top of the window
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  value_name: f
  value_kind: Required
  description: set video filters
  provenance:
    sources:
    - help-text
- spellings:
  - -rdftspeed
  description: rdft speed
  provenance:
    sources:
    - help-text
- spellings:
  - -acodec
  description: force audio decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -scodec
  description: force subtitle decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -vcodec
  description: force video decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -find_stream_info
  description: read and decode the streams to fill missing information with heuristics
  provenance:
    sources:
    - help-text
- spellings:
  - -filter_threads
  description: number of filter threads per graph
  provenance:
    sources:
    - help-text
- spellings:
  - -flags
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VAS..... (default 0) unaligned .D.V....... allow decoders to produce unaligned output gray ED.V....... only decode/encode grayscale low_delay ED.V....... force low delay bitexact ED.VAS..... use only bitexact functions (except (I)DCT) output_corrupt .D.V....... Output even potentially corrupted frames drop_changed .D.VA.....P Drop frames whose parameters differ from first decoded frame
  provenance:
    sources:
    - help-text
- spellings:
  - -flags2
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VAS..... (default 0) ignorecrop .D.V....... ignore cropping information from sps chunks .D.V....... Frame data might be split into multiple chunks showall .D.V....... Show all frames before the first keyframe export_mvs .D.V....... export motion vectors through frame side data skip_manual .D..A...... do not skip samples and export skip information as frame side data ass_ro_flush_noop .D...S..... do not reset ASS ReadOrder field on flush icc_profiles .D...S..... generate/parse embedded ICC profiles from/to colorimetry tags
  provenance:
    sources:
    - help-text
- spellings:
  - -export_side_data
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VAS..... Export metadata as side data (default 0) mvs .D.V....... export motion vectors through frame side data venc_params .D.V....... export video encoding parameters through frame side data film_grain .D.V....... export film grain parameters through frame side data
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  value_name: r
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: <int> ED..A...... set audio sampling rate (in Hz) (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  value_name: c
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: <int> ED..A...... set number of audio channels (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -bug
  group: 'AVCodecContext AVOptions:'
  description: <flags> .D.V....... work around not autodetected encoder bugs (default autodetect) autodetect .D.V....... xvid_ilace .D.V....... Xvid interlacing bug (autodetected if FOURCC == XVIX) ump4 .D.V....... (autodetected if FOURCC == UMP4) no_padding .D.V....... padding bug (autodetected) amv .D.V....... qpel_chroma .D.V....... std_qpel .D.V....... old standard qpel (autodetected per FOURCC/version) qpel_chroma2 .D.V....... direct_blocksize .D.V....... direct-qpel-blocksize bug (autodetected per FOURCC/version) edge .D.V....... edge padding bug (autodetected per FOURCC/version) hpel_chroma .D.V....... dc_clip .D.V....... ms .D.V....... work around various bugs in Microsoft's broken decoders trunc .D.V....... truncated frames iedge .D.V.......
  provenance:
    sources:
    - help-text
- spellings:
  - -strict
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.VA...... how strictly to follow the standards (from INT_MIN to INT_MAX) (default normal) very 2 ED.VA...... strictly conform to a older more strict version of the spec or reference software strict 1 ED.VA...... strictly conform to all the things in the spec no matter what the consequences normal 0 ED.VA...... unofficial -1 ED.VA...... allow unofficial extensions experimental -2 ED.VA...... allow non-standardized experimental things
  provenance:
    sources:
    - help-text
- spellings:
  - -err_detect
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VAS..... set error detection flags (default 0) crccheck ED.VAS..... verify embedded CRCs bitstream ED.VAS..... detect bitstream specification deviations buffer ED.VAS..... detect improper bitstream length explode ED.VAS..... abort decoding on minor error detection ignore_err ED.VAS..... ignore errors careful ED.VAS..... consider things that violate the spec, are fast to check and have not been seen in the wild as errors compliant ED.VAS..... consider all spec non compliancies as errors aggressive ED.VAS..... consider things that a sane encoder should not do as an error
  provenance:
    sources:
    - help-text
- spellings:
  - -idct
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.V....... select IDCT implementation (from 0 to INT_MAX) (default auto) auto 0 ED.V....... int 1 ED.V....... simple 2 ED.V....... simplemmx 3 ED.V....... arm 7 ED.V....... altivec 8 ED.V....... simplearm 10 ED.V....... simplearmv5te 16 ED.V....... simplearmv6 17 ED.V....... simpleneon 22 ED.V....... xvid 14 ED.V....... xvidmmx 14 ED.V....... deprecated, for compatibility only faani 20 ED.V....... floating point AAN IDCT simpleauto 128 ED.V.......
  provenance:
    sources:
    - help-text
- spellings:
  - -e
  value_name: c
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: <flags> .D.V....... set error concealment strategy (default guess_mvs+deblock) guess_mvs .D.V....... iterative motion vector (MV) search (slow) deblock .D.V....... use strong deblock filter for damaged MBs favor_inter .D.V....... favor predicting from the previous frame
  provenance:
    sources:
    - help-text
- spellings:
  - -debug
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VAS..... print specific debug info (default 0) pict .D.V....... picture info bitstream .D.V....... mb_type .D.V....... macroblock (MB) type qp .D.V....... per-block quantization parameter (QP) dct_coeff .D.V....... green_metadata .D.V....... skip .D.V....... startcode .D.V....... er .D.V....... error recognition mmco .D.V....... memory management control operations (H.264) bugs .D.V....... buffers .D.V....... picture buffer allocations thread_ops .D.VA...... threading operations nomc .D.VA...... skip motion compensation
  provenance:
    sources:
    - help-text
- spellings:
  - -threads
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.VA...... set the number of threads (from 0 to INT_MAX) (default 1) auto 0 ED.V....... autodetect a suitable number of threads to use
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_top
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.V....... number of macroblock rows at the top which are skipped (from INT_MIN to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_bottom
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.V....... number of macroblock rows at the bottom which are skipped (from INT_MIN to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -lowres
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.VA...... decode at 1= 1/2, 2=1/4, 3=1/8 resolutions (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_loop_filter
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.V....... skip loop filtering process for the selected frames (from INT_MIN to INT_MAX) (default default) none -16 .D.V....... discard no frame default 0 .D.V....... discard useless frames noref 8 .D.V....... discard all non-reference frames bidir 16 .D.V....... discard all bidirectional frames nointra 24 .D.V....... discard all frames except I frames nokey 32 .D.V....... discard all frames except keyframes all 48 .D.V....... discard all frames
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_idct
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.V....... skip IDCT/dequantization for the selected frames (from INT_MIN to INT_MAX) (default default) none -16 .D.V....... discard no frame default 0 .D.V....... discard useless frames noref 8 .D.V....... discard all non-reference frames bidir 16 .D.V....... discard all bidirectional frames nointra 24 .D.V....... discard all frames except I frames nokey 32 .D.V....... discard all frames except keyframes all 48 .D.V....... discard all frames
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_frame
  group: 'AVCodecContext AVOptions:'
  description: <int> .D.V....... skip decoding for the selected frames (from INT_MIN to INT_MAX) (default default) none -16 .D.V....... discard no frame default 0 .D.V....... discard useless frames noref 8 .D.V....... discard all non-reference frames bidir 16 .D.V....... discard all bidirectional frames nointra 24 .D.V....... discard all frames except I frames nokey 32 .D.V....... discard all frames except keyframes all 48 .D.V....... discard all frames
  provenance:
    sources:
    - help-text
- spellings:
  - -ch_layout
  group: 'AVCodecContext AVOptions:'
  description: <channel_layout> ED..A......
  provenance:
    sources:
    - help-text
- spellings:
  - -channel_layout
  group: 'AVCodecContext AVOptions:'
  description: <channel_layout> ED..A...... (default 0x0)
  provenance:
    sources:
    - help-text
- spellings:
  - -request_channel_layout
  group: 'AVCodecContext AVOptions:'
  description: .D..A...... (default 0x0)
  provenance:
    sources:
    - help-text
- spellings:
  - -ticks_per_frame
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.VA...... (from 1 to INT_MAX) (default 1)
  provenance:
    sources:
    - help-text
- spellings:
  - -color_primaries
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.V....... color primaries (from 1 to INT_MAX) (default unknown) bt709 1 ED.V....... BT.709 unknown 2 ED.V....... Unspecified bt470m 4 ED.V....... BT.470 M bt470bg 5 ED.V....... BT.470 BG smpte170m 6 ED.V....... SMPTE 170 M smpte240m 7 ED.V....... SMPTE 240 M film 8 ED.V....... Film bt2020 9 ED.V....... BT.2020 smpte428 10 ED.V....... SMPTE 428-1 smpte428_1 10 ED.V....... SMPTE 428-1 smpte431 11 ED.V....... SMPTE 431-2 smpte432 12 ED.V....... SMPTE 422-1 jedec-p22 22 ED.V....... JEDEC P22 ebu3213 22 ED.V....... EBU 3213-E unspecified 2 ED.V....... Unspecified
  provenance:
    sources:
    - help-text
- spellings:
  - -color_trc
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.V....... color transfer characteristics (from 1 to INT_MAX) (default unknown) bt709 1 ED.V....... BT.709 unknown 2 ED.V....... Unspecified gamma22 4 ED.V....... BT.470 M gamma28 5 ED.V....... BT.470 BG smpte170m 6 ED.V....... SMPTE 170 M smpte240m 7 ED.V....... SMPTE 240 M linear 8 ED.V....... Linear log100 9 ED.V....... Log log316 10 ED.V....... Log square root iec61966-2-4 11 ED.V....... IEC 61966-2-4 bt1361e 12 ED.V....... BT.1361 iec61966-2-1 13 ED.V....... IEC 61966-2-1 bt2020-10 14 ED.V....... BT.2020 - 10 bit bt2020-12 15 ED.V....... BT.2020 - 12 bit smpte2084 16 ED.V....... SMPTE 2084 smpte428 17 ED.V....... SMPTE 428-1 arib-std-b67 18 ED.V....... ARIB STD-B67 unspecified 2 ED.V....... Unspecified log 9 ED.V....... Log log_sqrt 10 ED.V....... Log square root iec61966_2_4 11 ED.V....... IEC 61966-2-4 bt1361 12 ED.V....... BT.1361 iec61966_2_1 13 ED.V....... IEC 61966-2-1 bt2020_10bit 14 ED.V....... BT.2020 - 10 bit bt2020_12bit 15 ED.V....... BT.2020 - 12 bit smpte428_1 17 ED.V....... SMPTE 428-1
  provenance:
    sources:
    - help-text
- spellings:
  - -colorspace
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.V....... color space (from 0 to INT_MAX) (default unknown) rgb 0 ED.V....... RGB bt709 1 ED.V....... BT.709 unknown 2 ED.V....... Unspecified fcc 4 ED.V....... FCC bt470bg 5 ED.V....... BT.470 BG smpte170m 6 ED.V....... SMPTE 170 M smpte240m 7 ED.V....... SMPTE 240 M ycgco 8 ED.V....... YCGCO bt2020nc 9 ED.V....... BT.2020 NCL bt2020c 10 ED.V....... BT.2020 CL smpte2085 11 ED.V....... SMPTE 2085 chroma-derived-nc 12 ED.V....... Chroma-derived NCL chroma-derived-c 13 ED.V....... Chroma-derived CL ictcp 14 ED.V....... ICtCp unspecified 2 ED.V....... Unspecified ycocg 8 ED.V....... YCGCO bt2020_ncl 9 ED.V....... BT.2020 NCL bt2020_cl 10 ED.V....... BT.2020 CL
  provenance:
    sources:
    - help-text
- spellings:
  - -color_range
  group: 'AVCodecContext AVOptions:'
  description: <int> ED.V....... color range (from 0 to INT_MAX) (default unknown) unknown 0 ED.V....... Unspecified tv 1 ED.V....... MPEG (219*2^(n-8)) pc 2 ED.V....... JPEG (2^n-1) unspecified 0 ED.V....... Unspecified mpeg 1 ED.V....... MPEG (219*2^(n-8)) jpeg 2 ED.V....... JPEG (2^n-1) limited 1 ED.V....... MPEG (219*2^(n-8)) full 2 ED.V....... JPEG (2^n-1)
  provenance:
    sources:
    - help-text
- spellings:
  - -chroma_sample_location
  group: 'AVCodecContext AVOptions:'
  description: ED.V....... chroma sample location (from 0 to INT_MAX) (default unknown) unknown 0 ED.V....... Unspecified left 1 ED.V....... Left center 2 ED.V....... Center topleft 3 ED.V....... Top-left top 4 ED.V....... Top bottomleft 5 ED.V....... Bottom-left bottom 6 ED.V....... Bottom unspecified 0 ED.V....... Unspecified
  provenance:
    sources:
    - help-text
- spellings:
  - -thread_type
  group: 'AVCodecContext AVOptions:'
  description: <flags> ED.VA...... select multithreading type (default slice+frame) slice ED.V....... frame ED.V.......
  provenance:
    sources:
    - help-text
- spellings:
  - -request_sample_fmt
  group: 'AVCodecContext AVOptions:'
  description: .D..A...... sample format audio decoders should prefer (default none)
  provenance:
    sources:
    - help-text
- spellings:
  - -sub_charenc
  group: 'AVCodecContext AVOptions:'
  description: <string> .D...S..... set input text subtitles character encoding
  provenance:
    sources:
    - help-text
- spellings:
  - -sub_charenc_mode
  group: 'AVCodecContext AVOptions:'
  description: <flags> .D...S..... set input text subtitles character encoding mode (default 0) do_nothing .D...S..... auto .D...S..... pre_decoder .D...S..... ignore .D...S.....
  provenance:
    sources:
    - help-text
- spellings:
  - -apply_cropping
  group: 'AVCodecContext AVOptions:'
  description: <boolean> .D.V....... (default true)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_alpha
  group: 'AVCodecContext AVOptions:'
  description: <boolean> .D.V....... Skip processing alpha (default false)
  provenance:
    sources:
    - help-text
- spellings:
