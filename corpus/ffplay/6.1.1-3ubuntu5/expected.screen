Libplacebo AVOptions ───────────────────────────────────────────────────────
    inputs int           Number of inputs (from 1 to INT_MAX) (default 1)
w string                 Output video frame width (default "iw")
h string                 Output video frame height (default "ih")
    fps string           Output video frame rate (default "none")
    crop_x string        Input video crop x (default "(iw-cw)/2")
    crop_y string        Input video crop y (default "(ih-ch)/2")
    crop_w string        Input video crop w (default "iw")
    crop_h string        Input video crop h (default "ih")
    pos_x string         Output video placement x (default "(ow-pw)/2")
    pos_y string         Output video placement y (default "(oh-ph)/2")
    pos_w string         Output video placement w (default "ow")
    pos_h string         Output video placement h (default "oh")
    format string        Output video format
    force_original_aspect_ratio int decrease or increase w/h if necessary to
                         keep the original AR (from 0 to 2) (default
                         disable)
                           values:
                             disable   0 ..FV.......
                             decrease  1 ..FV.......
                             increase  2 ..FV.......
    force_divisible_by int enforce that the output resolution is divisible
                         by a defined integer when
                         force_original_aspect_ratio is used (from 1 to 256)
                         (default 1)
    normalize_sar boolean force SAR normalization to 1:1 by adjusting
                         pos_x/y/w/h (default false)
    pad_crop_ratio float ratio between padding and cropping when normalizing
                         SAR (0=pad, 1=crop) (from 0 to 1) (default 0)
    fillcolor string     Background fill color (default "black")
    corner_rounding float Corner rounding radius (from 0 to 1) (default 0)
    extra_opts dictionary Pass extra libplacebo-specific options using a
                         :-separated list of key=value pairs
    colorspace int       select colorspace (from -1 to 14) (default auto)
                           values:
                             auto       -1 ..FV....... keep the same
                                        colorspace
                             gbr        0 ..FV.......
                             bt709      1 ..FV.......
                             unknown    2 ..FV.......
                             bt470bg    5 ..FV.......
                             smpte170m  6 ..FV.......
                             smpte240m  7 ..FV.......
                             ycgco      8 ..FV.......
                             bt2020nc   9 ..FV.......
                             bt2020c    10 ..FV.......
                             ictcp      14 ..FV.......
    range int            select color range (from -1 to 2) (default auto)
                           values:
                             auto         -1 ..FV....... keep the same color
                                          range
                             unspecified  0 ..FV.......
                             unknown      0 ..FV.......
                             limited      1 ..FV.......
                             tv           1 ..FV.......
                             mpeg         1 ..FV.......
                             full         2 ..FV.......
                             pc           2 ..FV.......
                             jpeg         2 ..FV.......
    color_primaries int  select color primaries (from -1 to 22) (default
                         auto)
                           values:
                             auto       -1 ..FV....... keep the same color
                                        primaries
                             bt709      1 ..FV.......
                             unknown    2 ..FV.......
                             bt470m     4 ..FV.......
                             bt470bg    5 ..FV.......
                             smpte170m  6 ..FV.......
                             smpte240m  7 ..FV.......
                             film       8 ..FV.......
                             bt2020     9 ..FV.......
                             smpte428   10 ..FV.......
                             smpte431   11 ..FV.......
                             smpte432   12 ..FV.......
                             jedec-p22  22 ..FV.......
                             ebu3213    22 ..FV.......
    color_trc int        select color transfer (from -1 to 18) (default
                         auto)
                           values:
                             auto          -1 ..FV....... keep the same
                                           color transfer
                             bt709         1 ..FV.......
                             unknown       2 ..FV.......
                             bt470m        4 ..FV.......
                             bt470bg       5 ..FV.......
                             smpte170m     6 ..FV.......
                             smpte240m     7 ..FV.......
                             linear        8 ..FV.......
                             iec61966-2-4  11 ..FV.......
                             bt1361e       12 ..FV.......
                             iec61966-2-1  13 ..FV.......
                             bt2020-10     14 ..FV.......
                             bt2020-12     15 ..FV.......
                             smpte2084     16 ..FV.......
                             arib-std-b67  18 ..FV.......
    upscaler string      Upscaler function (default "spline36")
    downscaler string    Downscaler function (default "mitchell")
    frame_mixer string   Frame mixing function (default "none")
    lut_entries int      Number of scaler LUT entries (from 0 to 256)
                         (default 0)
    antiringing float    Antiringing strength (for non-EWA filters) (from 0
                         to 1) (default 0)
    sigmoid boolean      Enable sigmoid upscaling (default true)
    apply_filmgrain boolean Apply film grain metadata (default true)
    apply_dolbyvision boolean Apply Dolby Vision metadata (default true)
    deband boolean       Enable debanding (default false)
    deband_iterations int Deband iterations (from 0 to 16) (default 1)
    deband_threshold float Deband threshold (from 0 to 1024) (default 4)
    deband_radius float  Deband radius (from 0 to 1024) (default 16)
    deband_grain float   Deband grain (from 0 to 1024) (default 6)
    brightness float     Brightness boost (from -1 to 1) (default 0)
    contrast float       Contrast gain (from 0 to 16) (default 1)
    saturation float     Saturation gain (from 0 to 16) (default 1)
    hue float            Hue shift (from -3.14159 to 3.14159) (default 0)
    gamma float          Gamma adjustment (from 0 to 16) (default 1)
    peak_detect boolean  Enable dynamic peak detection for HDR tone-mapping
                         (default true)
    smoothing_period float Peak detection smoothing period (from 0 to 1000)
                         (default 100)
    minimum_peak float   Peak detection minimum peak (from 0 to 100)
                         (default 1)
    scene_threshold_low float Scene change low threshold (from -1 to 100)
                         (default 5.5)
    scene_threshold_high float Scene change high threshold (from -1 to 100)
                         (default 10)
    percentile float     Peak detection percentile (from 0 to 100) (default
                         99.995)
    gamut_mode int       Gamut-mapping mode (from 0 to 8) (default
                         perceptual)
                           values:
                             clip        0 ..FV....... Hard-clip (RGB
                                         per-channel)
                             perceptual  1 ..FV....... Colorimetric soft
                                         clipping
                             relative    2 ..FV....... Relative colorimetric
                                         clipping
                             saturation  3 ..FV....... Saturation mapping
                                         (RGB -> RGB)
                             absolute    4 ..FV....... Absolute colorimetric
                                         clipping
                             desaturate  5 ..FV....... Colorimetrically
                                         desaturate colors towards white
                             darken      6 ..FV....... Colorimetric clip
                                         with bias towards darkening image
                                         to fit gamut
                             warn        7 ..FV....... Highlight
                                         out-of-gamut colors
                             linear      8 ..FV....... Linearly reduce
                                         chromaticity to fit gamut
    tonemapping int      Tone-mapping algorithm (from 0 to 11) (default
                         auto)
                           values:
                             auto       0 ..FV....... Automatic selection
                             clip       1 ..FV....... No tone mapping (clip
                             st2094-40  2 ..FV....... SMPTE ST 2094-40
                             st2094-10  3 ..FV....... SMPTE ST 2094-10
                             bt.2390    4 ..FV....... ITU-R BT.2390 EETF
                             bt.2446a   5 ..FV....... ITU-R BT.2446 Method A
                             spline     6 ..FV....... Single-pivot
                                        polynomial spline
                             reinhard   7 ..FV....... Reinhard
                             mobius     8 ..FV....... Mobius
                             hable      9 ..FV....... Filmic tone-mapping
                                        (Hable)
                             gamma      10 ..FV....... Gamma function with
                                        knee
                             linear     11 ..FV....... Perceptually linear
                                        stretch
    tonemapping_param float Tunable parameter for some tone-mapping
                         functions (from 0 to 100) (default 0)
    inverse_tonemapping boolean Inverse tone mapping (range expansion)
                         (default false)
    tonemapping_lut_size int Tone-mapping LUT size (from 2 to 1024) (default
                         256)
    contrast_recovery float HDR contrast recovery strength (from 0 to 3)
                         (default 0.3)
    contrast_smoothness float HDR contrast recovery smoothness (from 1 to
                         32) (default 3.5)
    desaturation_strength float Desaturation strength (from -1 to 1)
                         (default -1)
    desaturation_exponent float Desaturation exponent (from -1 to 10)
                         (default -1)
    gamut_warning boolean Highlight out-of-gamut colors (default false)
    gamut_clipping boolean Enable desaturating colorimetric gamut clipping
                         (default false)
    intent int           Rendering intent (from 0 to 3) (default perceptual)
                           values:
                             perceptual  0 ..FV....... Perceptual
                             relative    1 ..FV....... Relative colorimetric
                             absolute    3 ..FV....... Absolute colorimetric
                             saturation  2 ..FV....... Saturation mapping
    tonemapping_mode int Tone-mapping mode (from 0 to 4) (default auto)
                           values:
                             auto    0 ..FV....... Automatic selection
                             rgb     1 ..FV....... Per-channel (RGB)
                             max     2 ..FV....... Maximum component
                             hybrid  3 ..FV....... Hybrid of Luma/RGB
                             luma    4 ..FV....... Luminance
    tonemapping_crosstalk float Crosstalk factor for tone-mapping (from 0 to
                         0.3) (default 0.04)
    overshoot float      Tone-mapping overshoot margin (from 0 to 1)
                         (default 0.05)
    hybrid_mix float     Tone-mapping hybrid LMS mixing coefficient (from 0
                         to 1) (default 0.2)
    dithering int        Dither method to use (from -1 to 3) (default blue)
                           values:
                             none           -1 ..FV....... Disable dithering
                             blue           0 ..FV....... Blue noise
                             ordered        1 ..FV....... Ordered LUT
                             ordered_fixed  2 ..FV....... Fixed function
                                            ordered
                             white          3 ..FV....... White noise
    dither_lut_size int  Dithering LUT size (from 1 to 8) (default 6)
    dither_temporal boolean Enable temporal dithering (default false)
    cones flags          Colorblindness adaptation model (default 0)
                           values:
                             l  ..FV....... L cone
                             m  ..FV....... M cone
                             s  ..FV....... S cone
    cone-strength float  Colorblindness adaptation strength (from 0 to 10)
                         (default 0)
    custom_shader_path string Path to custom user shader (mpv .hook format)
    custom_shader_bin binary Custom user shader as binary (mpv .hook format)
    skip_aa boolean      Skip anti-aliasing (default false)
    polar_cutoff float   Polar LUT cutoff (from 0 to 1) (default 0)
    disable_linear boolean Disable linear scaling (default false)
    disable_builtin boolean Disable built-in scalers (default false)
    force_icc_lut boolean Deprecated, does nothing (default false)
    force_dither boolean Force dithering (default false)
    disable_fbos boolean Force-disable FBOs (default false)

