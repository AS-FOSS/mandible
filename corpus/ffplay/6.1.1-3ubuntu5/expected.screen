Hstack_vaapi AVOptions ─────────────────────────────────────────────────────
    inputs int           Set number of inputs (from 2 to 65535) (default 2)
    shortest boolean     Force termination when the shortest input
                         terminates (default false)
    height int           Set output height (0 to use the height of input 0)
                         (from 0 to 65535) (default 0)

Vstack_vaapi AVOptions ─────────────────────────────────────────────────────
    inputs int           Set number of inputs (from 2 to 65535) (default 2)
    shortest boolean     Force termination when the shortest input
                         terminates (default false)
    width int            Set output width (0 to use the width of input 0)
                         (from 0 to 65535) (default 0)

Xstack_vaapi AVOptions ─────────────────────────────────────────────────────
    inputs int           Set number of inputs (from 2 to 65535) (default 2)
    shortest boolean     Force termination when the shortest input
                         terminates (default false)
    layout string        Set custom layout
    grid image_size      set fixed size grid layout
    grid_tile_size image_size set tile size in grid layout
    fill string          Set the color for unused pixels (default "none")

Allyuv/allrgb AVOptions ────────────────────────────────────────────────────
    rate video_rate      set video rate (default "25")
r video_rate             set video rate (default "25")
    duration duration    set video duration (default -0.000001)
d duration               set video duration (default -0.000001)
    sar rational         set video sample aspect ratio (from 0 to INT_MAX)
                         (default 1/1)

Cellauto AVOptions ─────────────────────────────────────────────────────────
    filename string      read initial pattern from file
f string                 read initial pattern from file
    pattern string       set initial pattern
p string                 set initial pattern
    rate video_rate      set video rate (default "25")
r video_rate             set video rate (default "25")
    size image_size      set video size
s image_size             set video size
    rule int             set rule (from 0 to 255) (default 110)
    random_fill_ratio double set fill ratio for filling initial grid
                         randomly (from 0 to 1) (default 0.618034)
    ratio double         set fill ratio for filling initial grid randomly
                         (from 0 to 1) (default 0.618034)
    random_seed int64    set the seed for filling the initial grid randomly
                         (from -1 to UINT32_MAX) (default -1)
    seed int64           set the seed for filling the initial grid randomly
                         (from -1 to UINT32_MAX) (default -1)
    scroll boolean       scroll pattern downward (default true)
    start_full boolean   start filling the whole video (default false)
    full boolean         start filling the whole video (default true)
    stitch boolean       stitch boundaries (default true)

