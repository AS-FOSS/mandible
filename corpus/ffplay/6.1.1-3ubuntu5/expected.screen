                         (default 1)
    c2_opacity double    set color component #2 opacity (from 0 to 1)
                         (default 1)
    c3_opacity double    set color component #3 opacity (from 0 to 1)
                         (default 1)
    all_opacity double   set opacity for all color components (from 0 to 1)
                         (default 1)

