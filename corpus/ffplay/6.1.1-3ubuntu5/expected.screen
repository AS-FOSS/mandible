                         1 to INT_MAX) (default 1024)
    hp float             set high-pass filter frequency (from 0 to INT_MAX)
                         (default 0)
    lp float             set low-pass filter frequency (from 0 to INT_MAX)
                         (default 0)
    phase float          set filter phase response (from 0 to 100) (default
                         50)
    beta float           set kaiser window beta (from -1 to 256) (default
                         -1)
    att float            set stop-band attenuation (from 40 to 180) (default
                         120)
    round boolean        enable rounding (default false)
    hptaps int           set number of taps for high-pass filter (from 0 to
                         32768) (default 0)
    lptaps int           set number of taps for low-pass filter (from 0 to
                         32768) (default 0)

