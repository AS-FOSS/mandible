  value_name: int
  value_kind: Required
  choices:
  - name: default
    description: 0 ..FV....... Frame from secondary input with the nearest lower or equal timestamp to the primary input frame
  - name: nearest
    description: 1 ..FV....... Frame from secondary input with the absolute nearest timestamp to the primary input frame
  group: 'framesync AVOptions:'
  description: How strictly to sync streams based on secondary input timestamps (from 0 to 1) (default default)
