- spellings:
  - mode
  value_name: int
  value_kind: Required
  choices:
  - name: pc
    description: 0 ..FV....... 2-way match (p/c)
  - name: pc_n
    description: 1 ..FV....... 2-way match + 3rd match on combed (p/c + u)
  - name: pc_u
    description: 2 ..FV....... 2-way match + 3rd match (same order) on combed (p/c + u)
  - name: pc_n_ub
    description: 3 ..FV....... 2-way match + 3rd match on combed + 4th/5th matches if still combed (p/c + u + u/b)
  - name: pcn
    description: 4 ..FV....... 3-way match (p/c/n)
  - name: pcn_ub
    description: 5 ..FV....... 3-way match + 4th/5th matches on combed (p/c/n + u/b)
  group: 'fieldmatch AVOptions:'
  description: set the matching mode or strategy to use (from 0 to 5) (default pc_n)
  provenance:
    sources:
    - help-text
