  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfurl
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL of the SWF player. By default no value will be sent
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfverify
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL to player swf file, compute hash/size automatically.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_tcurl
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL of the target stream. Defaults to proto://host[:port]/app.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_listen
  value_name: int
  value_kind: Required
  group: 'rtmp AVOptions:'
