  provenance:
    sources:
    - help-text
- spellings:
  - -nodisp
  group: 'Main options:'
  description: disable graphical display
  provenance:
    sources:
    - help-text
- spellings:
  - -noborder
  group: 'Main options:'
  description: borderless window
  provenance:
    sources:
    - help-text
- spellings:
  - -alwaysontop
  group: 'Main options:'
  description: window always on top
  provenance:
    sources:
    - help-text
- spellings:
  - -volume
  value_name: volume
  value_kind: Required
  group: 'Main options:'
  description: set startup volume 0=min 100=max
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  value_name: fmt
  value_kind: Required
  group: 'Main options:'
  description: force format
  provenance:
    sources:
    - help-text
- spellings:
  - -window_title
  value_name: window title
  value_kind: Required
  group: 'Main options:'
  description: set window title
  provenance:
    sources:
    - help-text
- spellings:
  - -af
  value_name: filter_graph
  value_kind: Required
  group: 'Main options:'
  description: set audio filters
  provenance:
    sources:
    - help-text
- spellings:
  - -showmode
  value_name: mode
  value_kind: Required
  group: 'Main options:'
  description: select show mode (0 = video, 1 = waves, 2 = RDFT)
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  value_name: input_file
  value_kind: Required
  group: 'Main options:'
  description: read specified file
  provenance:
    sources:
    - help-text
- spellings:
  - -codec
  value_name: decoder_name
  value_kind: Required
  group: 'Main options:'
  description: force decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -autorotate
  group: 'Main options:'
  description: automatically rotate video
  provenance:
    sources:
    - help-text
- spellings:
  - -cpuflags
  value_name: flags
  value_kind: Required
  group: 'Advanced options:'
  description: force specific cpu flags
  provenance:
    sources:
    - help-text
- spellings:
  - -cpucount
  value_name: count
  value_kind: Required
  group: 'Advanced options:'
  description: force specific cpu count
  provenance:
    sources:
    - help-text
- spellings:
  - -hide_banner
  value_name: hide_banner
  value_kind: Required
  group: 'Advanced options:'
  description: do not show program banner
  provenance:
    sources:
    - help-text
- spellings:
  - -ast
  value_name: stream_specifier
  value_kind: Required
  group: 'Advanced options:'
  description: select desired audio stream
  provenance:
    sources:
    - help-text
- spellings:
  - -vst
  value_name: stream_specifier
  value_kind: Required
  group: 'Advanced options:'
  description: select desired video stream
  provenance:
    sources:
    - help-text
- spellings:
  - -sst
  value_name: stream_specifier
  value_kind: Required
  group: 'Advanced options:'
  description: select desired subtitle stream
  provenance:
    sources:
    - help-text
- spellings:
  - -stats
  group: 'Advanced options:'
  description: show status
  provenance:
    sources:
    - help-text
- spellings:
  - -fast
  group: 'Advanced options:'
  description: non spec compliant optimizations
  provenance:
    sources:
    - help-text
- spellings:
  - -genpts
  group: 'Advanced options:'
  description: generate pts
  provenance:
    sources:
    - help-text
- spellings:
  - -drp
  group: 'Advanced options:'
  description: let decoder reorder pts 0=off 1=on -1=auto
  provenance:
    sources:
    - help-text
- spellings:
  - -lowres
  group: 'Advanced options:'
  provenance:
    sources:
    - help-text
- spellings:
  - -sync
  value_name: type
  value_kind: Required
  group: 'Advanced options:'
  description: set audio-video sync. type (type=audio/video/ext)
  provenance:
    sources:
    - help-text
- spellings:
  - -autoexit
  group: 'Advanced options:'
  description: exit at the end
  provenance:
    sources:
    - help-text
- spellings:
  - -exitonkeydown
  group: 'Advanced options:'
  description: exit on key down
  provenance:
    sources:
    - help-text
- spellings:
  - -exitonmousedown
  group: 'Advanced options:'
  description: exit on mouse down
  provenance:
    sources:
    - help-text
- spellings:
  - -loop
  value_name: loop count
  value_kind: Required
  group: 'Advanced options:'
  description: set number of times the playback shall be looped
  provenance:
    sources:
    - help-text
- spellings:
  - -framedrop
  group: 'Advanced options:'
  description: drop frames when cpu is too slow
  provenance:
    sources:
    - help-text
- spellings:
  - -infbuf
  group: 'Advanced options:'
  description: don't limit the input buffer size (useful with realtime streams)
  provenance:
    sources:
    - help-text
- spellings:
  - -left
  value_name: x pos
  value_kind: Required
  group: 'Advanced options:'
  description: set the x position for the left of the window
  provenance:
    sources:
    - help-text
- spellings:
  - -top
  value_name: y pos
  value_kind: Required
  group: 'Advanced options:'
  description: set the y position for the top of the window
  provenance:
    sources:
    - help-text
- spellings:
  - -vf
  value_name: filter_graph
  value_kind: Required
  group: 'Advanced options:'
  description: set video filters
  provenance:
    sources:
    - help-text
- spellings:
  - -rdftspeed
  value_name: msecs
  value_kind: Required
  group: 'Advanced options:'
  description: rdft speed
  provenance:
    sources:
    - help-text
- spellings:
  - -acodec
  value_name: decoder_name
  value_kind: Required
  group: 'Advanced options:'
  description: force audio decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -scodec
  value_name: decoder_name
  value_kind: Required
  group: 'Advanced options:'
  description: force subtitle decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -vcodec
  value_name: decoder_name
  value_kind: Required
  group: 'Advanced options:'
  description: force video decoder
  provenance:
    sources:
    - help-text
- spellings:
  - -find_stream_info
  group: 'Advanced options:'
  description: read and decode the streams to fill missing information with heuristics
  provenance:
    sources:
    - help-text
- spellings:
  - -filter_threads
  group: 'Advanced options:'
  description: number of filter threads per graph
  provenance:
    sources:
    - help-text
- spellings:
  - -flags
  value_name: flags
  value_kind: Required
  choices:
  - name: unaligned
    description: .D.V....... allow decoders to produce unaligned output
  - name: gray
    description: ED.V....... only decode/encode grayscale
  - name: low_delay
    description: ED.V....... force low delay
  - name: bitexact
    description: ED.VAS..... use only bitexact functions (except (I)DCT)
  - name: output_corrupt
    description: .D.V....... Output even potentially corrupted frames
  - name: drop_changed
    description: .D.VA.....P Drop frames whose parameters differ from first decoded frame
  group: 'AVCodecContext AVOptions:'
  description: (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -flags2
  value_name: flags
  value_kind: Required
  choices:
  - name: ignorecrop
    description: .D.V....... ignore cropping information from sps
  - name: chunks
    description: .D.V....... Frame data might be split into multiple chunks
  - name: showall
    description: .D.V....... Show all frames before the first keyframe
  - name: export_mvs
    description: .D.V....... export motion vectors through frame side data
  - name: skip_manual
    description: .D..A...... do not skip samples and export skip information as frame side data
  - name: ass_ro_flush_noop
    description: .D...S..... do not reset ASS ReadOrder field on flush
  - name: icc_profiles
    description: .D...S..... generate/parse embedded ICC profiles from/to colorimetry tags
  group: 'AVCodecContext AVOptions:'
  description: (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -export_side_data
  value_name: flags
  value_kind: Required
  choices:
  - name: mvs
    description: .D.V....... export motion vectors through frame side data
  - name: venc_params
    description: .D.V....... export video encoding parameters through frame side data
  - name: film_grain
    description: .D.V....... export film grain parameters through frame side data
  group: 'AVCodecContext AVOptions:'
  description: Export metadata as side data (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -ar
  value_name: int
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: set audio sampling rate (in Hz) (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -ac
  value_name: int
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: set number of audio channels (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -bug
  value_name: flags
  value_kind: Required
  choices:
  - name: autodetect
    description: .D.V.......
  - name: xvid_ilace
    description: .D.V....... Xvid interlacing bug (autodetected if FOURCC == XVIX)
  - name: ump4
    description: .D.V....... (autodetected if FOURCC == UMP4)
  - name: no_padding
    description: .D.V....... padding bug (autodetected)
  - name: amv
    description: .D.V.......
  - name: qpel_chroma
    description: .D.V.......
  - name: std_qpel
    description: .D.V....... old standard qpel (autodetected per FOURCC/version)
  - name: qpel_chroma2
    description: .D.V.......
  - name: direct_blocksize
    description: .D.V....... direct-qpel-blocksize bug (autodetected per FOURCC/version)
  - name: edge
    description: .D.V....... edge padding bug (autodetected per FOURCC/version)
  - name: hpel_chroma
    description: .D.V.......
  - name: dc_clip
    description: .D.V.......
  - name: ms
    description: .D.V....... work around various bugs in Microsoft's broken decoders
  - name: trunc
    description: .D.V....... truncated frames
  - name: iedge
    description: .D.V.......
  group: 'AVCodecContext AVOptions:'
  description: work around not autodetected encoder bugs (default autodetect)
  provenance:
    sources:
    - help-text
- spellings:
  - -strict
  value_name: int
  value_kind: Required
  choices:
  - name: very
    description: 2 ED.VA...... strictly conform to a older more strict version of the spec or reference software
  - name: strict
    description: 1 ED.VA...... strictly conform to all the things in the spec no matter what the consequences
  - name: normal
    description: 0 ED.VA......
  - name: unofficial
    description: -1 ED.VA...... allow unofficial extensions
  - name: experimental
    description: -2 ED.VA...... allow non-standardized experimental things
  group: 'AVCodecContext AVOptions:'
  description: how strictly to follow the standards (from INT_MIN to INT_MAX) (default normal)
  provenance:
    sources:
    - help-text
- spellings:
  - -err_detect
  value_name: flags
  value_kind: Required
  choices:
  - name: crccheck
    description: ED.VAS..... verify embedded CRCs
  - name: bitstream
    description: ED.VAS..... detect bitstream specification deviations
  - name: buffer
    description: ED.VAS..... detect improper bitstream length
  - name: explode
    description: ED.VAS..... abort decoding on minor error detection
  - name: ignore_err
    description: ED.VAS..... ignore errors
  - name: careful
    description: ED.VAS..... consider things that violate the spec, are fast to check and have not been seen in the wild as errors
  - name: compliant
    description: ED.VAS..... consider all spec non compliancies as errors
  - name: aggressive
    description: ED.VAS..... consider things that a sane encoder should not do as an error
  group: 'AVCodecContext AVOptions:'
  description: set error detection flags (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -idct
  value_name: int
  value_kind: Required
  choices:
  - name: auto
    description: 0 ED.V.......
  - name: int
    description: 1 ED.V.......
  - name: simple
    description: 2 ED.V.......
  - name: simplemmx
    description: 3 ED.V.......
  - name: arm
    description: 7 ED.V.......
  - name: altivec
    description: 8 ED.V.......
  - name: simplearm
    description: 10 ED.V.......
  - name: simplearmv5te
    description: 16 ED.V.......
  - name: simplearmv6
    description: 17 ED.V.......
  - name: simpleneon
    description: 22 ED.V.......
  - name: xvid
    description: 14 ED.V.......
  - name: xvidmmx
    description: 14 ED.V....... deprecated, for compatibility only
  - name: faani
    description: 20 ED.V....... floating point AAN IDCT
  - name: simpleauto
    description: 128 ED.V.......
  group: 'AVCodecContext AVOptions:'
  description: select IDCT implementation (from 0 to INT_MAX) (default auto)
  provenance:
    sources:
    - help-text
- spellings:
  - -ec
  value_name: flags
  value_kind: Required
  choices:
  - name: guess_mvs
    description: .D.V....... iterative motion vector (MV) search (slow)
  - name: deblock
    description: .D.V....... use strong deblock filter for damaged MBs
  - name: favor_inter
    description: .D.V....... favor predicting from the previous frame
  group: 'AVCodecContext AVOptions:'
  description: set error concealment strategy (default guess_mvs+deblock)
  provenance:
    sources:
    - help-text
- spellings:
  - -debug
  value_name: flags
  value_kind: Required
  choices:
  - name: pict
    description: .D.V....... picture info
  - name: bitstream
    description: .D.V.......
  - name: mb_type
    description: .D.V....... macroblock (MB) type
  - name: qp
    description: .D.V....... per-block quantization parameter (QP)
  - name: dct_coeff
    description: .D.V.......
  - name: green_metadata
    description: .D.V.......
  - name: skip
    description: .D.V.......
  - name: startcode
    description: .D.V.......
  - name: er
    description: .D.V....... error recognition
  - name: mmco
    description: .D.V....... memory management control operations (H.264)
  - name: bugs
    description: .D.V.......
  - name: buffers
    description: .D.V....... picture buffer allocations
  - name: thread_ops
    description: .D.VA...... threading operations
  - name: nomc
    description: .D.VA...... skip motion compensation
  group: 'AVCodecContext AVOptions:'
  description: print specific debug info (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -threads
  value_name: int
  value_kind: Required
  choices:
  - name: auto
    description: 0 ED.V....... autodetect a suitable number of threads to use
  group: 'AVCodecContext AVOptions:'
  description: set the number of threads (from 0 to INT_MAX) (default 1)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_top
  value_name: int
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: number of macroblock rows at the top which are skipped (from INT_MIN to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_bottom
  value_name: int
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: number of macroblock rows at the bottom which are skipped (from INT_MIN to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -lowres
  value_name: int
  value_kind: Required
  group: 'AVCodecContext AVOptions:'
  description: decode at 1= 1/2, 2=1/4, 3=1/8 resolutions (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_loop_filter
  value_name: int
  value_kind: Required
  choices:
  - name: none
    description: -16 .D.V....... discard no frame
  - name: default
    description: 0 .D.V....... discard useless frames
  - name: noref
    description: 8 .D.V....... discard all non-reference frames
  - name: bidir
    description: 16 .D.V....... discard all bidirectional frames
  - name: nointra
    description: 24 .D.V....... discard all frames except I frames
  - name: nokey
    description: 32 .D.V....... discard all frames except keyframes
  - name: all
    description: 48 .D.V....... discard all frames
  group: 'AVCodecContext AVOptions:'
  description: skip loop filtering process for the selected frames (from INT_MIN to INT_MAX) (default default)
  provenance:
    sources:
    - help-text
- spellings:
  - -skip_idct
  value_name: int
  value_kind: Required
  choices:
  - name: none
    description: -16 .D.V....... discard no frame
  - name: default
    description: 0 .D.V....... discard useless frames
  - name: noref
    description: 8 .D.V....... discard all non-reference frames
  - name: bidir
    description: 16 .D.V....... discard all bidirectional frames
  - name: nointra
    description: 24 .D.V....... discard all frames except I frames
  - name: nokey
    description: 32 .D.V....... discard all frames except keyframes
  - name: all
    description: 48 .D.V....... discard all frames
  group: 'AVCodecContext AVOptions:'
