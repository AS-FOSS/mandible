  - curve1
  value_name: int
  value_kind: Required
  choices:
  - name: nofade
    description: -1 ..F.A...... no fade; keep audio as-is
  - name: tri
    description: 0 ..F.A...... linear slope
  - name: qsin
    description: 1 ..F.A...... quarter of sine wave
  - name: esin
    description: 2 ..F.A...... exponential sine wave
  - name: hsin
    description: 3 ..F.A...... half of sine wave
  - name: log
    description: 4 ..F.A...... logarithmic
  - name: ipar
    description: 5 ..F.A...... inverted parabola
  - name: qua
    description: 6 ..F.A...... quadratic
  - name: cub
    description: 7 ..F.A...... cubic
  - name: squ
    description: 8 ..F.A...... square root
  - name: cbr
    description: 9 ..F.A...... cubic root
  - name: par
    description: 10 ..F.A...... parabola
  - name: exp
    description: 11 ..F.A...... exponential
  - name: iqsin
    description: 12 ..F.A...... inverted quarter of sine wave
  - name: ihsin
    description: 13 ..F.A...... inverted half of sine wave
  - name: dese
    description: 14 ..F.A...... double-exponential seat
  - name: desi
    description: 15 ..F.A...... double-exponential sigmoid
  - name: losi
    description: 16 ..F.A...... logistic sigmoid
  - name: sinc
    description: 17 ..F.A...... sine cardinal function
  - name: isinc
    description: 18 ..F.A...... inverted sine cardinal function
  - name: quat
    description: 19 ..F.A...... quartic
  - name: quatr
    description: 20 ..F.A...... quartic root
  - name: qsin2
    description: 21 ..F.A...... squared quarter of sine wave
  - name: hsin2
    description: 22 ..F.A...... squared half of sine wave
  group: 'acrossfade AVOptions:'
