  - -referer
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: override referer header
  provenance:
    sources:
    - help-text
- spellings:
  - -multiple_requests
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: use persistent connections (default false)
  provenance:
    sources:
    - help-text
