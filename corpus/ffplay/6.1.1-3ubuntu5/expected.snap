  provenance:
    sources:
    - help-text
- spellings:
  - -channels
  value_name: int
  value_kind: Required
  group: 'Pulse indev AVOptions:'
  description: set number of audio channels (from 1 to INT_MAX) (default 2)
  provenance:
    sources:
    - help-text
- spellings:
  - -frame_size
  value_name: int
  value_kind: Required
  group: 'Pulse indev AVOptions:'
  description: set number of bytes per frame (from 1 to INT_MAX) (default 1024)
  provenance:
    sources:
    - help-text
- spellings:
  - -fragment_size
  value_name: int
  value_kind: Required
  group: 'Pulse indev AVOptions:'
  description: set buffering size, affects latency and cpu usage (from -1 to INT_MAX) (default -1)
  provenance:
    sources:
    - help-text
- spellings:
  - -wallclock
  value_name: int
  value_kind: Required
  group: 'Pulse indev AVOptions:'
  description: set the initial pts using the current time (from -1 to 1) (default 1)
  provenance:
    sources:
    - help-text
- spellings:
  - -standard
  value_name: string
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set TV standard, used only by analog frame grabber
  provenance:
    sources:
    - help-text
- spellings:
  - -channel
  value_name: int
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set TV channel, used only by frame grabber (from -1 to INT_MAX) (default -1)
  provenance:
    sources:
    - help-text
- spellings:
  - -video_size
  value_name: image_size
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set frame size
  provenance:
    sources:
    - help-text
- spellings:
  - -pixel_format
  value_name: string
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set preferred pixel format
  provenance:
    sources:
    - help-text
- spellings:
  - -input_format
  value_name: string
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set preferred pixel format (for raw video) or codec name
  provenance:
    sources:
    - help-text
- spellings:
  - -framerate
  value_name: string
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: set frame rate
  provenance:
    sources:
    - help-text
- spellings:
  - -list_formats
  value_name: int
  value_kind: Required
  choices:
  - name: all
    description: 3 .D......... show all available formats
  - name: raw
    description: 1 .D......... show only non-compressed formats
  - name: compressed
    description: 2 .D......... show only compressed formats
  group: 'V4L2 indev AVOptions:'
  description: list available formats and exit (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -list_standards
  value_name: int
  value_kind: Required
  choices:
  - name: all
    description: 1 .D......... show all supported standards
  group: 'V4L2 indev AVOptions:'
  description: list supported standards and exit (from 0 to 1) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -timestamps
  value_name: int
  value_kind: Required
  choices:
  - name: default
    description: 0 .D......... use timestamps from the kernel
  - name: abs
    description: 1 .D......... use absolute timestamps (wall clock)
  - name: mono2abs
    description: 2 .D......... force conversion from monotonic to absolute timestamps
  group: 'V4L2 indev AVOptions:'
  description: set type of timestamps for grabbed frames (from 0 to 2) (default default)
  provenance:
    sources:
    - help-text
- spellings:
  - -ts
  value_name: int
  value_kind: Required
  choices:
  - name: default
    description: 0 .D......... use timestamps from the kernel
  - name: abs
    description: 1 .D......... use absolute timestamps (wall clock)
  - name: mono2abs
    description: 2 .D......... force conversion from monotonic to absolute timestamps
  group: 'V4L2 indev AVOptions:'
  description: set type of timestamps for grabbed frames (from 0 to 2) (default default)
  provenance:
    sources:
    - help-text
- spellings:
  - -use_libv4l2
  value_name: boolean
  value_kind: Required
  group: 'V4L2 indev AVOptions:'
  description: use libv4l2 (v4l-utils) conversion functions (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -window_id
  value_name: int
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
