  provenance:
    sources:
    - help-text
- spellings:
  - -speed
  value_name: int
  value_kind: Required
  group: 'libcdio indev AVOptions:'
  description: set drive reading speed (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -paranoia_mode
  value_name: flags
  value_kind: Required
  choices:
  - name: disable
    description: .D......... apply no fixups
  - name: verify
    description: .D......... verify data integrity in overlap area
  - name: overlap
    description: .D......... perform overlapped reads
  - name: neverskip
    description: .D......... do not skip failed reads
  - name: full
    description: .D......... apply all recovery modes
  group: 'libcdio indev AVOptions:'
  description: set error recovery mode (default 0)
  provenance:
    sources:
    - help-text
