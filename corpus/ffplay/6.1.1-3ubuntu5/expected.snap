  choices:
  - name: auto
    description: -1 ..FV....... auto detect parity
  - name: bff
    description: 0 ..FV....... assume bottom field first
  - name: tff
    description: 1 ..FV....... assume top field first
  group: 'fieldmatch AVOptions:'
