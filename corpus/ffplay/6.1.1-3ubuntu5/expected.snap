name: ffplay
description: Simple media player
usage:
- 'usage: ffplay [options] input_file'
positionals:
- name: input_file
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -L
  group: 'Main options:'
  description: show license
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  value_name: topic
  value_kind: Required
  group: 'Main options:'
  description: show help
  provenance:
    sources:
    - help-text
- spellings:
