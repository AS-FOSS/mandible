    - help-text
- spellings:
  - -seekable
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: control seekability of connection (default auto)
  provenance:
    sources:
    - help-text
- spellings:
  - -http_proxy
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: set HTTP proxy to tunnel through
  provenance:
    sources:
    - help-text
- spellings:
  - -headers
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: set custom HTTP headers, can override built in default headers
  provenance:
    sources:
    - help-text
- spellings:
  - -content_type
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: set a specific content type for the POST messages
  provenance:
    sources:
    - help-text
- spellings:
  - -user_agent
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: override User-Agent header (default "Lavf/60.16.100")
  provenance:
    sources:
    - help-text
- spellings:
  - -referer
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: override referer header
  provenance:
    sources:
    - help-text
- spellings:
  - -multiple_requests
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: use persistent connections (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -post_data
  value_name: binary
  value_kind: Required
  group: 'http AVOptions:'
  description: set custom HTTP post data
  provenance:
    sources:
    - help-text
- spellings:
  - -cookies
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: set cookies to be sent in applicable future requests, use newline delimited Set-Cookie HTTP field value syntax
  provenance:
    sources:
    - help-text
- spellings:
  - -icy
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: request ICY metadata (default true)
  provenance:
    sources:
    - help-text
- spellings:
  - -auth_type
  value_name: int
  value_kind: Required
  choices:
  - name: none
    description: 0 ED......... No auth method set, autodetect
  - name: basic
    description: 1 ED......... HTTP basic authentication
  group: 'http AVOptions:'
  description: HTTP authentication type (from 0 to 1) (default none)
  provenance:
    sources:
    - help-text
- spellings:
  - -location
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: The actual location of the data received
  provenance:
    sources:
    - help-text
- spellings:
  - -offset
  value_name: int64
  value_kind: Required
  group: 'http AVOptions:'
  description: initial byte offset (from 0 to I64_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -end_offset
  value_name: int64
  value_kind: Required
  group: 'http AVOptions:'
  description: try to limit the request to bytes preceding this offset (from 0 to I64_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -method
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: Override the HTTP method or set the expected HTTP method from a client
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: auto reconnect after disconnect before EOF (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect_at_eof
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: auto reconnect at EOF (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect_on_network_error
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: auto reconnect in case of tcp/tls error during connect (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect_on_http_error
  value_name: string
  value_kind: Required
  group: 'http AVOptions:'
  description: list of http status codes to reconnect on
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect_streamed
  value_name: boolean
  value_kind: Required
  group: 'http AVOptions:'
  description: auto reconnect streamed / non seekable streams (default false)
  provenance:
    sources:
    - help-text
- spellings:
  - -reconnect_delay_max
  value_name: int
  value_kind: Required
  group: 'http AVOptions:'
  description: max reconnect delay in seconds after which to give up (from 0 to 4294) (default 120)
  provenance:
    sources:
    - help-text
- spellings:
  - -listen
  value_name: int
  value_kind: Required
  group: 'http AVOptions:'
  description: listen on HTTP (from 0 to 2) (default 0)
