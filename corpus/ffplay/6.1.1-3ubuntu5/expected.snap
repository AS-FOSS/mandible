    description: 0 ..FV....... send one frame for each frame
  - name: send_field
    description: 1 ..FV....... send one frame for each field
  - name: send_frame_nospatial
    description: 2 ..FV....... send one frame for each frame, but skip spatial interlacing check
  - name: send_field_nospatial
    description: 3 ..FV....... send one frame for each field, but skip spatial interlacing check
  group: 'yadif_cuda AVOptions:'
  description: specify the interlacing mode (from 0 to 3) (default send_frame)
