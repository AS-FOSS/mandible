    sources:
    - help-text
- spellings:
  - -bytes
  value_name: val
  value_kind: Required
  group: 'Main options:'
  description: seek by bytes 0=off 1=on -1=auto
  provenance:
    sources:
    - help-text
- spellings:
  - -seek_interval
  value_name: seconds
  value_kind: Required
