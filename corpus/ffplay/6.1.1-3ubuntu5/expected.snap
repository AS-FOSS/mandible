- spellings:
  - -framerate
  value_name: string
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
  description: (default "ntsc")
  provenance:
    sources:
    - help-text
- spellings:
  - -draw_mouse
  value_name: int
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
  description: Draw the mouse pointer. (from 0 to 1) (default 1)
  provenance:
    sources:
    - help-text
- spellings:
  - -follow_mouse
  value_name: int
  value_kind: Required
  choices:
  - name: centered
    description: -1 .D......... Keep the mouse pointer at the center of grabbing region when following.
  group: 'xcbgrab indev AVOptions:'
  description: Move the grabbing region when the mouse pointer reaches within specified amount of pixels to the edge of region. (from -1 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -show_region
  value_name: int
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
  description: Show the grabbing region. (from 0 to 1) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -region_border
  value_name: int
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
  description: Set the region border thickness. (from 1 to 128) (default 3)
  provenance:
    sources:
    - help-text
- spellings:
  - -select_region
  value_name: boolean
  value_kind: Required
  group: 'xcbgrab indev AVOptions:'
