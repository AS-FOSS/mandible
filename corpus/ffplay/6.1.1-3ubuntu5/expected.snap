  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_buffer
  value_name: int
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Set buffer time in milliseconds. The default is 3000. (from 0 to INT_MAX) (default 3000)
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_conn
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Append arbitrary AMF data to the Connect message
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_flashver
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Version of the Flash plugin used to run the SWF player.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_live
  value_name: int
  value_kind: Required
  choices:
  - name: any
    description: -2 .D......... both
  - name: live
    description: -1 .D......... live stream
  - name: recorded
    description: 0 .D......... recorded stream
  group: 'rtmp AVOptions:'
  description: Specify that the media is a live stream. (from INT_MIN to INT_MAX) (default any)
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_pageurl
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL of the web page in which the media was embedded. By default no value will be sent.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_playpath
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Stream identifier to play or to publish
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_subscribe
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Name of live stream to subscribe to. Defaults to rtmp_playpath.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfhash
  value_name: binary
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: SHA256 hash of the decompressed SWF file (32 bytes).
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfsize
  value_name: int
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Size of the decompressed SWF file, required for SWFVerification. (from 0 to INT_MAX) (default 0)
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfurl
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL of the SWF player. By default no value will be sent
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_swfverify
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL to player swf file, compute hash/size automatically.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_tcurl
  value_name: string
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: URL of the target stream. Defaults to proto://host[:port]/app.
  provenance:
    sources:
    - help-text
- spellings:
  - -rtmp_listen
  value_name: int
  value_kind: Required
  group: 'rtmp AVOptions:'
  description: Listen for incoming rtmp connections (from INT_MIN to INT_MAX) (default 0)
  provenance:
    sources:
