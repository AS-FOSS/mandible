name: nstat
usage:
- 'Usage: nstat [OPTION] [ PATTERN [ PATTERN ] ]'
positionals:
- name: PATTERN
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -h
  - --help
  description: this message
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --ignore
  description: ignore history
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  - --scan
  value_name: SECS
  value_kind: Required
  description: sample every statistics every SECS
  provenance:
    sources:
    - help-text
- spellings:
  - -j
  - --json
  description: format output in JSON
  provenance:
    sources:
    - help-text
- spellings:
  - -n
  - --nooutput
  description: do history only
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pretty
  description: pretty print
  provenance:
    sources:
    - help-text
- spellings:
  - -r
  - --reset
  description: reset history
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --noupdate
  description: don't update history
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  - --interval
  value_name: SECS
  value_kind: Required
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  description: output version information
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  - --zeros
  description: show entries with zero activity
  provenance:
    sources:
    - help-text
