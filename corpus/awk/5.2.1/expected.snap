  value_name: file
  value_kind: Optional
  group: "Short options:\t\tGNU long options: (extensions)"
  provenance:
    sources:
    - help-text
- short: 'O'
  long: optimize
  group: "Short options:\t\tGNU long options: (extensions)"
  provenance:
    sources:
    - help-text
- short: 'p'
