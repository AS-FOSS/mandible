name: gethostlatency-bpfcc
description: Show latency for getaddrinfo/gethostbyname[2] calls
usage:
- 'usage: gethostlatency-bpfcc [-h] [-p PID]'
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pid
  value_name: PID
  value_kind: Required
  description: trace this PID only
