name: sg_sanitize
usage:
- 'Usage: sg_sanitize [--ause] [--block] [--count=OC] [--crypto] [--dry-run] [--early] [--fail] [--help] [--invert] [--ipl=LEN] [--overwrite] [--pattern=PF] [--quick] [--test=TE] [--timeout=SECS] [--verbose] [--version] [--wait] [--zero] [--znr] DEVICE'
positionals:
- name: DEVICE
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -A
  - --ause
  group: 'where:'
  description: set AUSE bit in cdb
  provenance:
    sources:
    - help-text
- spellings:
  - -B
  - --block
  group: 'where:'
  description: do BLOCK ERASE sanitize
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  - --count
  value_name: OC
  value_kind: Required
  group: 'where:'
  description: OC is overwrite count field (from 1 (def) to 31)
  provenance:
    sources:
    - help-text
- spellings:
  - -C
  - --crypto
  group: 'where:'
  description: do CRYPTOGRAPHIC ERASE sanitize
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  - --desc
  group: 'where:'
  description: 'polling request sense sets ''desc'' field (def: clear ''desc'' field)'
  provenance:
    sources:
    - help-text
- spellings:
  - -D
  - --dry-run
  group: 'where:'
  description: to preparation but bypass SANITIZE commnd
  provenance:
    sources:
    - help-text
- spellings:
  - -e
  - --early
  group: 'where:'
  description: exit once sanitize started (IMMED set in cdb) user can monitor progress with REQUEST SENSE
  provenance:
    sources:
    - help-text
- spellings:
  - -F
  - --fail
  group: 'where:'
  description: do EXIT FAILURE MODE sanitize
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  group: 'where:'
  description: print out usage message
  provenance:
    sources:
    - help-text
- spellings:
  - -I
  - --invert
  group: 'where:'
  description: set INVERT bit in OVERWRITE parameter list
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  - --ipl
  value_name: LEN
  value_kind: Required
  group: 'where:'
  description: initialization pattern length (in bytes)
  provenance:
    sources:
    - help-text
- spellings:
  - -O
  - --overwrite
  group: 'where:'
  description: do OVERWRITE sanitize
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pattern
  value_name: PF
  value_kind: Required
  group: 'where:'
  description: PF is file containing initialization pattern for OVERWRITE
  provenance:
    sources:
    - help-text
- spellings:
  - -Q
  - --quick
  group: 'where:'
  description: start sanitize without pause for user intervention (i.e. no time to reconsider)
  provenance:
    sources:
    - help-text
- spellings:
  - -T
  - --test
  value_name: TE
  value_kind: Required
  group: 'where:'
  description: 'TE is placed in TEST field of OVERWRITE parameter list (def: 0)'
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  - --timeout
  value_name: SECS
  value_kind: Required
  group: 'where:'
  description: SANITIZE command timeout in seconds
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  group: 'where:'
  description: increase verbosity
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  group: 'where:'
  description: print version string then exit
  provenance:
    sources:
    - help-text
- spellings:
  - -w
  - --wait
  group: 'where:'
  description: wait for command to finish (could take hours)
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  - --zero
  group: 'where:'
  description: use pattern of zeros for OVERWRITE
  provenance:
    sources:
    - help-text
- spellings:
  - -Z
  - --znr
  group: 'where:'
  description: set ZNR (zone no reset) bit in cdb
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
