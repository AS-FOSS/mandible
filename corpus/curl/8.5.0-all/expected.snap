name: curl
usage:
- 'Usage: curl [options...] <url>'
positionals:
- name: url
  required: true
  provenance:
    sources:
    - help-text
flags:
- long: abstract-unix-socket
  value_name: <path>
  value_kind: Required
  description: Connect via abstract Unix domain socket
  provenance:
    sources:
    - help-text
- long: alt-svc
  value_name: <file name>
  value_kind: Required
  description: Enable alt-svc with this cache file
  provenance:
    sources:
    - help-text
- long: anyauth
  description: Pick any authentication method
  provenance:
    sources:
    - help-text
- short: 'a'
  long: append
  description: Append to target file when uploading
  provenance:
    sources:
    - help-text
- long: aws-sigv4
  value_name: <provider1[:provider2[:region[:service]]]>
  value_kind: Required
  description: Use AWS V4 signature authentication
  provenance:
    sources:
    - help-text
- long: basic
  description: Use HTTP Basic Authentication
  provenance:
    sources:
    - help-text
- long: ca-native
  description: Use CA certificates from the native OS
  provenance:
    sources:
    - help-text
- long: cacert
  value_name: <file>
  value_kind: Required
  description: CA certificate to verify peer against
  provenance:
    sources:
    - help-text
- long: capath
  value_name: <dir>
  value_kind: Required
  description: CA directory to verify peer against
  provenance:
    sources:
    - help-text
- short: 'E'
  long: cert
  value_name: <certificate[:password]>
  value_kind: Required
  description: Client certificate file and password
  provenance:
    sources:
    - help-text
- long: cert-status
  description: Verify the status of the server cert via OCSP-staple
  provenance:
    sources:
    - help-text
- long: cert-type
  value_name: <type>
  value_kind: Required
  description: Certificate type (DER/PEM/ENG/P12)
  provenance:
    sources:
    - help-text
- long: ciphers
  value_name: <list of ciphers>
  value_kind: Required
  description: SSL ciphers to use
  provenance:
    sources:
    - help-text
- long: compressed
  description: Request compressed response
  provenance:
    sources:
    - help-text
- long: compressed-ssh
  description: Enable SSH compression
  provenance:
    sources:
    - help-text
- short: 'K'
  long: config
  value_name: <file>
  value_kind: Required
  description: Read config from a file
  provenance:
    sources:
    - help-text
- long: connect-timeout
  value_name: <fractional seconds>
  value_kind: Required
  description: Maximum time allowed for connection
  provenance:
    sources:
    - help-text
- long: connect-to
  value_name: <HOST1:PORT1:HOST2:PORT2>
  value_kind: Required
  description: Connect to host
  provenance:
    sources:
    - help-text
- short: 'C'
  long: continue-at
  value_name: <offset>
  value_kind: Required
  description: Resumed transfer offset
  provenance:
    sources:
    - help-text
- short: 'b'
  long: cookie
  value_name: <data|filename>
  value_kind: Required
  description: Send cookies from string/file
  provenance:
    sources:
    - help-text
- short: 'c'
  long: cookie-jar
  value_name: <filename>
  value_kind: Required
  description: Write cookies to <filename> after operation
  provenance:
    sources:
    - help-text
- long: create-dirs
  description: Create necessary local directory hierarchy
  provenance:
    sources:
    - help-text
- long: create-file-mode
  value_name: <mode>
  value_kind: Required
  description: File mode for created files
  provenance:
    sources:
    - help-text
- long: crlf
  description: Convert LF to CRLF in upload
  provenance:
    sources:
    - help-text
- long: crlfile
  value_name: <file>
  value_kind: Required
  description: Use this CRL list
  provenance:
    sources:
    - help-text
- long: curves
  value_name: <algorithm list>
  value_kind: Required
  description: (EC) TLS key exchange algorithm(s) to request
  provenance:
    sources:
    - help-text
- short: 'd'
  long: data
  value_name: <data>
  value_kind: Required
  description: HTTP POST data
  provenance:
    sources:
    - help-text
- long: data-ascii
  value_name: <data>
  value_kind: Required
  description: HTTP POST ASCII data
  provenance:
    sources:
    - help-text
- long: data-binary
  value_name: <data>
  value_kind: Required
  description: HTTP POST binary data
  provenance:
    sources:
    - help-text
- long: data-raw
  value_name: <data>
  value_kind: Required
  description: HTTP POST data, '@' allowed
  provenance:
    sources:
    - help-text
- long: data-urlencode
  value_name: <data>
  value_kind: Required
  description: HTTP POST data URL encoded
  provenance:
    sources:
    - help-text
- long: delegation
  value_name: <LEVEL>
  value_kind: Required
  description: GSS-API delegation permission
  provenance:
    sources:
    - help-text
- long: digest
  description: Use HTTP Digest Authentication
  provenance:
    sources:
    - help-text
- short: 'q'
  long: disable
  description: Disable .curlrc
  provenance:
    sources:
    - help-text
- long: disable-eprt
  description: Inhibit using EPRT or LPRT
  provenance:
    sources:
    - help-text
- long: disable-epsv
  description: Inhibit using EPSV
  provenance:
    sources:
    - help-text
- long: disallow-username-in-url
  description: Disallow username in URL
  provenance:
    sources:
    - help-text
- long: dns-interface
  value_name: <interface>
  value_kind: Required
  description: Interface to use for DNS requests
  provenance:
    sources:
    - help-text
- long: dns-ipv4-addr
  value_name: <address>
  value_kind: Required
  description: IPv4 address to use for DNS requests
  provenance:
    sources:
    - help-text
- long: dns-ipv6-addr
  value_name: <address>
  value_kind: Required
  description: IPv6 address to use for DNS requests
  provenance:
    sources:
    - help-text
- long: dns-servers
  value_name: <addresses>
  value_kind: Required
  description: DNS server addrs to use
  provenance:
    sources:
    - help-text
- long: doh-cert-status
  description: Verify the status of the DoH server cert via OCSP-staple
  provenance:
    sources:
    - help-text
- long: doh-insecure
  description: Allow insecure DoH server connections
  provenance:
    sources:
    - help-text
- long: doh-url
  value_name: <URL>
  value_kind: Required
  description: Resolve host names over DoH
  provenance:
    sources:
    - help-text
- short: 'D'
  long: dump-header
  value_name: <filename>
  value_kind: Required
  description: Write the received headers to <filename>
  provenance:
    sources:
    - help-text
- long: egd-file
  value_name: <file>
  value_kind: Required
  description: EGD socket path for random data
  provenance:
    sources:
    - help-text
- long: engine
  value_name: <name>
  value_kind: Required
  description: Crypto engine to use
  provenance:
    sources:
    - help-text
- long: etag-compare
  value_name: <file>
  value_kind: Required
  description: Pass an ETag from a file as a custom header
  provenance:
    sources:
    - help-text
- long: etag-save
  value_name: <file>
  value_kind: Required
  description: Parse ETag from a request and save it to a file
  provenance:
    sources:
    - help-text
- long: expect100-timeout
  value_name: <seconds>
  value_kind: Required
  description: How long to wait for 100-continue
  provenance:
    sources:
    - help-text
- short: 'f'
  long: fail
  description: Fail fast with no output on HTTP errors
  provenance:
    sources:
    - help-text
- long: fail-early
  description: Fail on first transfer error, do not continue
  provenance:
    sources:
    - help-text
- long: fail-with-body
  description: Fail on HTTP errors but save the body
  provenance:
    sources:
    - help-text
- long: false-start
  description: Enable TLS False Start
  provenance:
    sources:
    - help-text
- short: 'F'
  long: form
  value_name: <name=content>
  value_kind: Required
  description: Specify multipart MIME data
  provenance:
    sources:
    - help-text
- long: form-escape
  description: Escape multipart form field/file names using backslash
  provenance:
    sources:
    - help-text
- long: form-string
  value_name: <name=string>
  value_kind: Required
  description: Specify multipart MIME data
  provenance:
    sources:
    - help-text
- long: ftp-account
  value_name: <data>
  value_kind: Required
  description: Account data string
  provenance:
    sources:
    - help-text
- long: ftp-alternative-to-user
  value_name: <command>
  value_kind: Required
  description: String to replace USER [name]
  provenance:
    sources:
    - help-text
- long: ftp-create-dirs
  description: Create the remote dirs if not present
  provenance:
    sources:
    - help-text
- long: ftp-method
  value_name: <method>
  value_kind: Required
  description: Control CWD usage
  provenance:
    sources:
    - help-text
- long: ftp-pasv
  description: Use PASV/EPSV instead of PORT
  provenance:
    sources:
    - help-text
- short: 'P'
  long: ftp-port
  value_name: <address>
  value_kind: Required
  description: Use PORT instead of PASV
  provenance:
    sources:
    - help-text
- long: ftp-pret
  description: Send PRET before PASV
  provenance:
    sources:
    - help-text
- long: ftp-skip-pasv-ip
  description: Skip the IP address for PASV
  provenance:
    sources:
    - help-text
- long: ftp-ssl-ccc
  description: Send CCC after authenticating
  provenance:
    sources:
    - help-text
- long: ftp-ssl-ccc-mode
  value_name: <active/passive>
  value_kind: Required
  description: Set CCC mode
  provenance:
    sources:
    - help-text
- long: ftp-ssl-control
  description: Require SSL/TLS for FTP login, clear for transfer
  provenance:
    sources:
    - help-text
- short: 'G'
  long: get
  description: Put the post data in the URL and use GET
  provenance:
    sources:
    - help-text
- short: 'g'
  long: globoff
  description: Disable URL sequences and ranges using {} and []
  provenance:
    sources:
    - help-text
- long: happy-eyeballs-timeout-ms
  value_name: <milliseconds>
  value_kind: Required
  description: Time for IPv6 before trying IPv4
  provenance:
    sources:
    - help-text
- long: haproxy-clientip
  description: Sets client IP in HAProxy PROXY protocol v1 header
  provenance:
    sources:
    - help-text
- long: haproxy-protocol
  description: Send HAProxy PROXY protocol v1 header
  provenance:
    sources:
    - help-text
- short: 'I'
  long: head
  description: Show document info only
  provenance:
    sources:
    - help-text
- short: 'H'
  long: header
  value_name: <header/@file>
  value_kind: Required
  description: Pass custom header(s) to server
  provenance:
    sources:
    - help-text
- short: 'h'
  long: help
  value_name: <category>
  value_kind: Required
  description: Get help for commands
  provenance:
    sources:
    - help-text
- long: hostpubmd5
  value_name: <md5>
  value_kind: Required
  description: Acceptable MD5 hash of the host public key
  provenance:
    sources:
    - help-text
- long: hostpubsha256
  value_name: <sha256>
  value_kind: Required
  description: Acceptable SHA256 hash of the host public key
  provenance:
    sources:
    - help-text
- long: hsts
  value_name: <file name>
  value_kind: Required
  description: Enable HSTS with this cache file
  provenance:
    sources:
    - help-text
- long: http0
  value_name: '.9'
  value_kind: Required
  description: Allow HTTP 0.9 responses
  provenance:
    sources:
    - help-text
- short: '0'
  long: http1
  value_name: '.0'
  value_kind: Required
  description: Use HTTP 1.0
  provenance:
    sources:
    - help-text
- long: http1
  value_name: '.1'
  value_kind: Required
  description: Use HTTP 1.1
  provenance:
    sources:
    - help-text
- long: http2
  description: Use HTTP/2
  provenance:
    sources:
    - help-text
- long: http2-prior-knowledge
  description: Use HTTP 2 without HTTP/1.1 Upgrade
  provenance:
    sources:
    - help-text
- long: http3
  description: Use HTTP v3
  provenance:
    sources:
    - help-text
- long: http3-only
  description: Use HTTP v3 only
  provenance:
    sources:
    - help-text
- long: ignore-content-length
  description: Ignore the size of the remote resource
  provenance:
    sources:
    - help-text
- short: 'i'
  long: include
  description: Include protocol response headers in the output
  provenance:
    sources:
    - help-text
- short: 'k'
  long: insecure
  description: Allow insecure server connections
  provenance:
    sources:
    - help-text
- long: interface
  value_name: <name>
  value_kind: Required
  description: Use network INTERFACE (or address)
  provenance:
    sources:
    - help-text
- long: ipfs-gateway
  value_name: <URL>
  value_kind: Required
  description: Gateway for IPFS
  provenance:
    sources:
    - help-text
- short: '4'
  long: ipv4
  description: Resolve names to IPv4 addresses
  provenance:
    sources:
    - help-text
- short: '6'
  long: ipv6
  description: Resolve names to IPv6 addresses
  provenance:
    sources:
    - help-text
- long: json
  value_name: <data>
  value_kind: Required
  description: HTTP POST JSON
  provenance:
    sources:
    - help-text
- short: 'j'
  long: junk-session-cookies
  description: Ignore session cookies read from file
  provenance:
    sources:
    - help-text
- long: keepalive-time
  value_name: <seconds>
  value_kind: Required
  description: Interval time for keepalive probes
  provenance:
    sources:
    - help-text
- long: key
  value_name: <key>
  value_kind: Required
  description: Private key file name
  provenance:
    sources:
    - help-text
- long: key-type
  value_name: <type>
  value_kind: Required
  description: Private key file type (DER/PEM/ENG)
  provenance:
    sources:
    - help-text
- long: krb
  value_name: <level>
  value_kind: Required
  description: Enable Kerberos with security <level>
  provenance:
    sources:
    - help-text
- long: libcurl
  value_name: <file>
  value_kind: Required
  description: Dump libcurl equivalent code of this command line
  provenance:
    sources:
    - help-text
- long: limit-rate
  value_name: <speed>
  value_kind: Required
  description: Limit transfer speed to RATE
  provenance:
    sources:
    - help-text
- short: 'l'
  long: list-only
  description: List only mode
  provenance:
    sources:
    - help-text
- long: local-port
  value_name: <num/range>
  value_kind: Required
  description: Force use of RANGE for local port numbers
  provenance:
    sources:
    - help-text
- short: 'L'
  long: location
  description: Follow redirects
  provenance:
    sources:
    - help-text
- long: location-trusted
  description: Like --location, and send auth to other hosts
  provenance:
    sources:
    - help-text
- long: login-options
  value_name: <options>
  value_kind: Required
  description: Server login options
  provenance:
    sources:
    - help-text
- long: mail-auth
  value_name: <address>
  value_kind: Required
  description: Originator address of the original email
  provenance:
    sources:
    - help-text
- long: mail-from
  value_name: <address>
  value_kind: Required
  description: Mail from this address
  provenance:
    sources:
    - help-text
- long: mail-rcpt
  value_name: <address>
  value_kind: Required
  description: Mail to this address
  provenance:
    sources:
    - help-text
- long: mail-rcpt-allowfails
  description: Allow RCPT TO command to fail for some recipients
  provenance:
    sources:
    - help-text
- short: 'M'
  long: manual
  description: Display the full manual
  provenance:
    sources:
    - help-text
- long: max-filesize
  value_name: <bytes>
  value_kind: Required
  description: Maximum file size to download
  provenance:
    sources:
    - help-text
- long: max-redirs
  value_name: <num>
  value_kind: Required
  description: Maximum number of redirects allowed
  provenance:
    sources:
    - help-text
- short: 'm'
  long: max-time
  value_name: <fractional seconds>
  value_kind: Required
  description: Maximum time allowed for transfer
  provenance:
    sources:
    - help-text
- long: metalink
  description: Process given URLs as metalink XML file
  provenance:
    sources:
    - help-text
- long: negotiate
  description: Use HTTP Negotiate (SPNEGO) authentication
  provenance:
    sources:
    - help-text
- short: 'n'
  long: netrc
  description: Must read .netrc for user name and password
  provenance:
    sources:
    - help-text
- long: netrc-file
  value_name: <filename>
  value_kind: Required
  description: Specify FILE for netrc
  provenance:
    sources:
    - help-text
- long: netrc-optional
  description: Use either .netrc or URL
  provenance:
    sources:
    - help-text
- short: ':'
  long: next
  description: Make next URL use its separate set of options
  provenance:
    sources:
    - help-text
- long: no-alpn
  description: Disable the ALPN TLS extension
  provenance:
    sources:
    - help-text
- short: 'N'
  long: no-buffer
  description: Disable buffering of the output stream
  provenance:
    sources:
    - help-text
- long: no-clobber
  description: Do not overwrite files that already exist
  provenance:
    sources:
    - help-text
- long: no-keepalive
  description: Disable TCP keepalive on the connection
  provenance:
    sources:
    - help-text
- long: no-npn
  description: Disable the NPN TLS extension
  provenance:
    sources:
    - help-text
- long: no-progress-meter
  description: Do not show the progress meter
  provenance:
    sources:
    - help-text
- long: no-sessionid
  description: Disable SSL session-ID reusing
  provenance:
    sources:
    - help-text
- long: noproxy
  value_name: <no-proxy-list>
  value_kind: Required
  description: List of hosts which do not use proxy
  provenance:
    sources:
    - help-text
- long: ntlm
  description: Use HTTP NTLM authentication
  provenance:
    sources:
    - help-text
- long: ntlm-wb
  description: Use HTTP NTLM authentication with winbind
  provenance:
    sources:
    - help-text
- long: oauth2-bearer
  value_name: <token>
  value_kind: Required
  description: OAuth 2 Bearer Token
  provenance:
    sources:
    - help-text
- short: 'o'
  long: output
  value_name: <file>
  value_kind: Required
  description: Write to file instead of stdout
  provenance:
    sources:
    - help-text
- long: output-dir
  value_name: <dir>
  value_kind: Required
  description: Directory to save files in
  provenance:
    sources:
    - help-text
- short: 'Z'
  long: parallel
  description: Perform transfers in parallel
  provenance:
    sources:
    - help-text
- long: parallel-immediate
  description: Do not wait for multiplexing (with --parallel)
  provenance:
    sources:
    - help-text
- long: parallel-max
  value_name: <num>
  value_kind: Required
  description: Maximum concurrency for parallel transfers
  provenance:
    sources:
    - help-text
- long: pass
  value_name: <phrase>
  value_kind: Required
  description: Pass phrase for the private key
  provenance:
    sources:
    - help-text
- long: path-as-is
  description: Do not squash .. sequences in URL path
  provenance:
    sources:
    - help-text
- long: pinnedpubkey
  value_name: <hashes>
  value_kind: Required
  description: FILE/HASHES Public key to verify peer against
  provenance:
    sources:
    - help-text
- long: post301
  description: Do not switch to GET after following a 301
  provenance:
    sources:
    - help-text
- long: post302
  description: Do not switch to GET after following a 302
  provenance:
    sources:
    - help-text
- long: post303
  description: Do not switch to GET after following a 303
  provenance:
    sources:
    - help-text
- long: preproxy
  value_name: protocol://
  value_kind: Optional
  description: Use this proxy first
  provenance:
    sources:
    - help-text
- short: '#'
  long: progress-bar
  description: Display transfer progress as a bar
  provenance:
    sources:
    - help-text
- long: proto
  value_name: <protocols>
  value_kind: Required
  description: Enable/disable PROTOCOLS
  provenance:
    sources:
    - help-text
- long: proto-default
  value_name: <protocol>
  value_kind: Required
  description: Use PROTOCOL for any URL missing a scheme
  provenance:
    sources:
    - help-text
- long: proto-redir
  value_name: <protocols>
  value_kind: Required
  description: Enable/disable PROTOCOLS on redirect
  provenance:
    sources:
    - help-text
- short: 'x'
  long: proxy
  value_name: protocol://
  value_kind: Optional
  description: Use this proxy
  provenance:
    sources:
    - help-text
- long: proxy-anyauth
  description: Pick any proxy authentication method
  provenance:
    sources:
    - help-text
- long: proxy-basic
  description: Use Basic authentication on the proxy
  provenance:
    sources:
    - help-text
- long: proxy-ca-native
  description: Use CA certificates from the native OS for proxy
  provenance:
    sources:
    - help-text
- long: proxy-cacert
  value_name: <file>
  value_kind: Required
  description: CA certificate to verify peer against for proxy
  provenance:
    sources:
    - help-text
- long: proxy-capath
  value_name: <dir>
  value_kind: Required
  description: CA directory to verify peer against for proxy
  provenance:
    sources:
    - help-text
- long: proxy-cert
  value_name: <cert[:passwd]>
  value_kind: Required
  description: Set client certificate for proxy
  provenance:
    sources:
    - help-text
- long: proxy-cert-type
  value_name: <type>
  value_kind: Required
  description: Client certificate type for HTTPS proxy
  provenance:
    sources:
    - help-text
- long: proxy-ciphers
  value_name: <list>
  value_kind: Required
  description: SSL ciphers to use for proxy
  provenance:
    sources:
    - help-text
- long: proxy-crlfile
  value_name: <file>
  value_kind: Required
  description: Set a CRL list for proxy
  provenance:
    sources:
    - help-text
- long: proxy-digest
  description: Use Digest authentication on the proxy
  provenance:
    sources:
    - help-text
- long: proxy-header
