name: curl
usage:
- 'Usage: curl [options...] <url>'
positionals:
- name: url
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - --abstract-unix-socket
  value_name: <path>
  value_kind: Required
  description: Connect via abstract Unix domain socket
  provenance:
    sources:
    - help-text
- spellings:
  - --alt-svc
  value_name: <file name>
  value_kind: Required
  description: Enable alt-svc with this cache file
  provenance:
    sources:
    - help-text
- spellings:
  - --anyauth
  description: Pick any authentication method
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --append
  description: Append to target file when uploading
  provenance:
    sources:
    - help-text
- spellings:
  - --aws-sigv4
  value_name: <provider1[:provider2[:region[:service]]]>
  value_kind: Required
  description: Use AWS V4 signature authentication
  provenance:
    sources:
    - help-text
- spellings:
  - --basic
  description: Use HTTP Basic Authentication
