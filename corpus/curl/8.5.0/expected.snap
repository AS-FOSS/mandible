name: curl
usage:
- 'Usage: curl [options...] <url>'
positionals:
- name: url
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -d
  - --data
  value_name: <data>
  value_kind: Required
  description: HTTP POST data
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  - --fail
  description: Fail fast with no output on HTTP errors
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  value_name: <category>
  value_kind: Required
  description: Get help for commands
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  - --include
  description: Include protocol response headers in the output
  provenance:
    sources:
    - help-text
- spellings:
  - -o
  - --output
  value_name: <file>
  value_kind: Required
  description: Write to file instead of stdout
  provenance:
    sources:
    - help-text
- spellings:
  - -O
  - --remote-name
  description: Write output to a file named as the remote file
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --silent
  description: Silent mode
  provenance:
    sources:
    - help-text
- spellings:
  - -T
  - --upload-file
  value_name: <file>
  value_kind: Required
  description: Transfer local FILE to destination
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  - --user
  value_name: <user:password>
  value_kind: Required
  description: Server user and password
  provenance:
    sources:
    - help-text
- spellings:
  - -A
  - --user-agent
  value_name: <name>
  value_kind: Required
  description: Send User-Agent <name> to server
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  description: Make the operation more talkative
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  description: Show version number and quit
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
confession:
  word: all
  flag: --help
  followed: false
