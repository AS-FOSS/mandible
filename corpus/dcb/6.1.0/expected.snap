name: dcb
usage:
- 'Usage: dcb [ OPTIONS ] OBJECT { COMMAND | help }'
- '       dcb [ -f | --force ] { -b | --batch } filename [ -n | --netns ] netnsname'
positionals:
- name: OBJECT
  required: true
  provenance:
    sources:
    - help-text
- name: COMMAND
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -V
  - --Version
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  - --iec
  provenance:
    sources:
    - help-text
- spellings:
  - -j
  - --json
  provenance:
    sources:
    - help-text
- spellings:
  - -N
  - --Numeric
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pretty
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --statistics
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  - --force
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -b
  - --batch
  provenance:
    sources:
    - help-text-synopsis
- spellings:
  - -n
  - --netns
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
