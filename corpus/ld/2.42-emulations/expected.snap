name: ld
description: 'Options: /usr/bin/ld: emulation specific options: ELF emulations:'
usage:
- 'Usage: /usr/bin/ld [options] file...'
flags:
- spellings:
  - -a
  value_name: KEYWORD
  value_kind: Required
  description: Shared library control for HP/UX compatibility
  provenance:
    sources:
    - help-text
- spellings:
  - --build-id
  value_name: STYLE
  value_kind: Optional
  group: 'ELF emulations:'
  description: Generate build ID note
  provenance:
    sources:
    - help-text
- spellings:
  - --package-metadata
  value_name: JSON
  value_kind: Optional
  group: 'ELF emulations:'
  description: Generate package metadata note
  provenance:
    sources:
    - help-text
- spellings:
  - --compress-debug-sections
  value_name: '[none|zlib|zlib-gnu|zlib-gabi|zstd]'
  value_kind: Required
  group: 'ELF emulations:'
  description: 'Compress DWARF debug sections Default: none'
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: common-page-size=SIZE
  value_kind: Required
  group: 'ELF emulations:'
  description: Set common page size to SIZE
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: max-page-size=SIZE
  value_kind: Required
  group: 'ELF emulations:'
  description: Set maximum page size to SIZE
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: defs
  value_kind: Required
  group: 'ELF emulations:'
  description: Report unresolved symbols in object files
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: undefs
  value_kind: Required
  group: 'ELF emulations:'
  description: Ignore unresolved symbols in object files
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: muldefs
  value_kind: Required
  group: 'ELF emulations:'
  description: Allow multiple definitions
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: stack-size=SIZE
  value_kind: Required
  group: 'ELF emulations:'
  description: Set size of stack segment
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: execstack
  value_kind: Required
  group: 'ELF emulations:'
  description: Mark executable as requiring executable stack
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: noexecstack
  value_kind: Required
  group: 'ELF emulations:'
  description: Mark executable as not requiring executable stack
  provenance:
    sources:
    - help-text
- spellings:
  - --warn-execstack-objects
  group: 'ELF emulations:'
  description: Generate a warning if an object file requests an executable stack
  provenance:
    sources:
    - help-text
- spellings:
  - --warn-execstack
  group: 'ELF emulations:'
  description: Generate a warning if creating an executable stack (default)
  provenance:
    sources:
    - help-text
- spellings:
  - --no-warn-execstack
  group: 'ELF emulations:'
  description: Do not generate a warning if creating an executable stack
  provenance:
    sources:
    - help-text
- spellings:
  - --error-execstack
  group: 'ELF emulations:'
  description: Turn warnings about executable stacks into errors
  provenance:
    sources:
    - help-text
- spellings:
  - --no-error-execstack
  group: 'ELF emulations:'
  description: Do not turn warnings about executable stacks into errors
  provenance:
    sources:
    - help-text
- spellings:
  - --warn-rwx-segments
  group: 'ELF emulations:'
  description: Generate a warning if a LOAD segment has RWX permissions (default)
  provenance:
    sources:
    - help-text
- spellings:
  - --no-warn-rwx-segments
  group: 'ELF emulations:'
  description: Do not generate a warning if a LOAD segments has RWX permissions
  provenance:
    sources:
    - help-text
- spellings:
  - --error-rwx-segments
  group: 'ELF emulations:'
  description: Turn warnings about loadable RWX segments into errors
  provenance:
    sources:
    - help-text
- spellings:
  - --no-error-rwx-segments
  group: 'ELF emulations:'
  description: Do not turn warnings about loadable RWX segments into errors
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: unique-symbol
  value_kind: Required
  group: 'ELF emulations:'
  description: Avoid duplicated local symbol names
  provenance:
    sources:
    - help-text
- spellings:
  - -z
  value_name: nounique-symbol
  value_kind: Required
  group: 'ELF emulations:'
