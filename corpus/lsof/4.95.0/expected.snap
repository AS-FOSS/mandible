name: lsof
description: 'lsof: illegal option character: - lsof: -e not followed by a file system path: "lp" lsof 4.95.0 Defaults in parentheses; comma-separated set (s) items; dash-separated ranges. Anyone can list all files; /dev warnings disabled; kernel ID check disabled.'
usage:
- 'usage: [-?abhKlnNoOPRtUvVX] [+|-c c] [+|-d s] [+D D] [+|-E] [+|-e s] [+|-f[gG]] [-F [f]] [-g [s]] [-i [i]] [+|-L [l]] [+m [m]] [+|-M] [-o [o]] [-p s] [+|-r [t]] [-s [p:s]] [-S [t]] [-T [t]] [-u s] [+|-w] [-x [fl]] [--] [names]'
flags:
- short: '?'
  value_name: list
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -a AND selections (OR) -b avoid kernel blocks
  provenance:
    sources:
    - help-text
- short: 'c'
  value_name: c
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: cmd c ^c /c/[bix] +c w COMMAND width (9) +d s dir s files
  provenance:
    sources:
    - help-text
- short: 'd'
  value_name: s
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: select by FD set +D D dir D tree *SLOW?* +|-e s exempt s *RISKY*
  provenance:
    sources:
    - help-text
- short: 'i'
  value_name: select
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -K [i] list|(i)gn tasKs -l list UID numbers
  provenance:
    sources:
    - help-text
- short: 'n'
  value_name: no
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -N select NFS files -o list file offset
  provenance:
    sources:
    - help-text
- short: 'O'
  value_name: no
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -P no port names -Q allow failed search
  provenance:
    sources:
    - help-text
- short: 'R'
  value_name: list
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -s list file size -t terse listing
  provenance:
    sources:
    - help-text
- short: 'T'
  value_name: disable
  value_kind: Required
  group: Defaults in parentheses; comma-separated set (s) items; dash-separated ranges.
  description: -U select Unix socket -v list version info
  provenance:
