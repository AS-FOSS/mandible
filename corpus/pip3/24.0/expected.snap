- name: search
  summary: Search PyPI for packages.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: cache
  summary: Inspect and manage pip's wheel cache.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: index
  summary: Inspect information available from package indexes.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: wheel
  summary: Build wheels from your requirements.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: hash
  summary: Compute hashes of package archives.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: completion
  summary: A helper command used for command completion.
  group: 'Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
