name: nfsslower-bpfcc
usage:
- 'usage: nfsslower-bpfcc [-h] [-j] [-p PID] [min_ms]'
positionals:
- name: min_ms
  description: Minimum IO duration to trace in ms (default=10ms)
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -h
  - --help
  description: show this help message and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -j
  - --csv
  description: 'just print fields: comma-separated values'
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pid
  value_name: PID
  value_kind: Required
  description: 'Trace this pid only ./nfsslower # trace operations slower than 10ms ./nfsslower 1 # trace operations slower than 1ms ./nfsslower -j 1 # ... 1 ms, parsable output (csv) ./nfsslower 0 # trace all nfs operations ./nfsslower -p 121 # trace pid 121 only'
  provenance:
    sources:
    - help-text
detected_framework: argparse
provenance:
  sources:
  - help-text
  confidence: 1.0
children_filled: true
