name: du
description: Summarize device usage of the set of FILEs, recursively for directories.
usage:
- 'Usage: du [OPTION]... [FILE]...'
- '  or:  du [OPTION]... --files0-from=F'
positionals:
- name: FILE
  variadic: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - '-0'
  - --null
  description: end each output line with NUL, not newline
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --all
  description: write counts for all files, not just directories
  provenance:
    sources:
    - help-text
- spellings:
  - --apparent-size
  description: print apparent sizes rather than device usage; although the apparent size is usually smaller, it may be larger due to holes in ('sparse') files, internal fragmentation, indirect blocks, and the like
  provenance:
    sources:
    - help-text
- spellings:
  - -B
  - --block-size
  value_name: SIZE
  value_kind: Required
  description: scale sizes by SIZE before printing them; e.g., '-BM' prints sizes in units of 1,048,576 bytes; see SIZE format below
  provenance:
    sources:
    - help-text
- spellings:
  - -b
  - --bytes
  description: equivalent to '--apparent-size --block-size=1'
  provenance:
    sources:
    - help-text
- spellings:
  - -c
  - --total
  description: produce a grand total
  provenance:
    sources:
    - help-text
- spellings:
  - -D
  - --dereference-args
  description: dereference only symlinks that are listed on the command line
  provenance:
    sources:
    - help-text
- spellings:
  - -d
  - --max-depth
  value_name: N
  value_kind: Required
  description: print the total for a directory (or file, with --all) only if it is N or fewer levels below the command line argument; --max-depth=0 is the same as --summarize
  provenance:
    sources:
    - help-text
- spellings:
  - --files0-from
  value_name: F
  value_kind: Required
  description: summarize device usage of the NUL-terminated file names specified in file F; if F is -, then read names from standard input
  provenance:
    sources:
    - help-text
- spellings:
  - -H
  description: equivalent to --dereference-args (-D)
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --human-readable
  description: print sizes in human readable format (e.g., 1K 234M 2G)
  provenance:
    sources:
    - help-text
- spellings:
  - --inodes
  description: list inode usage information instead of block usage
  provenance:
    sources:
    - help-text
- spellings:
  - -k
  description: like --block-size=1K
  provenance:
    sources:
    - help-text
- spellings:
  - -L
  - --dereference
  description: dereference all symbolic links
  provenance:
    sources:
    - help-text
- spellings:
  - -l
  - --count-links
  description: count sizes many times if hard linked
  provenance:
    sources:
    - help-text
- spellings:
  - -m
  description: like --block-size=1M
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  - --no-dereference
  description: don't follow any symbolic links (this is the default)
  provenance:
    sources:
    - help-text
- spellings:
  - -S
  - --separate-dirs
  description: for directories do not include size of subdirectories
  provenance:
    sources:
    - help-text
- spellings:
  - --si
  description: like -h, but use powers of 1000 not 1024
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --summarize
  description: display only a total for each argument
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  - --threshold
  value_name: SIZE
  value_kind: Required
  description: exclude entries smaller than SIZE if positive, or entries greater than SIZE if negative
  provenance:
    sources:
    - help-text
- spellings:
  - --time
  description: show time of the last modification of any file in the directory, or any of its subdirectories
  provenance:
    sources:
    - help-text
- spellings:
  - --time
  value_name: WORD
  value_kind: Required
  description: 'show time as WORD instead of modification time: atime, access, use, ctime or status'
  provenance:
    sources:
    - help-text
- spellings:
  - --time-style
  value_name: STYLE
  value_kind: Required
  description: 'show times using STYLE, which can be: full-iso, long-iso, iso, or +FORMAT; FORMAT is interpreted like in ''date'''
  provenance:
    sources:
    - help-text
- spellings:
  - -X
  - --exclude-from
  value_name: FILE
  value_kind: Required
  description: exclude files that match any pattern in FILE
  provenance:
    sources:
    - help-text
- spellings:
  - --exclude
  value_name: PATTERN
  value_kind: Required
  description: exclude files that match PATTERN
  provenance:
    sources:
    - help-text
- spellings:
  - -x
  - --one-file-system
  description: skip directories on different file systems
  provenance:
    sources:
    - help-text
- spellings:
  - --help
  description: display this help and exit
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  description: output version information and exit
  provenance:
    sources:
    - help-text
detected_framework: GNU argp/getopt_long
provenance:
  sources:
  - help-text
  confidence: 1.0
children_filled: true
