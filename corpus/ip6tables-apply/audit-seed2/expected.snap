name: ip6tables-apply
description: ip6tables-apply 1.1 -- a safer way to update iptables remotely
usage:
- 'Usage:'
- '  ip6tables-apply [-hV] [-t timeout] [-w savefile] {[rulesfile]|-c [runcmd]}'
flags:
- short: 't'
  long: timeout
  value_name: seconds
  value_kind: Required
  description: 'Specify the timeout in seconds (default: 10).'
  provenance:
    sources:
    - help-text
- short: 'w'
  long: write
  value_name: savefile
  value_kind: Required
  description: 'Specify the savefile where successfully applied rules will be written to (default if empty string is given: /etc/network/ip6tables.up.rules).'
  provenance:
    sources:
    - help-text
- short: 'c'
  long: command
  value_name: runcmd
  value_kind: Required
  description: 'Run command runcmd to configure iptables instead of applying a rulesfile (default: /etc/network/ip6tables.up.run).'
  provenance:
    sources:
    - help-text
- short: 'h'
  long: help
  description: Display this help text.
  provenance:
    sources:
    - help-text
- short: 'V'
  long: version
  description: Display version information.
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
