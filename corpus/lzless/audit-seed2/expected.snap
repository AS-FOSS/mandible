name: lzless
description: |-
  Like 'less', but operate on the uncompressed contents of xz compressed FILEs.

  Options are the same as for 'less'.

  Report bugs to <xz@tukaani.org>.
usage:
- 'Usage: lzless [OPTION]... [FILE]...'
positionals:
- name: FILE
  variadic: true
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
