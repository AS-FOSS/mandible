name: systemctl
usage:
- systemctl [OPTIONS...] COMMAND ...
positionals:
- name: COMMAND
  required: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -h
  - --help
  description: Show this help
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  description: Show package version
  provenance:
    sources:
    - help-text
- spellings:
  - --system
  description: Connect to system manager
  provenance:
    sources:
    - help-text
- spellings:
  - --user
  description: Connect to user service manager
  provenance:
    sources:
    - help-text
- spellings:
  - -H
  - --host
  value_name: '[USER@]HOST'
  value_kind: Required
  description: Operate on remote host
  provenance:
    sources:
    - help-text
- spellings:
  - -M
  - --machine
  value_name: CONTAINER
  value_kind: Required
  description: Operate on a local container
  provenance:
    sources:
    - help-text
- spellings:
  - -t
  - --type
  value_name: TYPE
  value_kind: Required
  description: List units of a particular type
  provenance:
    sources:
    - help-text
- spellings:
  - --state
  value_name: STATE
  value_kind: Required
  description: List units with particular LOAD or SUB or ACTIVE state
  provenance:
    sources:
    - help-text
- spellings:
  - --failed
  description: Shortcut for --state=failed
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --property
  value_name: NAME
  value_kind: Required
  description: Show only properties by this name
  provenance:
    sources:
    - help-text
- spellings:
  - -P
  value_name: NAME
  value_kind: Required
  description: Equivalent to --value --property=NAME
  provenance:
    sources:
    - help-text
- spellings:
  - -a
  - --all
  description: Show all properties/all units currently in memory, including dead/empty ones. To list all units installed on the system, use 'list-unit-files' instead.
  provenance:
    sources:
    - help-text
- spellings:
  - -l
  - --full
  description: Don't ellipsize unit names on output
  provenance:
    sources:
    - help-text
- spellings:
  - -r
  - --recursive
  description: Show unit list of host and local containers
  provenance:
    sources:
    - help-text
- spellings:
  - --reverse
  description: Show reverse dependencies with 'list-dependencies'
  provenance:
    sources:
    - help-text
- spellings:
  - --with-dependencies
  description: Show unit dependencies with 'status', 'cat', 'list-units', and 'list-unit-files'.
  provenance:
    sources:
    - help-text
- spellings:
  - --job-mode
  value_name: MODE
  value_kind: Required
  description: Specify how to deal with already queued jobs, when queueing a new job
  provenance:
    sources:
    - help-text
- spellings:
  - -T
  - --show-transaction
  description: When enqueuing a unit job, show full transaction
  provenance:
    sources:
    - help-text
- spellings:
  - --show-types
  description: When showing sockets, explicitly show their type
  provenance:
    sources:
    - help-text
- spellings:
  - --value
  description: When showing properties, only print the value
  provenance:
    sources:
    - help-text
- spellings:
  - --check-inhibitors
  value_name: MODE
  value_kind: Required
  description: Whether to check inhibitors before shutting down, sleeping, or hibernating
  provenance:
    sources:
    - help-text
- spellings:
  - -i
  description: Shortcut for --check-inhibitors=no
  provenance:
    sources:
    - help-text
- spellings:
  - --kill-whom
  value_name: WHOM
  value_kind: Required
  description: Whom to send signal to
  provenance:
    sources:
    - help-text
- spellings:
  - --kill-value
  value_name: INT
  value_kind: Required
  description: Signal value to enqueue
  provenance:
    sources:
    - help-text
- spellings:
  - -s
  - --signal
  value_name: SIGNAL
  value_kind: Required
  description: Which signal to send
  provenance:
    sources:
    - help-text
- spellings:
  - --what
  value_name: RESOURCES
  value_kind: Required
  description: Which types of resources to remove
  provenance:
    sources:
    - help-text
- spellings:
  - --now
  description: Start or stop unit after enabling or disabling it
  provenance:
    sources:
    - help-text
- spellings:
  - --dry-run
  description: 'Only print what would be done Currently supported by verbs: halt, poweroff, reboot, kexec, soft-reboot, suspend, hibernate, suspend-then-hibernate, hybrid-sleep, default, rescue, emergency, and exit.'
  provenance:
    sources:
    - help-text
- spellings:
  - -q
  - --quiet
  description: Suppress output
  provenance:
    sources:
    - help-text
- spellings:
  - --no-warn
  description: Suppress several warnings shown by default
  provenance:
    sources:
    - help-text
- spellings:
  - --wait
  description: For (re)start, wait until service stopped again For is-system-running, wait until startup is completed
  provenance:
    sources:
    - help-text
- spellings:
  - --no-block
  description: Do not wait until operation finished
  provenance:
    sources:
    - help-text
- spellings:
  - --no-wall
  description: Don't send wall message before halt/power-off/reboot
  provenance:
    sources:
    - help-text
- spellings:
  - --no-reload
  description: Don't reload daemon after en-/dis-abling unit files
  provenance:
    sources:
    - help-text
- spellings:
  - --legend
  value_name: BOOL
  value_kind: Required
  description: Enable/disable the legend (column headers and hints)
  provenance:
    sources:
    - help-text
- spellings:
  - --no-pager
  description: Do not pipe output into a pager
  provenance:
    sources:
    - help-text
- spellings:
  - --no-ask-password
  description: Do not ask for system passwords
  provenance:
    sources:
    - help-text
- spellings:
  - --global
  description: Edit/enable/disable/mask default user unit files globally
  provenance:
    sources:
    - help-text
- spellings:
  - --runtime
  description: Edit/enable/disable/mask unit files temporarily until next reboot
  provenance:
    sources:
    - help-text
- spellings:
  - -f
  - --force
  description: When enabling unit files, override existing symlinks When shutting down, execute action immediately
  provenance:
    sources:
    - help-text
- spellings:
  - --preset-mode
  value_name: ''
  value_kind: Required
  description: Apply only enable, only disable, or all presets
  provenance:
    sources:
    - help-text
- spellings:
  - --root
  value_name: PATH
  value_kind: Required
  description: Edit/enable/disable/mask unit files in the specified root directory
  provenance:
    sources:
    - help-text
- spellings:
  - --image
  value_name: PATH
  value_kind: Required
  description: Edit/enable/disable/mask unit files in the specified disk image
  provenance:
    sources:
    - help-text
- spellings:
  - --image-policy
  value_name: POLICY
  value_kind: Required
  description: Specify disk image dissection policy
  provenance:
    sources:
    - help-text
- spellings:
  - -n
  - --lines
  value_name: INTEGER
  value_kind: Required
  description: Number of journal entries to show
  provenance:
    sources:
    - help-text
- spellings:
  - -o
  - --output
  value_name: STRING
  value_kind: Required
  description: Change journal output mode (short, short-precise, short-iso, short-iso-precise, short-full, short-monotonic, short-unix, short-delta, verbose, export, json, json-pretty, json-sse, cat)
  provenance:
    sources:
    - help-text
- spellings:
  - --firmware-setup
  description: Tell the firmware to show the setup menu on next boot
  provenance:
    sources:
    - help-text
- spellings:
  - --boot-loader-menu
  value_name: TIME
  value_kind: Required
  description: Boot into boot loader menu on next boot
  provenance:
    sources:
    - help-text
- spellings:
  - --boot-loader-entry
  value_name: NAME
  value_kind: Required
  description: Boot into a specific boot loader entry on next boot
  provenance:
    sources:
    - help-text
- spellings:
  - --plain
  description: Print unit dependencies as a list instead of a tree
  provenance:
    sources:
    - help-text
- spellings:
  - --timestamp
  value_name: FORMAT
  value_kind: Required
  description: Change format of printed timestamps (pretty, unix, us, utc, us+utc)
  provenance:
    sources:
    - help-text
- spellings:
  - --read-only
  description: Create read-only bind mount
  provenance:
    sources:
    - help-text
- spellings:
  - --mkdir
  description: Create directory before mounting, if missing
  provenance:
    sources:
    - help-text
- spellings:
  - --marked
  description: Restart/reload previously marked units
  provenance:
    sources:
    - help-text
- spellings:
  - --drop-in
  value_name: NAME
  value_kind: Required
  description: Edit unit files using the specified drop-in file name
  provenance:
    sources:
    - help-text
- spellings:
  - --when
  value_name: TIME
  value_kind: Required
  description: Schedule halt/power-off/reboot/kexec action after a certain timestamp
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
subcommands:
- name: list-units
  summary: List units currently in memory
  usage:
  - '[PATTERN...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: list-automounts
  summary: List automount units currently in memory, ordered by path
  usage:
  - '[PATTERN...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: list-paths
  summary: List path units currently in memory, ordered by path
  usage:
  - '[PATTERN...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: list-sockets
  summary: List socket units currently in memory, ordered by address
  usage:
  - '[PATTERN...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: list-timers
  summary: List timer units currently in memory, ordered by next elapse
  usage:
  - '[PATTERN...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: is-active
  summary: Check whether units are active
  usage:
  - PATTERN...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: is-failed
  summary: Check whether units are failed or system is in degraded state
