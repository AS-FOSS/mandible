  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: list-dependencies
  summary: Recursively show units which are required or wanted by the units or by which those units are required or wanted
  usage:
  - '[UNIT...]'
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: start
  summary: Start (activate) one or more units
  usage:
  - UNIT...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: stop
  summary: Stop (deactivate) one or more units
  usage:
  - UNIT...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: reload
  summary: Reload one or more units
  usage:
  - UNIT...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: restart
  summary: Start or restart one or more units
  usage:
  - UNIT...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: try-restart
  summary: Restart one or more units if active
  usage:
  - UNIT...
  group: 'Unit Commands:'
  provenance:
    sources:
    - help-text
  heading_attested: true
- name: reload-or-restart
  summary: Reload one or more units if possible, otherwise start or restart
