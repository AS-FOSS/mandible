name: llvm-modextract-18
description: 'OVERVIEW: Module extractor'
usage:
- 'USAGE: llvm-modextract-18 [options] <input bitcode>'
flags:
- spellings:
  - --color
  group: 'Color Options:'
  description: Use colors in output (default=autodetect)
  provenance:
    sources:
    - help-text
- spellings:
  - --help
  group: 'Generic Options:'
  description: Display available options (--help-hidden for more)
  provenance:
    sources:
    - help-text
- spellings:
  - --help-list
  group: 'Generic Options:'
  description: Display list of available options (--help-list-hidden for more)
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  group: 'Generic Options:'
  description: Display the version of this program
  provenance:
    sources:
    - help-text
- spellings:
  - -b
  group: 'Modextract Options:'
  description: Whether to perform binary extraction
  provenance:
    sources:
    - help-text
- spellings:
  - -n
  value_name: <index>
  value_kind: Required
  group: 'Modextract Options:'
  description: Index of module to extract
  provenance:
    sources:
    - help-text
- spellings:
  - -o
  value_name: <filename>
  value_kind: Required
  group: 'Modextract Options:'
  description: Output filename
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
