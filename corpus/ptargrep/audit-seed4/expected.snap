name: ptargrep
description: '#!/usr/bin/perl #!/usr/bin/perl ############################################################################## # Tool for using regular expressions against the contents of files in a tar # archive. See ''ptargrep --help'' for more documentation. #'
flags:
- long: message
  single_dash: true
  group: pod2usage(-exitval => 1,  -verbose => 0,
  description: '"No pattern specified",'
  provenance:
    sources:
    - help-text
- long: message
  single_dash: true
  group: pod2usage(-exitval => 1,  -verbose => 0,
  description: '"No tar files specified",'
  provenance:
    sources:
    - help-text
- short: 'b'
  long: basename
  description: ignore directory paths from archive
  provenance:
    sources:
    - help-text
- short: 'i'
  long: ignore-case
  description: do case-insensitive pattern matching
  provenance:
    sources:
    - help-text
- short: 'l'
  long: list-only
  description: list matching filenames rather than extracting matches
  provenance:
    sources:
    - help-text
- short: 'v'
  long: verbose
  description: write debugging message to STDERR
  provenance:
    sources:
    - help-text
- short: '?'
  long: help
  description: detailed help message
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.09
children_filled: true
