- long: verbose
  description: be verbose
  provenance:
    sources:
    - help-text
- long: sort
  description: sorts the manipulated catalog content
  provenance:
    sources:
    - help-text
- long: add
  provenance:
    sources:
    - help-text-synopsis
- long: del
  provenance:
