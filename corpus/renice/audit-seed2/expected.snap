name: renice
usage:
- 'Usage:'
- ' renice [-n|--priority|--relative] <priority> [-p|--pid] <pid>...'
- ' renice [-n|--priority|--relative] <priority>  -g|--pgrp <pgid>...'
- ' renice [-n|--priority|--relative] <priority>  -u|--user <user>...'
positionals:
- name: priority
  required: true
  provenance:
    sources:
    - help-text
- name: pid
  required: true
  variadic: true
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -n
  value_name: <num>
  value_kind: Required
  description: specify the nice value If POSIXLY_CORRECT flag is set in environment then the priority is 'relative' to current process priority. Otherwise it is 'absolute'.
  provenance:
    sources:
    - help-text
- spellings:
  - --priority
  value_name: <num>
  value_kind: Required
  description: specify the 'absolute' nice value
  provenance:
    sources:
    - help-text
- spellings:
  - --relative
  value_name: <num>
  value_kind: Required
  description: specify the 'relative' nice value
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --pid
  description: interpret arguments as process ID (default)
  provenance:
    sources:
    - help-text
- spellings:
  - -g
  - --pgrp
  description: interpret arguments as process group ID
  provenance:
    sources:
    - help-text
- spellings:
  - -u
  - --user
  description: interpret arguments as username or user ID
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  description: display this help
  provenance:
    sources:
    - help-text
- spellings:
  - -V
  - --version
  description: display version
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
