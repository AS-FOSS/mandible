name: jarsigner
usage:
- 'Usage: jarsigner [options] jar-file alias'
- '       jarsigner -verify [options] jar-file [alias...]'
positionals:
- name: jar-file
  required: true
  provenance:
    sources:
    - help-text
- name: alias
  provenance:
    sources:
    - help-text
flags:
- spellings:
  - -keystore
  value_name: <url>
  value_kind: Required
  description: keystore location
  provenance:
    sources:
    - help-text
- spellings:
  - -storepass
  value_name: <password>
  value_kind: Required
  description: password for keystore integrity
  provenance:
    sources:
    - help-text
- spellings:
  - -storetype
  value_name: <type>
  value_kind: Required
  description: keystore type
  provenance:
    sources:
    - help-text
- spellings:
  - -keypass
  value_name: <password>
  value_kind: Required
  description: password for private key (if different)
  provenance:
    sources:
    - help-text
- spellings:
  - -certchain
  value_name: <file>
  value_kind: Required
  description: name of alternative certchain file
  provenance:
    sources:
    - help-text
- spellings:
  - -sigfile
  value_name: <file>
  value_kind: Required
  description: name of .SF/.DSA file
  provenance:
    sources:
    - help-text
- spellings:
  - -signedjar
  value_name: <file>
  value_kind: Required
  description: name of signed JAR file
  provenance:
    sources:
    - help-text
- spellings:
  - -digestalg
  value_name: <algorithm>
  value_kind: Required
  description: name of digest algorithm
  provenance:
    sources:
    - help-text
- spellings:
  - -sigalg
  value_name: <algorithm>
  value_kind: Required
  description: name of signature algorithm
  provenance:
    sources:
    - help-text
- spellings:
  - -verify
  description: verify a signed JAR file
  provenance:
    sources:
    - help-text
- spellings:
  - -verbose
  value_name: :suboptions
  value_kind: Optional
  description: verbose output when signing/verifying. suboptions can be all, grouped or summary
  provenance:
    sources:
    - help-text
- spellings:
  - -certs
  description: display certificates when verbose and verifying
  provenance:
    sources:
    - help-text
- spellings:
  - -revCheck
  description: Enable certificate revocation check
  provenance:
    sources:
    - help-text
- spellings:
  - -tsa
  value_name: <url>
  value_kind: Required
  description: location of the Timestamping Authority
  provenance:
    sources:
    - help-text
- spellings:
  - -tsacert
  value_name: <alias>
  value_kind: Required
  description: public key certificate for Timestamping Authority
  provenance:
    sources:
    - help-text
- spellings:
  - -tsapolicyid
  value_name: <oid>
  value_kind: Required
  description: TSAPolicyID for Timestamping Authority
  provenance:
    sources:
    - help-text
- spellings:
  - -tsadigestalg
  value_name: <algorithm>
  value_kind: Required
  description: algorithm of digest data in timestamping request
  provenance:
    sources:
    - help-text
- spellings:
  - -altsigner
  value_name: <class>
  value_kind: Required
  description: class name of an alternative signing mechanism (This option is deprecated and will be removed in a future release.)
  provenance:
    sources:
    - help-text
- spellings:
  - -altsignerpath
  value_name: <pathlist>
  value_kind: Required
  description: location of an alternative signing mechanism (This option is deprecated and will be removed in a future release.)
  provenance:
    sources:
    - help-text
- spellings:
  - -internalsf
  description: include the .SF file inside the signature block
  provenance:
    sources:
    - help-text
- spellings:
  - -sectionsonly
  description: don't compute hash of entire manifest
  provenance:
    sources:
    - help-text
- spellings:
  - -protected
  description: keystore has protected authentication path
  provenance:
    sources:
    - help-text
- spellings:
  - -providerName
  value_name: <name>
  value_kind: Required
  description: provider name
  provenance:
    sources:
    - help-text
- spellings:
  - -addprovider
  value_name: <name>
  value_kind: Required
  description: add security provider by name (e.g. SunPKCS11) [-providerArg <arg>]] ... configure argument for -addprovider
  provenance:
    sources:
    - help-text
- spellings:
  - -providerClass
  value_name: <class>
  value_kind: Required
  description: add security provider by fully-qualified class name [-providerArg <arg>]] ... configure argument for -providerClass
  provenance:
    sources:
    - help-text
- spellings:
  - -strict
  description: treat warnings as errors
  provenance:
    sources:
    - help-text
- spellings:
  - -conf
  value_name: <url>
  value_kind: Required
  description: specify a pre-configured options file
  provenance:
    sources:
    - help-text
- spellings:
  - -?
  - -h
  - --help
  description: Print this help message
  provenance:
    sources:
    - help-text
provenance:
  sources:
  - help-text
  confidence: 0.32
children_filled: true
