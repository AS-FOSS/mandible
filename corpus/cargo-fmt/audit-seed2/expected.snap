name: cargo-fmt
description: This utility formats all bin and lib files of the current crate using rustfmt.
usage:
- 'Usage: cargo fmt [OPTIONS] [-- <rustfmt_options>...]'
flags:
- spellings:
  - -q
  - --quiet
  description: No output printed to stdout
  provenance:
    sources:
    - help-text
- spellings:
  - -v
  - --verbose
  description: Use verbose output
  provenance:
    sources:
    - help-text
- spellings:
  - --version
  description: Print rustfmt version and exit
  provenance:
    sources:
    - help-text
- spellings:
  - -p
  - --package
  value_name: <package>
  value_kind: Required
  description: Specify package to format
  provenance:
    sources:
    - help-text
- spellings:
  - --manifest-path
  value_name: <manifest-path>
  value_kind: Required
  description: Specify path to Cargo.toml
  provenance:
    sources:
    - help-text
- spellings:
  - --message-format
  value_name: <message-format>
  value_kind: Required
  description: 'Specify message-format: short|json|human'
  provenance:
    sources:
    - help-text
- spellings:
  - --all
  description: Format all packages, and also their local path-based dependencies
  provenance:
    sources:
    - help-text
- spellings:
  - --check
  description: Run rustfmt in check mode
  provenance:
    sources:
    - help-text
- spellings:
  - -h
  - --help
  description: Print help
  provenance:
    sources:
    - help-text
- spellings:
  - --
  value_name: <rustfmt_options>
  value_kind: Required
  provenance:
    sources:
    - help-text-synopsis
provenance:
  sources:
  - help-text
  confidence: 0.5
children_filled: true
